{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2021", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noImplicitOverride": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "importHelpers": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "tabby-core": ["/Applications/Tabby.app/Contents/Resources/builtin-plugins/tabby-core/typings"],
      "tabby-terminal": ["/Applications/Tabby.app/Contents/Resources/builtin-plugins/tabby-terminal/typings"]
    }
  },
  "include": ["src"]
}
