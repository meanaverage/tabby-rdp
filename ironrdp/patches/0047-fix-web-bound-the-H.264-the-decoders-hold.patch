         expect(done).toHaveBeenCalledWith(0, null, decoder.failed);
     });
 
+    it('fails when too many frames wait in one decoder', () => {
+        const failures: string[] = [];
+        decoder.close();
+        decoder = new WebCodecsH264Decoder({ onFailure: (reason) => failures.push(reason), now: () => clock });
+        decoder.decode(frame(0, true), done);
+        for (let id = 1; id < 256; id++) {
+            decoder.decode(frame(id, false), done);
+        }
+        expect(decoder.failed).toBeNull();
+        expect(decoder.stats.pending).toBe(256);
+
+        decoder.decode(frame(256, false), done);
+        expect(failures).toEqual(['more than 256 frames in a decoder']);
+        // The frames in the decoder complete with the failure, and so does the one refused.
+        expect(done).toHaveBeenCalledTimes(257);
+        expect(done).toHaveBeenLastCalledWith(256, null, 'more than 256 frames in a decoder');
+    });
+
+    it('fails when the frames in the decoders hold too much H.264', () => {
+        const big = (id: number): H264Frame => ({ ...frame(id, id === 0), data: new Uint8Array(48 * 1024 * 1024) });
+        decoder.decode(big(0), done);
+        decoder.decode({ ...big(1), surfaceId: 2, keyFrame: true }, done);
+        expect(decoder.failed).toBeNull();
+        decoder.decode(big(2), done);
+        expect(decoder.failed).toBe('more than 128 MiB of H.264 in the decoders');
+        expect(done).toHaveBeenLastCalledWith(2, null, decoder.failed);
+    });
+
+    it('counts a frame out of the decoder once its picture is out', async () => {
+        // Two of these fit in what the decoders may hold, three do not.
+        const big = (id: number): H264Frame => ({ ...frame(id, id === 0), data: new Uint8Array(60 * 1024 * 1024) });
+        decoder.decode(big(0), done);
+        FakeDecoder.instances[0].emit(0);
+        decoder.decode(big(1), done);
+        decoder.decode(big(2), done);
+        // Frame 1 never comes out: once frame 2 does, it is dropped, and no longer counted either.
+        FakeDecoder.instances[0].emit(2);
+        decoder.decode(big(3), done);
+        decoder.decode(big(4), done);
+        await flush();
+        expect(decoder.failed).toBeNull();
+        expect(done.mock.calls.map((call) => [call[0], call[1] === null])).toEqual([
+            [1, true],
+            [0, false],
+            [2, false],
+        ]);
+    });
+
