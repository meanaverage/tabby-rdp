From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: meanaverage <18336095+meanaverage@users.noreply.github.com>
Date: Sun, 4 Oct 2026 12:55:10 -0700
Subject: [PATCH] fix(graphics,egfx): cap RDP6 planar images at 8192 pixels and
 size them from the input

The RDP6 bitmap stream decoder (32 bpp fast-path bitmaps, and the EGFX
Planar codec) takes the image's width and height from its container,
16-bit values that nothing bounds. It reserved width * height * 3 bytes
for the RGB24 output before looking at the stream, and with RLE it
sized its plane buffer for the whole image before decoding a byte; the
products were unchecked. A server could send an EGFX Planar command of
three bytes with a 20000x20000 destination rectangle and make the client
allocate over 2 GB, or one of 65535x65535, whose size overflows a 32-bit
usize: in the WebAssembly build that reservation panics (a trap).

The decoder now refuses images wider or taller than 8192 pixels: the
per-axis cap of the interleaved RLE and ClearCodec decoders, MS-RDPBCGR's
maximum desktop width and height, and room for an 8K monitor
(7680x4320). Within it, every size it computes fits a 32-bit usize. It
also refuses RLE data too short for the planes before allocating them
(a plane's scanline takes at least one byte per 47 pixels, MS-RDPEGDI
3.1.9.2), and reserves the output once the planes are known to cover
the image, so a few bytes can no longer size buffers for the largest
image.

The largest image still takes 192 MiB of planes and 192 MiB of RGB24,
and the EGFX client's RGBA copy of it 256 MiB. These are now allocated
fallibly: a session that runs out of memory for them fails with
BitmapDecodeError::OutOfMemory, or a Planar decode error, rather than
aborting the instance every session shares. The plane buffer, which the
decoder reuses from image to image, grew by doubling: an 8192x8191 image
and then an 8192x8192 one left it holding 384 MiB, twice what the second
needed. A buffer too small for an image is now replaced with one of the
exact size, and a buffer over 16 MiB (the planes of a 2560x2048 image)
is released after its image. Decoding the largest image now peaks at 384
MiB, and at 448 MiB in the EGFX client while it widens the image to RGBA
(about 830 MiB before), and leaves the decoder holding nothing.
---
 crates/ironrdp-egfx/src/client.rs             |  15 +-
 .../src/rdp6/bitmap_stream/decoder.rs         | 214 +++++++++++++++++-
 2 files changed, 218 insertions(+), 11 deletions(-)

diff --git a/crates/ironrdp-egfx/src/client.rs b/crates/ironrdp-egfx/src/client.rs
index 977fdb7f..288734ea 100644
--- a/crates/ironrdp-egfx/src/client.rs
+++ b/crates/ironrdp-egfx/src/client.rs
@@ -1850,7 +1850,8 @@ impl GraphicsPipelineClient {
         // separate `RDPGFX_CODECID_ALPHA` (0x000C) command carrying an
         // `ALPHACODEC_BITMAP_STREAM` ([MS-RDPEGFX] 2.2.4.3), so a Planar command
         // contributes color only and the pixels are opaque.
-        let rgba = convert_rgb24_to_rgba(&rgb24);
+        let rgba = convert_rgb24_to_rgba(&rgb24).map_err(|e| pdu_other_err!("Planar decode", source: e))?;
+        drop(rgb24);
 
         let update = BitmapUpdate {
             surface_id,
@@ -2431,14 +2432,16 @@ fn bound_regions(
 ///
 /// The RDP 6.0 Planar decoder emits three bytes per pixel; `BitmapUpdate` carries
 /// four. See `decode_planar` for why the alpha byte is synthesized rather than
-/// taken from the stream.
-fn convert_rgb24_to_rgba(src: &[u8]) -> Vec<u8> {
+/// taken from the stream. The result takes up to 256 MiB, for an 8192x8192 image,
+/// so it is allocated fallibly.
+fn convert_rgb24_to_rgba(src: &[u8]) -> Result<Vec<u8>, std::collections::TryReserveError> {
     debug_assert!(src.len().is_multiple_of(3), "RGB24 input length not aligned to 3 bytes");
-    let mut dst = Vec::with_capacity(src.len() / 3 * 4);
+    let mut dst = Vec::new();
+    dst.try_reserve_exact(src.len() / 3 * 4)?;
     for pixel in src.chunks_exact(3) {
         dst.extend_from_slice(&[pixel[0], pixel[1], pixel[2], 0xFF]);
     }
-    dst
+    Ok(dst)
 }
 
 fn convert_bgra_to_rgba(src: &[u8]) -> Vec<u8> {
@@ -2903,7 +2906,7 @@ mod tests {
         ];
 
         assert_eq!(
-            convert_rgb24_to_rgba(&rgb),
+            convert_rgb24_to_rgba(&rgb).unwrap(),
             vec![0x10, 0x20, 0x30, 0xFF, 0x40, 0x50, 0x60, 0xFF]
         );
     }
diff --git a/crates/ironrdp-graphics/src/rdp6/bitmap_stream/decoder.rs b/crates/ironrdp-graphics/src/rdp6/bitmap_stream/decoder.rs
index 7e81fb23..7cf8bd55 100644
--- a/crates/ironrdp-graphics/src/rdp6/bitmap_stream/decoder.rs
+++ b/crates/ironrdp-graphics/src/rdp6/bitmap_stream/decoder.rs
@@ -1,14 +1,40 @@
+use std::collections::TryReserveError;
+
 use ironrdp_core::{DecodeError, decode};
 use ironrdp_pdu::bitmap::rdp6::{BitmapStream as BitmapStreamPdu, ColorPlaneDefinition};
 
 use crate::color_conversion::Rgb;
 use crate::rdp6::rle::{RleDecodeError, decompress_8bpp_plane, min_compressed_plane_size};
 
+/// Largest image width or height the decoder accepts, in pixels.
+///
+/// An `RDP6_BITMAP_STREAM` does not carry its dimensions: they come from its container
+/// (TS_BITMAP_DATA, or an EGFX destination rectangle) as 16-bit values nothing else bounds, and
+/// the planes and the RGB24 output are sized from them. 8192 is the per-axis cap of the
+/// interleaved RLE and ClearCodec decoders, MS-RDPBCGR's maximum desktop width and height, and
+/// holds an 8K monitor (7680x4320).
+const MAX_DECODE_DIM: usize = 8192;
+
+/// Largest plane buffer the decoder keeps for its next image, in bytes.
+///
+/// The decoder reuses the buffer it decompresses RLE planes into, sized for the largest image it
+/// has decoded. Images whose planes take more, up to 192 MiB for 8192x8192, get a buffer of their
+/// own that is released after them, so that one large image does not keep a session holding its
+/// size. 16 MiB holds the planes of a 2560x2048 image.
+const MAX_KEPT_PLANES_BUFFER_SIZE: usize = 16 * 1024 * 1024;
+
 #[derive(Debug)]
 pub enum BitmapDecodeError {
     Decode(DecodeError),
     Rle(RleDecodeError),
     InvalidUncompressedDataSize,
+    /// The image's width or height is above the decoder's 8192-pixel limit.
+    DimensionsTooLarge {
+        width: usize,
+        height: usize,
+    },
+    /// There is not enough memory for the image's planes or output.
+    OutOfMemory(TryReserveError),
 }
 
 impl core::fmt::Display for BitmapDecodeError {
@@ -22,6 +48,11 @@ impl core::fmt::Display for BitmapDecodeError {
                 f,
                 "color plane data size provided in PDU is not sufficient to reconstruct the bitmap"
             ),
+            BitmapDecodeError::DimensionsTooLarge { width, height } => write!(
+                f,
+                "width {width} or height {height} exceeds {MAX_DECODE_DIM}-pixel decoder limit"
+            ),
+            BitmapDecodeError::OutOfMemory(_error) => write!(f, "not enough memory to decode the bitmap"),
         }
     }
 }
@@ -31,7 +62,8 @@ impl core::error::Error for BitmapDecodeError {
         match self {
             BitmapDecodeError::Decode(err) => Some(err),
             BitmapDecodeError::Rle(err) => Some(err),
-            BitmapDecodeError::InvalidUncompressedDataSize => None,
+            BitmapDecodeError::OutOfMemory(err) => Some(err),
+            BitmapDecodeError::InvalidUncompressedDataSize | BitmapDecodeError::DimensionsTooLarge { .. } => None,
         }
     }
 }
@@ -92,6 +124,16 @@ impl<'a> BitmapStreamDecoderImpl<'a> {
             .checked_mul(image_height)
             .filter(|size| size.checked_mul(4).is_some())
             .ok_or(BitmapDecodeError::InvalidUncompressedDataSize)?;
+
+        // INVARIANT: image_width <= MAX_DECODE_DIM && image_height <= MAX_DECODE_DIM, so a plane
+        // holds at most 2^26 bytes, and every size computed from them past here (at most four planes'
+        // worth) fits a 32-bit usize.
+        if image_width > MAX_DECODE_DIM || image_height > MAX_DECODE_DIM {
+            return Err(BitmapDecodeError::DimensionsTooLarge {
+                width: image_width,
+                height: image_height,
+            });
+        }
         let chroma_plane_size = chroma_width * chroma_height;
 
         let uncompressed_planes_size = if bitmap.has_subsampled_chroma() {
@@ -130,7 +172,17 @@ impl<'a> BitmapStreamDecoderImpl<'a> {
 
     fn decompress_planes(&'a self, aux_buffer: &'a mut Vec<u8>) -> Result<&'a [u8], BitmapDecodeError> {
         let planes = if self.bitmap.header.enable_rle_compression {
-            // We don't care for the previous content, just resize it to fit the data
+            // Data too short to fill the planes was refused before this (see `new`), so a few bytes don't size a
+            // buffer for the largest image. We don't care for the previous content, just resize it to fit the data. A buffer
+            // too small is replaced with one of the exact size, allocated fallibly: growing it
+            // would double its capacity, and copy the old planes, when an 8192x8192 image's
+            // planes alone take 192 MiB.
+            if aux_buffer.capacity() < self.uncompressed_planes_size {
+                *aux_buffer = Vec::new();
+                aux_buffer
+                    .try_reserve_exact(self.uncompressed_planes_size)
+                    .map_err(BitmapDecodeError::OutOfMemory)?;
+            }
             aux_buffer.resize(self.uncompressed_planes_size, 0);
             let uncompressed_planes_buffer = &mut aux_buffer[..self.uncompressed_planes_size];
 
@@ -250,8 +302,10 @@ impl<'a> BitmapStreamDecoderImpl<'a> {
     fn decode(self, dst: &mut Vec<u8>, aux_buffer: &'a mut Vec<u8>) -> Result<(), BitmapDecodeError> {
         let color_planes = self.decompress_planes(aux_buffer)?;
 
-        // Reserve enough space for decoded RGB channels data
-        dst.reserve(self.full_plane_size * 3);
+        // Reserve enough space for decoded RGB channels data, now that the color planes are known
+        // to describe the whole image: fallibly, as it takes up to 192 MiB.
+        dst.try_reserve_exact(self.full_plane_size * 3)
+            .map_err(BitmapDecodeError::OutOfMemory)?;
 
         match self.bitmap.header.color_plane_definition {
             ColorPlaneDefinition::Argb => {
@@ -318,6 +372,156 @@ impl BitmapStreamDecoder {
 
         let decoder = BitmapStreamDecoderImpl::init(bitmap, image_width, image_height)?;
 
-        decoder.decode(dst, &mut self.planes_buffer)
+        let result = decoder.decode(dst, &mut self.planes_buffer);
+
+        if self.planes_buffer.capacity() > MAX_KEPT_PLANES_BUFFER_SIZE {
+            self.planes_buffer = Vec::new();
+        }
+
+        result
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::rdp6::{BitmapStreamEncoder, RgbChannels};
+
+    #[test]
+    fn decode_refuses_dimensions_above_the_cap_before_allocating() {
+        for (width, height) in [(8193, 8193), (8193, 1), (1, 8193)] {
+            let mut decoder = BitmapStreamDecoder::default();
+            let mut dst = Vec::new();
+
+            // RLE, ARGB with alpha, and two bytes of plane data.
+            let error = decoder
+                .decode_bitmap_stream_to_rgb24(&[0x10, 0x00, 0x00], &mut dst, width, height)
+                .unwrap_err();
+
+            assert!(
+                matches!(error, BitmapDecodeError::DimensionsTooLarge { width: w, height: h } if (w, h) == (width, height)),
+                "{error:?}"
+            );
+            assert_eq!(dst.capacity(), 0);
+            assert_eq!(decoder.planes_buffer.capacity(), 0);
+        }
+    }
+
+    #[test]
+    fn decode_refuses_rle_planes_too_short_for_the_image_before_allocating() {
+        let mut decoder = BitmapStreamDecoder::default();
+        let mut dst = Vec::new();
+
+        // RLE, ARGB with alpha: each of the four 8192-pixel-wide planes needs at least 175 bytes
+        // per scanline, and two bytes are all there is.
+        let error = decoder
+            .decode_bitmap_stream_to_rgb24(&[0x10, 0x00, 0x00], &mut dst, 8192, 8192)
+            .unwrap_err();
+
+        assert!(
+            matches!(error, BitmapDecodeError::InvalidUncompressedDataSize),
+            "{error:?}"
+        );
+        assert_eq!(dst.capacity(), 0);
+        assert_eq!(decoder.planes_buffer.capacity(), 0);
+    }
+
+    #[test]
+    fn decode_refuses_raw_planes_too_short_for_the_image_before_allocating() {
+        let mut decoder = BitmapStreamDecoder::default();
+        let mut dst = Vec::new();
+
+        // No RLE, no alpha, an empty set of planes and the padding byte.
+        let error = decoder
+            .decode_bitmap_stream_to_rgb24(&[0x20, 0x00], &mut dst, 8192, 8192)
+            .unwrap_err();
+
+        assert!(
+            matches!(error, BitmapDecodeError::InvalidUncompressedDataSize),
+            "{error:?}"
+        );
+        assert_eq!(dst.capacity(), 0);
+        assert_eq!(decoder.planes_buffer.capacity(), 0);
+    }
+
+    /// RLE-compressed planes, without alpha, of a `width` x `height` image whose bytes are all zero.
+    ///
+    /// Each scanline is runs of 47 bytes (control byte 0xF2), then a run of the `width % 47` left,
+    /// which must be 0 or from 3 to 15: about one byte per 47 pixels.
+    fn zero_rle_bitmap(width: usize, height: usize) -> Vec<u8> {
+        let mut scanline = vec![0xF2; width / 47];
+        if !width.is_multiple_of(47) {
+            scanline.push(u8::try_from(width % 47).unwrap());
+        }
+
+        // RLE, no alpha, ARGB.
+        let mut bitmap = vec![0x30];
+        for _ in 0..3 * height {
+            bitmap.extend_from_slice(&scanline);
+        }
+        bitmap
+    }
+
+    #[test]
+    fn decode_grows_the_plane_buffer_to_the_size_an_image_needs() {
+        let mut decoder = BitmapStreamDecoder::default();
+
+        for (width, height) in [(94, 93), (94, 94), (47, 47)] {
+            let mut dst = Vec::new();
+            decoder
+                .decode_bitmap_stream_to_rgb24(&zero_rle_bitmap(width, height), &mut dst, width, height)
+                .unwrap();
+            assert_eq!(dst, vec![0; width * height * 3]);
+        }
+
+        // The buffer took the size of the second image's planes, rather than twice the first's,
+        // and the third image reused it.
+        assert_eq!(decoder.planes_buffer.capacity(), 3 * 94 * 94);
+    }
+
+    #[test]
+    fn decode_does_not_keep_the_plane_buffer_of_a_large_image() {
+        let mut decoder = BitmapStreamDecoder::default();
+
+        // About 4 MiB of RLE each, for 192 MiB of planes.
+        for (width, height) in [(8192, 8191), (8192, 8192)] {
+            let mut dst = Vec::new();
+            decoder
+                .decode_bitmap_stream_to_rgb24(&zero_rle_bitmap(width, height), &mut dst, width, height)
+                .unwrap();
+            assert_eq!(dst.len(), width * height * 3);
+
+            assert!(
+                decoder.planes_buffer.capacity() <= 3 * 8192 * 8192,
+                "{width}x{height}: {} bytes of plane buffer",
+                decoder.planes_buffer.capacity()
+            );
+        }
+
+        assert_eq!(decoder.planes_buffer.capacity(), 0);
+    }
+
+    #[test]
+    fn decode_accepts_images_as_wide_or_tall_as_the_cap() {
+        for (width, height) in [(8192, 2), (2, 8192)] {
+            let image: Vec<u8> = (0..width * height * 3)
+                .map(|i| u8::try_from(i % 251).expect("< 251"))
+                .collect();
+
+            for rle in [true, false] {
+                // RLE takes a control byte for every scanline: a two-pixel-wide plane grows by half.
+                let mut pdu = vec![0; width * height * 8 + 2];
+                let written = BitmapStreamEncoder::new(width, height)
+                    .encode_bitmap::<RgbChannels>(&image, &mut pdu, rle)
+                    .unwrap();
+
+                let mut decoded = Vec::new();
+                BitmapStreamDecoder::default()
+                    .decode_bitmap_stream_to_rgb24(&pdu[..written], &mut decoded, width, height)
+                    .unwrap();
+
+                assert_eq!(decoded, image, "{width}x{height}, rle: {rle}");
+            }
+        }
     }
 }
