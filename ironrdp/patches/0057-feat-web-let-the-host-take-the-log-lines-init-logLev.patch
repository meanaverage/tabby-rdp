From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: meanaverage <aaronhritz@gmail.com>
Date: Wed, 14 Oct 2026 10:08:14 -0700
Subject: [PATCH] feat(web): let the host take the log lines (`init(logLevel,
 wasm, logSink)`)

The web client's log went to the browser console only. A host that keeps
a log file of its own (tabby-rdp's diagnostic log) passes `init` a
function, and `setup` hands it each formatted line (level, target and
message, no time stamp: the host stamps its own) in place of the console
writer. Without one, nothing changes.
---
 crates/iron-remote-desktop/src/lib.rs         | 82 ++++++++++++++++---
 .../iron-remote-desktop-rdp/src/main.ts       |  7 +-
 2 files changed, 75 insertions(+), 14 deletions(-)

diff --git a/crates/iron-remote-desktop/src/lib.rs b/crates/iron-remote-desktop/src/lib.rs
index 7fe20e29..7c6f3b30 100644
--- a/crates/iron-remote-desktop/src/lib.rs
+++ b/crates/iron-remote-desktop/src/lib.rs
@@ -111,9 +111,9 @@ macro_rules! make_bridge {
 
         #[$crate::internal::wasm_bindgen::prelude::wasm_bindgen]
         #[doc(hidden)]
-        pub fn setup(log_level: &str) {
+        pub fn setup(log_level: &str, log_sink: $crate::internal::wasm_bindgen::JsValue) {
             <$api as $crate::RemoteDesktopApi>::pre_setup();
-            $crate::internal::setup(log_level);
+            $crate::internal::setup(log_level, log_sink);
             <$api as $crate::RemoteDesktopApi>::post_setup();
         }
 
@@ -456,7 +456,9 @@ pub mod internal {
     pub use web_sys;
 
     #[doc(hidden)]
-    pub fn setup(log_level: &str) {
+    /// `log_sink`: a JavaScript function given each log line (level, target and message, without a time stamp), in
+    /// place of the browser's console; anything else, and the lines go to the console as before.
+    pub fn setup(log_level: &str, log_sink: wasm_bindgen::JsValue) {
         // When the `console_error_panic_hook` feature is enabled, we can call the
         // `set_panic_hook` function at least once during initialization, and then
         // we will get better error messages if our code ever panics.
@@ -467,11 +469,55 @@ pub mod internal {
         console_error_panic_hook::set_once();
 
         if let Ok(level) = log_level.parse::<tracing::Level>() {
-            set_logger_once(level);
+            use wasm_bindgen::JsCast as _;
+            set_logger_once(level, log_sink.dyn_into::<web_sys::js_sys::Function>().ok());
         }
     }
 
-    fn set_logger_once(level: tracing::Level) {
+    /// Hands each formatted log line to the JavaScript function, once the line is complete.
+    struct SinkWriter {
+        sink: web_sys::js_sys::Function,
+        line: Vec<u8>,
+    }
+
+    impl std::io::Write for SinkWriter {
+        fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+            self.line.extend_from_slice(buf);
+            Ok(buf.len())
+        }
+
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+
+    impl Drop for SinkWriter {
+        fn drop(&mut self) {
+            let line = String::from_utf8_lossy(&self.line);
+            let line = line.trim_end();
+            if !line.is_empty() {
+                // A sink that throws can't be reported anywhere better than where it threw.
+                let _ = self
+                    .sink
+                    .call1(&wasm_bindgen::JsValue::NULL, &wasm_bindgen::JsValue::from_str(line));
+            }
+        }
+    }
+
+    struct MakeSinkWriter(web_sys::js_sys::Function);
+
+    impl<'a> tracing_subscriber::fmt::MakeWriter<'a> for MakeSinkWriter {
+        type Writer = SinkWriter;
+
+        fn make_writer(&'a self) -> Self::Writer {
+            SinkWriter {
+                sink: self.0.clone(),
+                line: Vec::new(),
+            }
+        }
+    }
+
+    fn set_logger_once(level: tracing::Level, sink: Option<web_sys::js_sys::Function>) {
         use tracing_subscriber::filter::LevelFilter;
         use tracing_subscriber::fmt::time::UtcTime;
         use tracing_subscriber::prelude::*;
@@ -480,14 +526,26 @@ pub mod internal {
         static INIT: std::sync::Once = std::sync::Once::new();
 
         INIT.call_once(|| {
-            let fmt_layer = tracing_subscriber::fmt::layer()
-                .with_ansi(false)
-                .with_timer(UtcTime::rfc_3339()) // std::time is not available in browsers
-                .with_writer(MakeConsoleWriter);
-
             let level_filter = LevelFilter::from_level(level);
-
-            tracing_subscriber::registry().with(fmt_layer).with(level_filter).init();
+            let registry = tracing_subscriber::registry().with(level_filter);
+
+            match sink {
+                // The host stamps the time on each line it is given.
+                Some(sink) => {
+                    let fmt_layer = tracing_subscriber::fmt::layer()
+                        .with_ansi(false)
+                        .without_time()
+                        .with_writer(MakeSinkWriter(sink));
+                    registry.with(fmt_layer).init();
+                }
+                None => {
+                    let fmt_layer = tracing_subscriber::fmt::layer()
+                        .with_ansi(false)
+                        .with_timer(UtcTime::rfc_3339()) // std::time is not available in browsers
+                        .with_writer(MakeConsoleWriter);
+                    registry.with(fmt_layer).init();
+                }
+            }
         })
     }
 }
diff --git a/web-client/iron-remote-desktop-rdp/src/main.ts b/web-client/iron-remote-desktop-rdp/src/main.ts
index c664f886..1c8e95ca 100644
--- a/web-client/iron-remote-desktop-rdp/src/main.ts
+++ b/web-client/iron-remote-desktop-rdp/src/main.ts
@@ -17,10 +17,13 @@ import type { H264Done, H264Frame } from './H264Decoder';
  * `wasm` is where the module comes from: a URL, a `Response`, the bytes or a compiled `WebAssembly.Module`. By
  * default, `ironrdp_web_bg.wasm` next to this script (or the copy the bundler inlined). Hosts that can't fetch
  * that URL, such as pages loaded from `file://`, read the file themselves and pass the bytes.
+ *
+ * `logSink` is given each log line (level, target and message; no time stamp) in place of the browser's console,
+ * for a host that keeps a log file of its own.
  */
-export async function init(log_level: string, wasm?: InitInput): Promise<void> {
+export async function init(log_level: string, wasm?: InitInput, logSink?: (line: string) => void): Promise<void> {
     await wasm_init(wasm === undefined ? undefined : { module_or_path: wasm });
-    setup(log_level);
+    setup(log_level, logSink);
 }
 
 export { RdpFile };
