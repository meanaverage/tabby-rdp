From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: meanaverage <18336095+meanaverage@users.noreply.github.com>
Date: Fri, 25 Sep 2026 18:41:52 -0700
Subject: [PATCH] fix(dvc): drop data for a channel the client declined instead
 of failing

A server can send data on a dynamic channel before it sees the client
decline that channel in its Create Response. GNOME Remote Desktop does this
for AUDIO_PLAYBACK_DVC right after the Create Request, so a client without
an audio channel failed `process` with "access to non existing DVC channel"
and the session ended about a second after connecting.

Declining a channel now closes it from the client's side, as closing it
does: its ID joins the recent client-closed channels, whose data is
dropped, and a server Close or a new Create for the ID settles it as
before. Data for a channel the server never created is still an error, and
a channel already attached under the ID keeps its data.
---
 crates/ironrdp-dvc/src/client.rs              |  7 +++
 .../tests/dvc/client.rs                       | 47 +++++++++++++++++++
 2 files changed, 54 insertions(+)

diff --git a/crates/ironrdp-dvc/src/client.rs b/crates/ironrdp-dvc/src/client.rs
index 526b620c..7b286355 100644
--- a/crates/ironrdp-dvc/src/client.rs
+++ b/crates/ironrdp-dvc/src/client.rs
@@ -563,6 +563,13 @@ impl DrdynvcClient {
         if creation_status == CreationStatus::OK {
             // The server reused the ID of a channel the client closed, so its close is settled.
             self.client_closed.retain(|(closed_id, _)| *closed_id != channel_id);
+        } else if self.dynamic_channels.get_by_channel_id(channel_id).is_none() {
+            // A server can send data on a channel before it sees the client decline it in the Create
+            // Response: GNOME Remote Desktop does this for AUDIO_PLAYBACK_DVC right after its Create
+            // Request. Declining closes the channel from this side, so that data is dropped as for a
+            // channel the client closed, rather than ending the session. (A channel already attached
+            // under the ID, as a recorded session's is, stays open and keeps its data.)
+            self.remember_client_close(channel_id, None);
         }
 
         let create_response = DrdynvcClientPdu::Create(CreateResponsePdu::new(channel_id, creation_status));
diff --git a/crates/ironrdp-testsuite-core/tests/dvc/client.rs b/crates/ironrdp-testsuite-core/tests/dvc/client.rs
index 972e9e61..03b2ff5f 100644
--- a/crates/ironrdp-testsuite-core/tests/dvc/client.rs
+++ b/crates/ironrdp-testsuite-core/tests/dvc/client.rs
@@ -89,6 +89,53 @@ fn exchange_capabilities(client: &mut DrdynvcClient) {
     client.process(&caps).expect("Capabilities Request should be processed");
 }
 
+#[test]
+fn data_for_a_channel_the_client_declined_is_dropped() {
+    // A server can send data on a channel before it sees the client decline it in the Create
+    // Response (GNOME Remote Desktop does this for AUDIO_PLAYBACK_DVC). The session must survive it.
+    let mut client = DrdynvcClient::new();
+    client
+        .attach_established_dynamic_channel(7, RecordedDvc::default())
+        .expect("recorded channel should attach");
+    let data = |channel_id: u32, payload: &[u8]| {
+        encode_vec(&DrdynvcServerPdu::Data(DrdynvcDataPdu::Data(DataPdu::new(
+            channel_id,
+            payload.to_vec(),
+        ))))
+        .expect("DVC data should encode")
+    };
+
+    let create = encode_vec(&DrdynvcServerPdu::Create(CreateRequestPdu::new(
+        4,
+        "AUDIO_PLAYBACK_DVC".to_owned(),
+    )))
+    .expect("DVC create request should encode");
+    client
+        .process(&create)
+        .expect("a channel without a listener is declined");
+
+    assert!(
+        client
+            .process(&data(4, b"declined"))
+            .expect("data for a declined channel should be dropped, not fail")
+            .is_empty()
+    );
+    client
+        .process(&data(5, b"never created"))
+        .expect_err("data for a channel the server never created is still an error");
+    assert!(
+        client
+            .process(&data(7, b"open"))
+            .expect("open channels are unaffected")
+            .is_empty()
+    );
+
+    let channel = client
+        .get_dvc_by_channel_id::<RecordedDvc>(7)
+        .expect("recorded channel should remain attached");
+    assert_eq!(channel.processor().received, vec![b"open".to_vec()]);
+}
+
 #[test]
 fn established_dynamic_channel_routes_recorded_data_without_negotiation() {
     let mut client = DrdynvcClient::new();
