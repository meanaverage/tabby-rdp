             for _ in 0..items_count {
@@ -375,6 +401,44 @@ impl FormatList<'_> {
     }
 }
 
+fn too_many_formats(src: &ReadCursor<'_>) -> DecodeError {
+    invalid_field_err!(FormatList::NAME, "formatListData", "format count exceeds MAX_FORMAT_COUNT", in: src)
+}
+
+/// Reads a null-terminated format name of at most [`MAX_FORMAT_NAME_LENGTH`] characters. A name that
+/// runs to the end of the list without a terminator is read to its end.
+fn read_format_name(src: &mut ReadCursor<'_>, charset: CharacterSet) -> DecodeResult<String> {
+    // The terminator is looked for among the first MAX_FORMAT_NAME_LENGTH + 1 characters only: a longer
+    // name is refused without going through it.
+    let (terminated, characters_left) = match charset {
+        CharacterSet::Unicode => (
+            src.remaining()
+                .chunks_exact(2)
+                .take(MAX_FORMAT_NAME_LENGTH + 1)
+                .any(|character| character == [0, 0]),
+            src.len() / 2,
+        ),
+        CharacterSet::Ansi => (
+            src.remaining()
+                .iter()
+                .take(MAX_FORMAT_NAME_LENGTH + 1)
+                .any(|&character| character == 0),
+            src.len(),
+        ),
+    };
+
+    if !terminated && characters_left > MAX_FORMAT_NAME_LENGTH {
+        return Err(invalid_field_err!(
+            FormatList::NAME,
+            "wszFormatName",
+            "format name exceeds MAX_FORMAT_NAME_LENGTH",
+            in: src
+        ));
+    }
+
+    read_string_from_cursor(src, charset, true)
+}
