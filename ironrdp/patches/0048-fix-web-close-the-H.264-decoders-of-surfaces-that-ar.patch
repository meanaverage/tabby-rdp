+        expect(FakeDecoder.instances[0].state).toBe('closed');
+        expect(FakeDecoder.instances[0].flushes).toBe(0);
+    });
+
+    it('completes the frames a closing decoder never puts out without pixels', async () => {
+        decoder.decode(frame(0, true), done);
+        decoder.decode({ ...frame(1, true), surfaceId: 2, endedSurfaces: [1] }, done);
+        FakeDecoder.instances[0].finishFlush();
+        await flush();
+        expect(done).toHaveBeenCalledWith(0, null);
+        expect(decoder.stats.dropped).toBe(1);
+        expect(decoder.stats.pending).toBe(1);
+        expect(FakeDecoder.instances[0].state).toBe('closed');
+    });
+
+    it('fails when a closing decoder does not bring its frames out in time', () => {
+        vi.useFakeTimers();
