+
+#[test]
+fn a_frame_names_the_surfaces_whose_streams_ended_before_it() {
+    let mut client = client();
+    let create = |surface_id| {
+        GfxPdu::CreateSurface(CreateSurfacePdu {
+            surface_id,
+            width: 16,
+            height: 8,
+            pixel_format: PixelFormat::XRgb,
+        })
+    };
+    let delete = |surface_id| GfxPdu::DeleteSurface(DeleteSurfacePdu { surface_id });
+    let frame = |surface_id| avc420_to(surface_id, rect(0, 0, 16, 8), &[Avc420Region::full_frame(16, 8, 22)]);
+    let reset = GfxPdu::ResetGraphics(ResetGraphicsPdu {
+        width: 16,
+        height: 8,
+        monitors: vec![],
+    });
+    process_all(
+        &mut client,
+        &[
+            create(2),
+            create(3),
+            frame(1),
+            frame(2),
+            // Surface 1 deleted and surface 2 created again end their streams; surface 3 had none.
+            delete(1),
+            create(2),
+            delete(3),
+            frame(2),
+            // A reset destroys every surface: surface 2's new stream ends too.
+            reset,
+            create(4),
+            frame(4),
+        ],
+    );
+    let ended: Vec<(u16, Vec<u16>)> = client
+        .take_h264_frames()
+        .into_iter()
+        .map(|frame| (frame.surface_id, frame.ended_surfaces))
+        .collect();
+    assert_eq!(ended, [(1, vec![]), (2, vec![]), (2, vec![1, 2]), (4, vec![2])]);
+}
