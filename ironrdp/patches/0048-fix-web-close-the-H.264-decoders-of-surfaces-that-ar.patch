+
+    it('closes the decoder of a surface whose stream ended once its frames are out', async () => {
+        decoder.decode(frame(0, true), done);
+        const ended = FakeDecoder.instances[0];
+        // Surface 1 deleted and created again: a new stream, in a new decoder.
