+/** What a shared drive's file operations see and return (see `driveRedirection`). */
+export interface DriveStat {
+    dir: boolean;
+    size: number;
+    /** Milliseconds since the Unix epoch. */
+    created: number;
+    accessed: number;
+    modified: number;
+    readonly: boolean;
+}
+
+export interface DriveOpenMode {
+    write: boolean;
+    create: boolean;
+    exclusive: boolean;
+    truncate: boolean;
+}
+
+/**
+ * A file system for shared drives (MS-RDPEFS). All methods are synchronous. Paths are the server's: relative to the
+ * drive, with backslashes, `\` being the drive's root; the implementation resolves them inside the folder it shares
+ * and must refuse paths that leave it. Errors thrown with a Node-style `code` (`ENOENT`, `EEXIST`, `EACCES`,
+ * `ENOTEMPTY`, `EISDIR`, `ENOTDIR`, `ENOSPC`, `EBUSY`) are reported to the server as the matching NT status.
+ */
+export interface DriveFs {
+    /** The drives to share: RDPDR device ids (1 or more, unique in the session) and the names the remote shows. */
+    drives: { id: number; name: string }[];
+    stat(deviceId: number, path: string): DriveStat | null;
+    list(deviceId: number, path: string): string[];
+    open(deviceId: number, path: string, mode: DriveOpenMode): number;
+    read(handle: number, offset: number, length: number): Uint8Array;
+    write(handle: number, offset: number, data: Uint8Array): number;
+    truncate(handle: number, size: number): void;
+    close(handle: number): void;
+    mkdir(deviceId: number, path: string): void;
+    remove(deviceId: number, path: string): void;
+    rename(deviceId: number, from: string, to: string, replace: boolean): void;
+    volume(deviceId: number): { total: number; free: number; label: string };
+}
+
+/**
+ * Shares drives with the remote desktop (MS-RDPEFS drive redirection): `fs` serves the server's file operations
+ * for the folders it names in `drives`. The virtual printer can't be combined with it in the same session.
+ */
+export function driveRedirection(fs: DriveFs): Extension {
+    return new Extension('drive_redirection', fs);
+}
