@@ -0,0 +1,1042 @@
+//! Browser-side drive redirection backend for RDPDR.
+//!
+//! The web client can't reach a file system itself; the host application (an Electron app, say) can. The
+//! `drive_redirection` extension hands in a JavaScript object with synchronous file operations, and
+//! [`WasmDriveBackend`] serves the server's drive I/O requests ([MS-RDPEFS] 2.2.3.3) with them: each request is
+//! answered in place, as the Unix backend in `ironrdp-rdpdr-native` does, so no round trip through the event loop is
+//! needed.
+//!
+//! The JavaScript object (`DriveFs` below) sees the server's paths as the server sends them, relative to the drive,
+//! with backslashes, and is responsible for resolving them inside the folder it shares (and refusing paths that
+//! leave it). Errors it throws are mapped to NT statuses by their `code` (Node's `ENOENT`, `EEXIST`, …).
+//!
+//! The backend lives on the SVC processor side and must be `Send`; the JavaScript object is reached through
+//! [`JsDriveFs`], which is only ever used on the single WebAssembly thread.
+//!
+//! [MS-RDPEFS]: https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-rdpefs/34d9de58-b2b5-40b6-b970-f82d4a0ab25e
+
+use std::collections::HashMap;
+use std::fmt;
+
+use ironrdp::rdpdr::backend::RdpdrBackend;
+use ironrdp::rdpdr::pdu::RdpdrPdu;
+use ironrdp::rdpdr::pdu::efs::{
+    Boolean, ClientDriveLockControlResponse, ClientDriveQueryDirectoryResponse, ClientDriveQueryInformationResponse,
+    ClientDriveQuerySecurityResponse, ClientDriveQueryVolumeInformationResponse, ClientDriveSetInformationResponse,
+    ClientDriveSetSecurityResponse, CreateDisposition, CreateOptions, DesiredAccess, DeviceCloseRequest,
+    DeviceCloseResponse, DeviceControlRequest, DeviceControlResponse, DeviceCreateRequest, DeviceCreateResponse,
+    DeviceFlushBuffersResponse, DeviceIoRequest, DeviceIoResponse, DeviceReadRequest, DeviceReadResponse,
+    DeviceWriteRequest, DeviceWriteResponse, FileAttributeTagInformation, FileAttributes, FileBasicInformation,
+    FileBothDirectoryInformation, FileDirectoryInformation, FileFsAttributeInformation, FileFsFullSizeInformation,
+    FileFsSizeInformation, FileFsVolumeInformation, FileFullDirectoryInformation, FileInformationClass,
+    FileInformationClassLevel, FileNamesInformation, FileStandardInformation, FileSystemAttributes,
+    FileSystemInformationClass, FileSystemInformationClassLevel, Information, NtStatus, ServerDeviceAnnounceResponse,
+    ServerDriveIoRequest, ServerDriveQueryDirectoryRequest, ServerDriveQueryInformationRequest,
+    ServerDriveQueryVolumeInformationRequest, ServerDriveSetInformationRequest,
+};
+use ironrdp::rdpdr::pdu::esc::{ScardCall, ScardIoCtlCode};
+use ironrdp_core::impl_as_any;
+use ironrdp_pdu::{PduResult, encode_err};
+use ironrdp_svc::SvcMessage;
+use tracing::{debug, warn};
+use wasm_bindgen::{JsCast as _, JsValue};
+
+/// A drive the host shares: its RDPDR device id and the name the remote shows for it.
+#[derive(Debug, Clone)]
+pub(crate) struct SharedDrive {
+    pub(crate) device_id: u32,
+    pub(crate) name: String,
+}
+
+/// The JavaScript object implementing the file operations (see the module documentation).
+///
+/// Expected methods, all synchronous; paths are the server's (relative to the drive, backslashes):
+/// - `stat(deviceId, path)` → `{ dir, size, created, accessed, modified, readonly }` (times in ms since the epoch) or `null`
+/// - `list(deviceId, path)` → `string[]` of the entries' names
+/// - `open(deviceId, path, { write, create, exclusive, truncate })` → a handle (number)
+/// - `read(handle, offset, length)` → `Uint8Array`
+/// - `write(handle, offset, data: Uint8Array)` → number of bytes written
+/// - `truncate(handle, size)`, `close(handle)`
+/// - `mkdir(deviceId, path)`, `remove(deviceId, path)`, `rename(deviceId, from, to, replace)`
+/// - `volume(deviceId)` → `{ total, free, label }` (bytes)
+pub(crate) struct JsDriveFs(js_sys::Object);
+
+// SAFETY: WebAssembly in the browser runs on one thread; the SVC processor holding this is driven from that same
+// thread, so the JavaScript object is never touched from another one. `Send` is required by `RdpdrBackend`.
+unsafe impl Send for JsDriveFs {}
+
+impl fmt::Debug for JsDriveFs {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("JsDriveFs").finish_non_exhaustive()
+    }
+}
+
+/// What a JavaScript call came back with: a value, or the error it threw (an NT status, from its `code`).
+type JsResult<T> = Result<T, NtStatus>;
+
+impl JsDriveFs {
+    pub(crate) fn new(object: js_sys::Object) -> Self {
+        Self(object)
+    }
+
+    fn call(&self, method: &str, args: &[JsValue]) -> JsResult<JsValue> {
+        let function = js_sys::Reflect::get(&self.0, &JsValue::from_str(method))
+            .ok()
+            .and_then(|f| f.dyn_into::<js_sys::Function>().ok())
+            .ok_or_else(|| {
+                warn!(method, "Drive file system has no such method");
+                NtStatus::NOT_SUPPORTED
+            })?;
+        let array = js_sys::Array::new();
+        for arg in args {
+            array.push(arg);
+        }
+        js_sys::Reflect::apply(&function, &self.0, &array).map_err(|error| status_of(method, &error))
+    }
+
+    fn stat(&self, device_id: u32, path: &str) -> JsResult<Option<Stat>> {
+        let value = self.call("stat", &[JsValue::from(device_id), JsValue::from_str(path)])?;
+        if value.is_null() || value.is_undefined() {
+            return Ok(None);
+        }
+        Ok(Some(Stat {
+            dir: get_bool(&value, "dir"),
+            size: to_u64(get_f64(&value, "size")),
+            created: get_f64(&value, "created"),
+            accessed: get_f64(&value, "accessed"),
+            modified: get_f64(&value, "modified"),
+            readonly: get_bool(&value, "readonly"),
+        }))
+    }
+
+    fn list(&self, device_id: u32, path: &str) -> JsResult<Vec<String>> {
+        let value = self.call("list", &[JsValue::from(device_id), JsValue::from_str(path)])?;
+        let array = value.dyn_into::<js_sys::Array>().map_err(|_| NtStatus::UNSUCCESSFUL)?;
+        Ok(array.iter().filter_map(|v| v.as_string()).collect())
+    }
+
+    fn open(&self, device_id: u32, path: &str, mode: OpenMode) -> JsResult<u32> {
+        let options = js_sys::Object::new();
+        for (key, on) in [
+            ("write", mode.write),
+            ("create", mode.create),
+            ("exclusive", mode.exclusive),
+            ("truncate", mode.truncate),
+        ] {
+            let _ = js_sys::Reflect::set(&options, &JsValue::from_str(key), &JsValue::from_bool(on));
+        }
+        let value = self.call(
+            "open",
+            &[JsValue::from(device_id), JsValue::from_str(path), options.into()],
+        )?;
+        value.as_f64().and_then(to_u32).ok_or(NtStatus::UNSUCCESSFUL)
+    }
+
+    fn read(&self, handle: u32, offset: u64, length: u32) -> JsResult<Vec<u8>> {
+        let value = self.call(
+            "read",
+            &[JsValue::from(handle), from_u64(offset), JsValue::from(length)],
+        )?;
+        let bytes = value
+            .dyn_into::<js_sys::Uint8Array>()
+            .map_err(|_| NtStatus::UNSUCCESSFUL)?;
+        Ok(bytes.to_vec())
+    }
+
+    fn write(&self, handle: u32, offset: u64, data: &[u8]) -> JsResult<u32> {
+        let bytes = js_sys::Uint8Array::from(data);
+        let value = self.call("write", &[JsValue::from(handle), from_u64(offset), bytes.into()])?;
+        value.as_f64().and_then(to_u32).ok_or(NtStatus::UNSUCCESSFUL)
+    }
+
+    fn truncate(&self, handle: u32, size: u64) -> JsResult<()> {
+        self.call("truncate", &[JsValue::from(handle), from_u64(size)])
+            .map(|_| ())
+    }
+
+    fn close(&self, handle: u32) -> JsResult<()> {
+        self.call("close", &[JsValue::from(handle)]).map(|_| ())
+    }
+
+    fn mkdir(&self, device_id: u32, path: &str) -> JsResult<()> {
+        self.call("mkdir", &[JsValue::from(device_id), JsValue::from_str(path)])
+            .map(|_| ())
+    }
+
+    fn remove(&self, device_id: u32, path: &str) -> JsResult<()> {
+        self.call("remove", &[JsValue::from(device_id), JsValue::from_str(path)])
+            .map(|_| ())
+    }
+
+    fn rename(&self, device_id: u32, from: &str, to: &str, replace: bool) -> JsResult<()> {
+        self.call(
+            "rename",
+            &[
+                JsValue::from(device_id),
+                JsValue::from_str(from),
+                JsValue::from_str(to),
+                JsValue::from_bool(replace),
+            ],
+        )
+        .map(|_| ())
+    }
+
+    fn volume(&self, device_id: u32) -> JsResult<Volume> {
+        let value = self.call("volume", &[JsValue::from(device_id)])?;
+        Ok(Volume {
+            total: to_u64(get_f64(&value, "total")),
+            free: to_u64(get_f64(&value, "free")),
+            label: js_sys::Reflect::get(&value, &JsValue::from_str("label"))
+                .ok()
+                .and_then(|v| v.as_string())
+                .unwrap_or_default(),
+        })
+    }
+}
+
+/// A JavaScript number as a `u64`: non-negative and finite (JavaScript numbers are exact to 2^53, as file sizes
+/// are); anything else is 0.
+fn to_u64(value: f64) -> u64 {
+    // `as` saturates: a value past u64::MAX becomes u64::MAX, which is as good an answer as any.
+    if value.is_finite() && value >= 0.0 {
+        #[expect(clippy::as_conversions, clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+        {
+            value as u64
+        }
+    } else {
+        0
+    }
+}
+
+/// A JavaScript number as a `u32`, when it is one.
+fn to_u32(value: f64) -> Option<u32> {
+    if value.is_finite() && value >= 0.0 && value <= f64::from(u32::MAX) {
+        #[expect(clippy::as_conversions, clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+        {
+            Some(value as u32)
+        }
+    } else {
+        None
+    }
+}
+
+/// A `u64` for JavaScript: exact up to 2^53, as file offsets and sizes are.
+fn from_u64(value: u64) -> JsValue {
+    #[expect(clippy::as_conversions, clippy::cast_precision_loss)]
+    JsValue::from(value as f64)
+}
+
+fn get_f64(value: &JsValue, key: &str) -> f64 {
+    js_sys::Reflect::get(value, &JsValue::from_str(key))
+        .ok()
+        .and_then(|v| v.as_f64())
+        .unwrap_or(0.0)
+}
+
+fn get_bool(value: &JsValue, key: &str) -> bool {
+    js_sys::Reflect::get(value, &JsValue::from_str(key))
+        .ok()
+        .and_then(|v| v.as_bool())
+        .unwrap_or(false)
+}
+
+/// The NT status for an error JavaScript threw: by its `code` (Node's errno names), else a general failure.
+fn status_of(method: &str, error: &JsValue) -> NtStatus {
+    let code = js_sys::Reflect::get(error, &JsValue::from_str("code"))
+        .ok()
+        .and_then(|v| v.as_string())
+        .unwrap_or_default();
+    let status = match code.as_str() {
+        "ENOENT" => NtStatus::NO_SUCH_FILE,
+        "EEXIST" => NtStatus::OBJECT_NAME_COLLISION,
+        "EACCES" | "EPERM" | "EROFS" => NtStatus::ACCESS_DENIED,
+        "ENOTEMPTY" => NtStatus::DIRECTORY_NOT_EMPTY,
+        "EISDIR" => NtStatus::FILE_IS_A_DIRECTORY,
+        "ENOTDIR" => NtStatus::NOT_A_DIRECTORY,
+        "ENOSPC" => NtStatus::DISK_FULL,
+        "EBUSY" => NtStatus::SHARING_VIOLATION,
+        "EINVAL" | "ENAMETOOLONG" => NtStatus::OBJECT_NAME_INVALID,
+        _ => NtStatus::UNSUCCESSFUL,
+    };
+    debug!(method, code, ?status, "Drive operation failed");
+    status
+}
+
+struct Stat {
+    dir: bool,
+    size: u64,
+    created: f64,
+    accessed: f64,
+    modified: f64,
+    readonly: bool,
+}
+
+struct Volume {
+    total: u64,
+    free: u64,
+    label: String,
+}
+
+#[derive(Clone, Copy, Default)]
+struct OpenMode {
+    write: bool,
+    create: bool,
+    exclusive: bool,
+    truncate: bool,
+}
+
+/// An open file or directory on a shared drive, by the file id handed to the server.
+#[derive(Debug)]
+struct OpenEntry {
+    device_id: u32,
+    /// The server's path, relative to the drive, with backslashes; the drive's root is `\`.
+    path: String,
+    /// The JavaScript handle of an open file; directories have none.
+    handle: Option<u32>,
+    dir: bool,
+    /// A directory enumeration in progress: the matching names, and the next to report.
+    listing: Option<Vec<String>>,
+    listing_next: usize,
+    /// FILE_DELETE_ON_CLOSE, or a disposition set later: removed when closed.
+    delete_on_close: bool,
+}
+
+/// Drive redirection served by a JavaScript file system (see the module documentation).
+#[derive(Debug)]
+pub(crate) struct WasmDriveBackend {
+    fs: JsDriveFs,
+    drives: Vec<SharedDrive>,
+    next_file_id: u32,
+    open: HashMap<u32, OpenEntry>,
+}
+
+impl_as_any!(WasmDriveBackend);
+
+impl WasmDriveBackend {
+    pub(crate) fn new(fs: JsDriveFs, drives: Vec<SharedDrive>) -> Self {
+        Self {
+            fs,
+            drives,
+            next_file_id: 1,
+            open: HashMap::new(),
+        }
+    }
+
+    /// The drives to announce, as `Rdpdr::with_drives` takes them.
+    pub(crate) fn drive_list(&self) -> Vec<(u32, String)> {
+        self.drives.iter().map(|d| (d.device_id, d.name.clone())).collect()
+    }
+
+    fn create(&mut self, req: DeviceCreateRequest) -> PduResult<Vec<SvcMessage>> {
+        let device_id = req.device_io_request.device_id;
+        let path = normalize(&req.path);
+        let respond = |request: DeviceIoRequest, status: NtStatus, file_id: u32, information: Information| {
+            Ok(vec![SvcMessage::from(RdpdrPdu::DeviceCreateResponse(
+                DeviceCreateResponse {
+                    device_io_reply: DeviceIoResponse::new(request, status),
+                    file_id,
+                    information,
+                },
+            ))])
+        };
+        if !self.drives.iter().any(|d| d.device_id == device_id) {
+            warn!(device_id, "Create on a drive that isn't shared");
+            return respond(req.device_io_request, NtStatus::NO_SUCH_FILE, 0, Information::empty());
+        }
+
+        let wants_dir = req.create_options.contains(CreateOptions::FILE_DIRECTORY_FILE);
+        let wants_file = req.create_options.contains(CreateOptions::FILE_NON_DIRECTORY_FILE);
+        let delete_on_close = req.create_options.contains(CreateOptions::FILE_DELETE_ON_CLOSE);
+        let disposition = req.create_disposition;
+
+        let existing = match self.fs.stat(device_id, &path) {
+            Ok(stat) => stat,
+            Err(status) => return respond(req.device_io_request, status, 0, Information::empty()),
+        };
+
+        // Directories: opened without a handle; made when the disposition allows.
+        let (is_dir, handle, information) = match &existing {
+            Some(stat) if stat.dir => {
+                if wants_file {
+                    return respond(
+                        req.device_io_request,
+                        NtStatus::FILE_IS_A_DIRECTORY,
+                        0,
+                        Information::empty(),
+                    );
+                }
+                if disposition == CreateDisposition::FILE_CREATE {
+                    return respond(
+                        req.device_io_request,
+                        NtStatus::OBJECT_NAME_COLLISION,
+                        0,
+                        Information::empty(),
+                    );
+                }
+                (true, None, Information::FILE_OPENED)
+            }
+            Some(_) if wants_dir => {
+                return respond(
+                    req.device_io_request,
+                    NtStatus::NOT_A_DIRECTORY,
+                    0,
+                    Information::empty(),
+                );
+            }
+            None if wants_dir => {
+                if disposition != CreateDisposition::FILE_CREATE && disposition != CreateDisposition::FILE_OPEN_IF {
+                    return respond(req.device_io_request, NtStatus::NO_SUCH_FILE, 0, Information::empty());
+                }
+                if let Err(status) = self.fs.mkdir(device_id, &path) {
+                    return respond(req.device_io_request, status, 0, Information::empty());
+                }
+                (true, None, Information::FILE_CREATED)
+            }
+            _ => {
+                // A file: the disposition says whether it must, may or mustn't exist, and whether it is truncated.
+                let exists = existing.is_some();
+                let (mode, information) = match disposition {
+                    CreateDisposition::FILE_OPEN => {
+                        if !exists {
+                            return respond(req.device_io_request, NtStatus::NO_SUCH_FILE, 0, Information::empty());
+                        }
+                        (OpenMode::default(), Information::FILE_OPENED)
+                    }
+                    CreateDisposition::FILE_CREATE => {
+                        if exists {
+                            return respond(
+                                req.device_io_request,
+                                NtStatus::OBJECT_NAME_COLLISION,
+                                0,
+                                Information::empty(),
+                            );
+                        }
+                        (
+                            OpenMode {
+                                write: true,
+                                create: true,
+                                exclusive: true,
+                                truncate: false,
+                            },
+                            Information::FILE_CREATED,
+                        )
+                    }
+                    CreateDisposition::FILE_OPEN_IF => (
+                        OpenMode {
+                            write: true,
+                            create: true,
+                            exclusive: false,
+                            truncate: false,
+                        },
+                        if exists {
+                            Information::FILE_OPENED
+                        } else {
+                            Information::FILE_CREATED
+                        },
+                    ),
+                    CreateDisposition::FILE_OVERWRITE => {
+                        if !exists {
+                            return respond(req.device_io_request, NtStatus::NO_SUCH_FILE, 0, Information::empty());
+                        }
+                        (
+                            OpenMode {
+                                write: true,
+                                create: false,
+                                exclusive: false,
+                                truncate: true,
+                            },
+                            Information::FILE_OVERWRITTEN,
+                        )
+                    }
+                    CreateDisposition::FILE_OVERWRITE_IF => (
+                        OpenMode {
+                            write: true,
+                            create: true,
+                            exclusive: false,
+                            truncate: true,
+                        },
+                        if exists {
+                            Information::FILE_OVERWRITTEN
+                        } else {
+                            Information::FILE_CREATED
+                        },
+                    ),
+                    // FILE_SUPERSEDE, and anything unknown: a fresh file.
+                    _ => (
+                        OpenMode {
+                            write: true,
+                            create: true,
+                            exclusive: false,
+                            truncate: true,
+                        },
+                        Information::FILE_SUPERSEDED,
+                    ),
+                };
+                // Opened for writing when the server asks for it (or will create/truncate); a read-only file
+                // opened for reading only.
+                let mode = OpenMode {
+                    write: mode.write || wants_write(req.desired_access),
+                    ..mode
+                };
+                let handle = match self.fs.open(device_id, &path, mode) {
+                    Ok(handle) => handle,
+                    // A file that can't be opened for writing (read-only) still opens for reading when the server only
+                    // asked to open it.
+                    Err(NtStatus::ACCESS_DENIED)
+                        if mode.write && !mode.truncate && disposition == CreateDisposition::FILE_OPEN =>
+                    {
+                        match self.fs.open(device_id, &path, OpenMode::default()) {
+                            Ok(handle) => handle,
+                            Err(status) => {
+                                return respond(req.device_io_request, status, 0, Information::empty());
+                            }
+                        }
+                    }
+                    Err(status) => return respond(req.device_io_request, status, 0, Information::empty()),
+                };
+                (false, Some(handle), information)
+            }
+        };
+
+        let file_id = self.next_file_id;
+        self.next_file_id = self.next_file_id.wrapping_add(1).max(1);
+        debug!(file_id, device_id, %path, is_dir, "Drive file opened");
+        self.open.insert(
+            file_id,
+            OpenEntry {
+                device_id,
+                path,
+                handle,
+                dir: is_dir,
+                listing: None,
+                listing_next: 0,
+                delete_on_close,
+            },
+        );
+        respond(req.device_io_request, NtStatus::SUCCESS, file_id, information)
+    }
+
+    fn close(&mut self, req: DeviceCloseRequest) -> PduResult<Vec<SvcMessage>> {
+        if let Some(entry) = self.open.remove(&req.device_io_request.file_id) {
+            if let Some(handle) = entry.handle {
+                if let Err(status) = self.fs.close(handle) {
+                    warn!(?status, "Closing a drive file failed");
+                }
+            }
+            if entry.delete_on_close {
+                if let Err(status) = self.fs.remove(entry.device_id, &entry.path) {
+                    warn!(?status, path = %entry.path, "Removing a drive file on close failed");
+                }
+            }
+        }
+        Ok(vec![SvcMessage::from(RdpdrPdu::DeviceCloseResponse(
+            DeviceCloseResponse {
+                device_io_response: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+            },
+        ))])
+    }
+
+    fn read(&mut self, req: DeviceReadRequest) -> PduResult<Vec<SvcMessage>> {
+        let respond = |request: DeviceIoRequest, status: NtStatus, read_data: Vec<u8>| {
+            Ok(vec![SvcMessage::from(RdpdrPdu::DeviceReadResponse(
+                DeviceReadResponse {
+                    device_io_reply: DeviceIoResponse::new(request, status),
+                    read_data,
+                },
+            ))])
+        };
+        let Some(handle) = self.open.get(&req.device_io_request.file_id).and_then(|e| e.handle) else {
+            return respond(req.device_io_request, NtStatus::INVALID_HANDLE, Vec::new());
+        };
+        match self.fs.read(handle, req.offset, req.length) {
+            Ok(data) => respond(req.device_io_request, NtStatus::SUCCESS, data),
+            Err(status) => respond(req.device_io_request, status, Vec::new()),
+        }
+    }
+
+    fn write(&mut self, req: DeviceWriteRequest) -> PduResult<Vec<SvcMessage>> {
+        let respond = |request: DeviceIoRequest, status: NtStatus, length: u32| {
+            Ok(vec![SvcMessage::from(RdpdrPdu::DeviceWriteResponse(
+                DeviceWriteResponse {
+                    device_io_reply: DeviceIoResponse::new(request, status),
+                    length,
+                },
+            ))])
+        };
+        let Some(handle) = self.open.get(&req.device_io_request.file_id).and_then(|e| e.handle) else {
+            return respond(req.device_io_request, NtStatus::INVALID_HANDLE, 0);
+        };
+        match self.fs.write(handle, req.offset, &req.write_data) {
+            Ok(length) => respond(req.device_io_request, NtStatus::SUCCESS, length),
+            Err(status) => respond(req.device_io_request, status, 0),
+        }
+    }
+
+    fn query_information(&mut self, req: ServerDriveQueryInformationRequest) -> PduResult<Vec<SvcMessage>> {
+        let respond = |request: DeviceIoRequest, status: NtStatus, buffer: Option<FileInformationClass>| {
+            Ok(vec![SvcMessage::from(RdpdrPdu::ClientDriveQueryInformationResponse(
+                ClientDriveQueryInformationResponse {
+                    device_io_response: DeviceIoResponse::new(request, status),
+                    buffer,
+                },
+            ))])
+        };
+        let Some(entry) = self.open.get(&req.device_io_request.file_id) else {
+            return respond(req.device_io_request, NtStatus::INVALID_HANDLE, None);
+        };
+        let stat = match self.fs.stat(entry.device_id, &entry.path) {
+            Ok(Some(stat)) => stat,
+            Ok(None) => return respond(req.device_io_request, NtStatus::NO_SUCH_FILE, None),
+            Err(status) => return respond(req.device_io_request, status, None),
+        };
+        let attributes = attributes_of(&stat, file_name(&entry.path));
+        let buffer = match req.file_info_class_lvl {
+            FileInformationClassLevel::FILE_BASIC_INFORMATION => FileInformationClass::Basic(FileBasicInformation {
+                creation_time: filetime(stat.created),
+                last_access_time: filetime(stat.accessed),
+                last_write_time: filetime(stat.modified),
+                change_time: filetime(stat.modified),
+                file_attributes: attributes,
+            }),
+            FileInformationClassLevel::FILE_STANDARD_INFORMATION => {
+                FileInformationClass::Standard(FileStandardInformation {
+                    allocation_size: size_i64(stat.size),
+                    end_of_file: size_i64(stat.size),
+                    number_of_links: 1,
+                    delete_pending: if entry.delete_on_close {
+                        Boolean::True
+                    } else {
+                        Boolean::False
+                    },
+                    directory: if stat.dir { Boolean::True } else { Boolean::False },
+                })
+            }
+            FileInformationClassLevel::FILE_ATTRIBUTE_TAG_INFORMATION => {
+                FileInformationClass::AttributeTag(FileAttributeTagInformation {
+                    file_attributes: attributes,
+                    reparse_tag: 0,
+                })
+            }
+            other => {
+                debug!(?other, "Unsupported file information class");
+                return respond(req.device_io_request, NtStatus::NOT_SUPPORTED, None);
+            }
+        };
+        respond(req.device_io_request, NtStatus::SUCCESS, Some(buffer))
+    }
+
+    fn query_volume_information(
+        &mut self,
+        req: ServerDriveQueryVolumeInformationRequest,
+    ) -> PduResult<Vec<SvcMessage>> {
+        let respond = |request: DeviceIoRequest, status: NtStatus, buffer: Option<FileSystemInformationClass>| {
+            Ok(vec![SvcMessage::from(
+                RdpdrPdu::ClientDriveQueryVolumeInformationResponse(ClientDriveQueryVolumeInformationResponse {
+                    device_io_reply: DeviceIoResponse::new(request, status),
+                    buffer,
+                }),
+            )])
+        };
+        let Some(entry) = self.open.get(&req.device_io_request.file_id) else {
+            return respond(req.device_io_request, NtStatus::INVALID_HANDLE, None);
+        };
+        let volume = match self.fs.volume(entry.device_id) {
+            Ok(volume) => volume,
+            Err(status) => return respond(req.device_io_request, status, None),
+        };
+        // Sizes are reported in allocation units of one sector of 512 bytes (the figures are informational).
+        const SECTOR: u64 = 512;
+        const SECTOR_U32: u32 = 512;
+        let units = |bytes: u64| size_i64(bytes / SECTOR);
+        let buffer = match req.fs_info_class_lvl {
+            FileSystemInformationClassLevel::FILE_FS_VOLUME_INFORMATION => {
+                FileSystemInformationClass::FileFsVolumeInformation(FileFsVolumeInformation {
+                    volume_creation_time: 0,
+                    volume_serial_number: serial_of(entry.device_id, &volume.label),
+                    supports_objects: Boolean::False,
+                    volume_label: if volume.label.is_empty() {
+                        drive_name(&self.drives, entry.device_id)
+                    } else {
+                        volume.label
+                    },
+                })
+            }
+            FileSystemInformationClassLevel::FILE_FS_SIZE_INFORMATION => {
+                FileSystemInformationClass::FileFsSizeInformation(FileFsSizeInformation {
+                    total_alloc_units: units(volume.total),
+                    available_alloc_units: units(volume.free),
+                    sectors_per_alloc_unit: 1,
+                    bytes_per_sector: SECTOR_U32,
+                })
+            }
+            FileSystemInformationClassLevel::FILE_FS_FULL_SIZE_INFORMATION => {
+                FileSystemInformationClass::FileFsFullSizeInformation(FileFsFullSizeInformation {
+                    total_alloc_units: units(volume.total),
+                    caller_available_alloc_units: units(volume.free),
+                    actual_available_alloc_units: units(volume.free),
+                    sectors_per_alloc_unit: 1,
+                    bytes_per_sector: SECTOR_U32,
+                })
+            }
+            FileSystemInformationClassLevel::FILE_FS_ATTRIBUTE_INFORMATION => {
+                FileSystemInformationClass::FileFsAttributeInformation(FileFsAttributeInformation {
+                    file_system_attributes: FileSystemAttributes::FILE_CASE_SENSITIVE_SEARCH
+                        | FileSystemAttributes::FILE_CASE_PRESERVED_NAMES
+                        | FileSystemAttributes::FILE_UNICODE_ON_DISK,
+                    max_component_name_len: 255,
+                    file_system_name: "NTFS".to_owned(),
+                })
+            }
+            other => {
+                debug!(?other, "Unsupported file system information class");
+                return respond(req.device_io_request, NtStatus::NOT_SUPPORTED, None);
+            }
+        };
+        respond(req.device_io_request, NtStatus::SUCCESS, Some(buffer))
+    }
+
+    fn set_information(&mut self, req: ServerDriveSetInformationRequest) -> PduResult<Vec<SvcMessage>> {
+        let respond = |req: &ServerDriveSetInformationRequest, status: NtStatus| {
+            Ok(vec![SvcMessage::from(RdpdrPdu::ClientDriveSetInformationResponse(
+                ClientDriveSetInformationResponse::new(req, status).map_err(|e| encode_err!(e))?,
+            ))])
+        };
+        let Some(entry) = self.open.get_mut(&req.device_io_request.file_id) else {
+            return respond(&req, NtStatus::INVALID_HANDLE);
+        };
+        let status = match &req.set_buffer {
+            FileInformationClass::Rename(info) => {
+                let to = normalize(&info.file_name);
+                match self.fs.rename(
+                    entry.device_id,
+                    &entry.path,
+                    &to,
+                    info.replace_if_exists == Boolean::True,
+                ) {
+                    Ok(()) => {
+                        entry.path = to;
+                        NtStatus::SUCCESS
+                    }
+                    Err(status) => status,
+                }
+            }
+            FileInformationClass::Disposition(info) => {
+                entry.delete_on_close = info.delete_pending != 0;
+                NtStatus::SUCCESS
+            }
+            FileInformationClass::EndOfFile(info) => match entry.handle {
+                Some(handle) => match self.fs.truncate(handle, u64::try_from(info.end_of_file).unwrap_or(0)) {
+                    Ok(()) => NtStatus::SUCCESS,
+                    Err(status) => status,
+                },
+                None => NtStatus::FILE_IS_A_DIRECTORY,
+            },
+            // Allocation hints and attribute/time changes are taken without doing anything: the host's file system
+            // keeps its own.
+            FileInformationClass::Allocation(_) | FileInformationClass::Basic(_) => NtStatus::SUCCESS,
+            other => {
+                debug!(class = %other, "Unsupported set-information class");
+                NtStatus::NOT_SUPPORTED
+            }
+        };
+        respond(&req, status)
+    }
+
+    fn query_directory(&mut self, req: ServerDriveQueryDirectoryRequest) -> PduResult<Vec<SvcMessage>> {
+        let respond = |request: DeviceIoRequest, status: NtStatus, buffer: Option<FileInformationClass>| {
+            Ok(vec![SvcMessage::from(RdpdrPdu::ClientDriveQueryDirectoryResponse(
+                ClientDriveQueryDirectoryResponse {
+                    device_io_reply: DeviceIoResponse::new(request, status),
+                    buffer,
+                },
+            ))])
+        };
+        let Some(entry) = self.open.get_mut(&req.device_io_request.file_id) else {
+            return respond(req.device_io_request, NtStatus::INVALID_HANDLE, None);
+        };
+        if !entry.dir {
+            return respond(req.device_io_request, NtStatus::NOT_A_DIRECTORY, None);
+        }
+        if req.initial_query != 0 {
+            // The path is the directory's with a pattern as its last component: `\dir\*`, `\dir\*.txt`, or an exact
+            // name to look for.
+            let query = normalize(&req.path);
+            let (dir, pattern) = match query.rsplit_once('\\') {
+                Some(("", pattern)) => ("\\", pattern),
+                Some((dir, pattern)) => (dir, pattern),
+                None => (entry.path.as_str(), query.as_str()),
+            };
+            let names = match self.fs.list(entry.device_id, dir) {
+                Ok(names) => names,
+                Err(status) => return respond(req.device_io_request, status, None),
+            };
+            let mut matching: Vec<String> = names.into_iter().filter(|name| matches(pattern, name)).collect();
+            matching.sort();
+            entry.listing = Some(matching);
+            entry.listing_next = 0;
+        }
+        let (device_id, dir) = (entry.device_id, entry.path.clone());
+        let Some(listing) = entry.listing.as_ref() else {
+            return respond(req.device_io_request, NtStatus::NO_MORE_FILES, None);
+        };
+        // Entries whose stat fails (gone meanwhile) are skipped.
+        while let Some(name) = listing.get(entry.listing_next).cloned() {
+            entry.listing_next = entry.listing_next.saturating_add(1);
+            let path = join(&dir, &name);
+            let stat = match self.fs.stat(device_id, &path) {
+                Ok(Some(stat)) => stat,
+                _ => continue,
+            };
+            let attributes = attributes_of(&stat, &name);
+            let size = size_i64(stat.size);
+            let buffer = match req.file_info_class_lvl {
+                FileInformationClassLevel::FILE_BOTH_DIRECTORY_INFORMATION => {
+                    FileInformationClass::BothDirectory(FileBothDirectoryInformation::new(
+                        filetime(stat.created),
+                        filetime(stat.accessed),
+                        filetime(stat.modified),
+                        filetime(stat.modified),
+                        size,
+                        attributes,
+                        name,
+                    ))
+                }
+                FileInformationClassLevel::FILE_FULL_DIRECTORY_INFORMATION => {
+                    FileInformationClass::FullDirectory(FileFullDirectoryInformation::new(
+                        filetime(stat.created),
+                        filetime(stat.accessed),
+                        filetime(stat.modified),
+                        filetime(stat.modified),
+                        size,
+                        attributes,
+                        name,
+                    ))
+                }
+                FileInformationClassLevel::FILE_DIRECTORY_INFORMATION => {
+                    FileInformationClass::Directory(FileDirectoryInformation::new(
+                        filetime(stat.created),
+                        filetime(stat.accessed),
+                        filetime(stat.modified),
+                        filetime(stat.modified),
+                        size,
+                        attributes,
+                        name,
+                    ))
+                }
+                FileInformationClassLevel::FILE_NAMES_INFORMATION => {
+                    FileInformationClass::Names(FileNamesInformation::new(name))
+                }
+                other => {
+                    debug!(?other, "Unsupported directory information class");
+                    return respond(req.device_io_request, NtStatus::NOT_SUPPORTED, None);
+                }
+            };
+            return respond(req.device_io_request, NtStatus::SUCCESS, Some(buffer));
+        }
+        let status = if req.initial_query != 0 {
+            NtStatus::NO_SUCH_FILE
+        } else {
+            NtStatus::NO_MORE_FILES
+        };
+        respond(req.device_io_request, status, None)
+    }
+}
+
+impl RdpdrBackend for WasmDriveBackend {
+    fn handle_server_device_announce_response(&mut self, pdu: ServerDeviceAnnounceResponse) -> PduResult<()> {
+        if pdu.result_code != NtStatus::SUCCESS {
+            warn!(device_id = pdu.device_id, status = ?pdu.result_code, "The server declined a shared drive");
+        }
+        Ok(())
+    }
+
+    fn handle_scard_call(
+        &mut self,
+        _req: DeviceControlRequest<ScardIoCtlCode>,
+        _call: ScardCall,
+    ) -> PduResult<Vec<SvcMessage>> {
+        Ok(Vec::new())
+    }
+
+    fn handle_drive_io_request(&mut self, req: ServerDriveIoRequest) -> PduResult<Vec<SvcMessage>> {
+        match req {
+            ServerDriveIoRequest::ServerCreateDriveRequest(req) => self.create(req),
+            ServerDriveIoRequest::DeviceCloseRequest(req) => self.close(req),
+            ServerDriveIoRequest::DeviceReadRequest(req) => self.read(req),
+            ServerDriveIoRequest::DeviceWriteRequest(req) => self.write(req),
+            ServerDriveIoRequest::ServerDriveQueryInformationRequest(req) => self.query_information(req),
+            ServerDriveIoRequest::ServerDriveQueryVolumeInformationRequest(req) => self.query_volume_information(req),
+            ServerDriveIoRequest::ServerDriveSetInformationRequest(req) => self.set_information(req),
+            ServerDriveIoRequest::ServerDriveQueryDirectoryRequest(req) => self.query_directory(req),
+            ServerDriveIoRequest::DeviceFlushBuffersRequest(req) => Ok(vec![SvcMessage::from(
+                RdpdrPdu::DeviceFlushBuffersResponse(DeviceFlushBuffersResponse {
+                    device_io_response: DeviceIoResponse::new(req.device_io_request, NtStatus::SUCCESS),
+                }),
+            )]),
+            // Change notification is never answered: the server keeps the request pending, as with other clients
+            // that don't watch directories.
+            ServerDriveIoRequest::ServerDriveNotifyChangeDirectoryRequest(_) => Ok(Vec::new()),
+            // Locks are granted without being enforced: one client at a time uses these files.
+            ServerDriveIoRequest::ServerDriveLockControlRequest(req) => {
+                Ok(vec![SvcMessage::from(RdpdrPdu::ClientDriveLockControlResponse(
+                    ClientDriveLockControlResponse::new(req.device_io_request, NtStatus::SUCCESS),
+                ))])
+            }
+            ServerDriveIoRequest::DeviceControlRequest(req) => Ok(vec![SvcMessage::from(
+                RdpdrPdu::DeviceControlResponse(DeviceControlResponse {
+                    device_io_reply: DeviceIoResponse::new(req.header, NtStatus::SUCCESS),
+                    output_buffer: None,
+                }),
+            )]),
+            ServerDriveIoRequest::ServerDriveQuerySecurityRequest(req) => Ok(vec![SvcMessage::from(
+                RdpdrPdu::ClientDriveQuerySecurityResponse(ClientDriveQuerySecurityResponse {
+                    device_io_response: DeviceIoResponse::new(req.device_io_request, NtStatus::NOT_SUPPORTED),
+                    security_descriptor: None,
+                }),
+            )]),
+            ServerDriveIoRequest::ServerDriveSetSecurityRequest(req) => {
+                Ok(vec![SvcMessage::from(RdpdrPdu::ClientDriveSetSecurityResponse(
+                    ClientDriveSetSecurityResponse::new(&req, NtStatus::NOT_SUPPORTED).map_err(|e| encode_err!(e))?,
+                ))])
+            }
+        }
+    }
+}
+
+/// The server's path with a leading backslash and no trailing one (the root is `\`), forward slashes as backslashes.
+fn normalize(path: &str) -> String {
+    let path = path.replace('/', "\\");
+    let trimmed = path.trim_end_matches('\\');
+    if trimmed.is_empty() {
+        "\\".to_owned()
+    } else if trimmed.starts_with('\\') {
+        trimmed.to_owned()
+    } else {
+        format!("\\{trimmed}")
+    }
+}
+
+fn join(dir: &str, name: &str) -> String {
+    if dir == "\\" {
+        format!("\\{name}")
+    } else {
+        format!("{dir}\\{name}")
+    }
+}
+
+fn file_name(path: &str) -> &str {
+    path.rsplit('\\').next().unwrap_or(path)
+}
+
+fn drive_name(drives: &[SharedDrive], device_id: u32) -> String {
+    drives
+        .iter()
+        .find(|d| d.device_id == device_id)
+        .map(|d| d.name.clone())
+        .unwrap_or_default()
+}
+
+/// Whether the server asks for an access that writes (data, append) or everything.
+fn wants_write(access: DesiredAccess) -> bool {
+    access.intersects(
+        DesiredAccess::FILE_WRITE_DATA_OR_FILE_ADD_FILE
+            | DesiredAccess::FILE_APPEND_DATA_OR_FILE_ADD_SUBDIRECTORY
+            | DesiredAccess::GENERIC_WRITE
+            | DesiredAccess::GENERIC_ALL,
+    )
+}
+
+fn attributes_of(stat: &Stat, name: &str) -> FileAttributes {
+    let mut attributes = FileAttributes::empty();
+    if stat.dir {
+        attributes |= FileAttributes::FILE_ATTRIBUTE_DIRECTORY;
+    } else {
+        attributes |= FileAttributes::FILE_ATTRIBUTE_ARCHIVE;
+    }
+    if stat.readonly {
+        attributes |= FileAttributes::FILE_ATTRIBUTE_READONLY;
+    }
+    // Unix convention: a leading dot hides a file.
+    if name.len() > 1 && name.starts_with('.') && !name.starts_with("..") {
+        attributes |= FileAttributes::FILE_ATTRIBUTE_HIDDEN;
+    }
+    attributes
+}
+
+/// Milliseconds since the Unix epoch as a Windows FILETIME (100 ns units since 1601).
+fn filetime(ms_since_epoch: f64) -> i64 {
+    if !ms_since_epoch.is_finite() || ms_since_epoch <= 0.0 {
+        return 0;
+    }
+    const EPOCH_DIFFERENCE: i64 = 116_444_736_000_000_000;
+    i64::try_from(to_u64(ms_since_epoch))
+        .unwrap_or(i64::MAX)
+        .saturating_mul(10_000)
+        .saturating_add(EPOCH_DIFFERENCE)
+}
+
+fn size_i64(size: u64) -> i64 {
+    i64::try_from(size).unwrap_or(i64::MAX)
+}
+
+/// A stable volume serial from the drive's id and label.
+fn serial_of(device_id: u32, label: &str) -> u32 {
+    label.bytes().fold(device_id.wrapping_mul(2_654_435_761), |h, b| {
+        h.wrapping_mul(31).wrapping_add(u32::from(b))
+    })
+}
+
+/// Whether `name` matches a DOS-style pattern (`*`, `?`), case-insensitively; an empty pattern matches everything.
+fn matches(pattern: &str, name: &str) -> bool {
+    fn go(p: &[char], n: &[char]) -> bool {
+        match (p.first(), n.first()) {
+            (None, None) => true,
+            (Some('*'), _) => go(&p[1..], n) || (!n.is_empty() && go(p, &n[1..])),
+            (Some('?'), Some(_)) => go(&p[1..], &n[1..]),
+            (Some(pc), Some(nc)) => pc.eq_ignore_ascii_case(nc) && go(&p[1..], &n[1..]),
+            (Some(_), None) => false,
+            (None, Some(_)) => false,
+        }
+    }
+    if pattern.is_empty() || pattern == "*" || pattern == "*.*" {
+        return true;
+    }
+    let pattern: Vec<char> = pattern.to_lowercase().chars().collect();
+    let name: Vec<char> = name.to_lowercase().chars().collect();
+    go(&pattern, &name)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn patterns() {
+        assert!(matches("*", "anything"));
+        assert!(matches("*.*", "no-dot"));
+        assert!(matches("*.txt", "Notes.TXT"));
+        assert!(!matches("*.txt", "notes.txt.bak"));
+        assert!(matches("a?c", "abc"));
+        assert!(!matches("a?c", "abbc"));
+        assert!(matches("exact.name", "EXACT.name"));
+        assert!(!matches("exact.name", "exact.names"));
+    }
+
+    #[test]
+    fn paths() {
+        assert_eq!(normalize(""), "\\");
+        assert_eq!(normalize("\\"), "\\");
+        assert_eq!(normalize("dir\\file.txt"), "\\dir\\file.txt");
+        assert_eq!(normalize("/dir/"), "\\dir");
+        assert_eq!(join("\\", "a"), "\\a");
+        assert_eq!(join("\\dir", "a"), "\\dir\\a");
+        assert_eq!(file_name("\\dir\\a.txt"), "a.txt");
+    }
+
+    #[test]
+    fn filetimes() {
+        assert_eq!(filetime(0.0), 0);
+        // 2000-01-01T00:00:00Z
+        assert_eq!(filetime(946_684_800_000.0), 125_911_584_000_000_000);
+    }
+}
