@@ -345,6 +345,65 @@ describe('WebCodecsH264Decoder', () => {
         ]);
     });
 
+    /** Pictures whose `copyTo` finishes only when the `copies` are called: until then, their readbacks are in flight. */
+    function slowPictures() {
+        const copies: (() => void)[] = [];
+        class SlowPicture extends FakePicture {
+            override async copyTo(): Promise<void> {
+                await new Promise<void>((resolve) => copies.push(resolve));
+            }
+        }
+        const emit = (id: number, width: number, height: number) =>
+            FakeDecoder.instances[0].init.output(new SlowPicture(id, width, height));
+        return { copies, emit };
+    }
+
+    /** A frame for a 4096x4096 picture, whole: 64 MiB of RGBA to read back. */
+    function picture4k(id: number): H264Frame {
+        const whole = { left: 0, top: 0, right: 4096, bottom: 4096 };
+        return { ...frame(id, id === 0, [whole]), destination: whole };
+    }
+
+    it('fails when the pictures being read back hold too much', async () => {
+        const failures: string[] = [];
+        decoder.close();
+        decoder = new WebCodecsH264Decoder({ onFailure: (reason) => failures.push(reason), now: () => clock });
+        const { copies, emit } = slowPictures();
+        // Eight of these being read back at once (512 MiB) fit in what may be, a ninth does not.
+        for (let id = 0; id < 8; id++) {
+            decoder.decode(picture4k(id), done);
+            emit(id, 4096, 4096);
+        }
+        await flush();
+        expect(decoder.failed).toBeNull();
+        expect(copies.length).toBe(8);
+
+        decoder.decode(picture4k(8), done);
+        emit(8, 4096, 4096);
+        expect(failures).toEqual(['more than 512 MiB of pictures being read back']);
+        expect(done).toHaveBeenLastCalledWith(8, null, 'more than 512 MiB of pictures being read back');
+        expect(copies.length).toBe(8);
+    });
+
+    it('counts a picture out of those being read back once it is read', async () => {
+        const { copies, emit } = slowPictures();
+        for (let id = 0; id < 8; id++) {
+            decoder.decode(picture4k(id), done);
+            emit(id, 4096, 4096);
+        }
+        await flush();
+        copies[0]();
+        await flush();
+        expect(done).toHaveBeenCalledWith(0, expect.any(Uint8Array));
+        // Frame 0's picture is read: a ninth fits, a tenth does not.
+        decoder.decode(picture4k(8), done);
+        emit(8, 4096, 4096);
+        expect(decoder.failed).toBeNull();
+        decoder.decode(picture4k(9), done);
+        emit(9, 4096, 4096);
+        expect(decoder.failed).toBe('more than 512 MiB of pictures being read back');
+    });
+
     it('fails when no key frame comes', () => {
