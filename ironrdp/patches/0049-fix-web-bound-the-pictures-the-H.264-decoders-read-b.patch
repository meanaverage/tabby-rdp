+        // What the regions are read into: counted before reading the picture allocates it, until it is handed back.
+        const bytes = pending.frame.regions.reduce((sum, r) => sum + (r.right - r.left) * (r.bottom - r.top) * 4, 0);
+        if (this.readbackBytes + bytes > WebCodecsH264Decoder.MAX_READBACK_BYTES) {
