+            tile_size: 0x40,
+            rects: vec![rect(0, 0, 64, 64)],
+            quant_vals: vec![ComponentCodecQuant::LOSSLESS],
+            quant_prog_vals: vec![],
+            flags: 0,
+            tiles: vec![
+                ProgressiveTile::Simple(TileSimple {
+                    quant_idx_y: 0,
+                    quant_idx_cb: 0,
+                    quant_idx_cr: 0,
+                    x_idx: 0,
+                    y_idx: 0,
+                    flags: 0,
+                    y_data: &[],
+                    cb_data: &[],
+                    cr_data: &[],
+                    tail_data: &[],
+                });
+                9
+            ],
+        });
+        let stream = |region_in_frame: bool| {
+            let mut blocks = vec![
+                ProgressiveBlock::Sync(ProgressiveSyncPdu),
+                ProgressiveBlock::Context(ProgressiveContextPdu {
+                    context_id: 0,
+                    tile_size: 0x0040,
+                    flags: 0,
+                }),
+                ProgressiveBlock::FrameBegin(ProgressiveFrameBeginPdu {
+                    frame_index: 0,
+                    region_count: 1,
+                }),
+                ProgressiveBlock::FrameEnd(ProgressiveFrameEndPdu),
+            ];
+            blocks.insert(if region_in_frame { 3 } else { 4 }, region.clone());
+            encode_progressive_stream(&blocks).unwrap()
+        };
+        let mut decoder = ProgressiveDecoder::new();
+        decoder.max_tiles_per_bitmap = 8;
+
+        assert!(matches!(
+            decoder.decode_bitmap(1, 0, 64, 64, &stream(true)),
+            Err(ProgressiveDecodeError::TileLimitExceeded { limit: 8 })
+        ));
+        // Nothing was decoded or kept.
+        assert!(decoder.surfaces.is_empty());
+        assert_eq!(decoder.memory.used, 0);
