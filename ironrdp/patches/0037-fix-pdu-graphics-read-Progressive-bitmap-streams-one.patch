+/// Decodes a progressive bitmap stream one block at a time.
+///
+/// The iterator yields each block in wire order, and ends after the first error. A REGION block
+/// comes with its rectangles and quants decoded, and its tile blocks undecoded: its
+/// [`ProgressiveRegionTiles`] decode them one at a time. Unlike [`decode_progressive_stream`], this
+/// holds one block, and one tile block, at a time, however many the stream has.
+pub fn decode_progressive_stream_blocks(data: &[u8]) -> ProgressiveStreamBlocks<'_> {
+    ProgressiveStreamBlocks {
+        src: ReadCursor::new(data),
+        done: false,
+    }
+}
