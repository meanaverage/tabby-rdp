+/// Decodes one of a REGION block's tile blocks, each preceded by a block header, checking its
+/// quant indices against the REGION's `quant_count` quants.
+fn decode_region_tile<'a>(src: &mut ReadCursor<'a>, quant_count: usize) -> DecodeResult<ProgressiveTile<'a>> {
+    let header = ProgressiveBlockHeader::decode(src)?;
+    let body_len = header
+        .block_len
+        .checked_sub(BLOCK_HEADER_SIZE_U32)
+        .ok_or_else(|| invalid_field_err!("blockLen", "tile block length too small", in: src))?;
+    let body_len: usize = cast_length!("tileBodyLen", body_len, in: src)?;
+    ensure_size!(ctx: ProgressiveRegion::NAME, in: src, size: body_len);
+    let tile_src = &mut ReadCursor::new(src.read_slice(body_len));
+
+    let tile = match header.block_type {
+        ProgressiveBlockType::TileSimple => ProgressiveTile::Simple(TileSimple::decode(tile_src)?),
+        ProgressiveBlockType::TileFirst => ProgressiveTile::First(TileFirst::decode(tile_src)?),
+        ProgressiveBlockType::TileUpgrade => ProgressiveTile::Upgrade(TileUpgrade::decode(tile_src)?),
+        _ => {
+            return Err(invalid_field_err!("blockType", "expected tile block inside region", in: src));
+        }
+    };
+
+    let indices = match &tile {
+        ProgressiveTile::Simple(t) => [t.quant_idx_y, t.quant_idx_cb, t.quant_idx_cr],
+        ProgressiveTile::First(t) => [t.quant_idx_y, t.quant_idx_cb, t.quant_idx_cr],
+        ProgressiveTile::Upgrade(t) => [t.quant_idx_y, t.quant_idx_cb, t.quant_idx_cr],
+    };
+    if indices.iter().any(|&i| usize::from(i) >= quant_count) {
+        return Err(invalid_field_err!("quantIdx", "tile quant index out of range", in: src));
+    }
+
+    Ok(tile)
+}
+
+/// Iterator over the tile blocks of a REGION block, decoding one at a time.
+///
+/// It yields as many tile blocks as the REGION block's header announces, and ends after the
+/// first error: a tile block that does not decode, or names a quant past the REGION's.
+#[derive(Debug, Clone)]
+pub struct ProgressiveRegionTiles<'a> {
+    src: ReadCursor<'a>,
+    /// Tile blocks left to decode: none after an error.
+    remaining: u16,
+    /// Number of quants the REGION block carries.
+    quant_count: usize,
+}
+
+impl<'a> Iterator for ProgressiveRegionTiles<'a> {
+    type Item = DecodeResult<ProgressiveTile<'a>>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        let remaining = self.remaining.checked_sub(1)?;
+        let tile = decode_region_tile(&mut self.src, self.quant_count);
+        self.remaining = if tile.is_ok() { remaining } else { 0 };
+        Some(tile)
+    }
+
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        (0, Some(usize::from(self.remaining)))
+    }
+}
