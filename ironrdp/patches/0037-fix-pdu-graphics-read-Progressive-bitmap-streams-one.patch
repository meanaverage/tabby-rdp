+fn progressive_tile_blocks_take_no_memory_before_they_are_decoded() {
+    // Eight REGION blocks of 65535 empty TILE_SIMPLE blocks each, 11 MiB: in the frame, more tile
+    // blocks than a bitmap may decode; after it, tile blocks the decoder ignores. Collected, they
+    // took 56 MiB on 64-bit targets.
+    let region = ProgressiveBlock::Region(ProgressiveRegion {
+        tile_size: 0x40,
+        rects: vec![RfxRectangle {
+            x: 0,
+            y: 0,
+            width: 64,
+            height: 64,
+        }],
+        quant_vals: vec![ComponentCodecQuant::LOSSLESS],
+        quant_prog_vals: vec![],
+        flags: 0,
+        tiles: vec![
+            ProgressiveTile::Simple(TileSimple {
+                quant_idx_y: 0,
+                quant_idx_cb: 0,
+                quant_idx_cr: 0,
+                x_idx: 0,
+                y_idx: 0,
+                flags: 0,
+                y_data: &[],
+                cb_data: &[],
+                cr_data: &[],
+                tail_data: &[],
+            });
+            65535
+        ],
+    });
+    let regions = || core::iter::repeat_n(region.clone(), 8);
+    let frame_end = || ProgressiveBlock::FrameEnd(ProgressiveFrameEndPdu);
+    let in_frame = progressive_stream(regions().chain([frame_end()]));
+    let after_frame = progressive_stream(core::iter::once(frame_end()).chain(regions()));
+
+    let (result, peak) = peak_heap(|| ProgressiveDecoder::new().decode_bitmap(1, 0, 64, 64, &in_frame));
+    assert!(peak < 1024 * 1024, "refusing the bitmap took {peak} bytes");
+    assert!(
+        matches!(result, Err(ProgressiveDecodeError::TileLimitExceeded { .. })),
+        "{:?}",
+        result.map(|tiles| tiles.len())
+    );
+
+    let (result, peak) = peak_heap(|| ProgressiveDecoder::new().decode_bitmap(1, 0, 64, 64, &after_frame));
+    assert!(peak < 1024 * 1024, "decoding the bitmap took {peak} bytes");
+    assert!(result.unwrap().is_empty());
+}
