+/// What [`ProgressiveDecoder::decode_bitmap`] learns of a stream reading it whole.
+struct StreamSurvey {
+    /// The band layout of the stream's first CONTEXT block, if it has one.
+    reduce_extrapolate: Option<bool>,
+    /// Number of tile blocks in the REGION blocks of the stream's first frame.
+    first_frame_tiles: usize,
+}
+
+/// Reads a whole progressive bitmap stream, one block and one tile block at a time, failing if any
+/// of it is malformed.
+fn survey_stream(bitmap_data: &[u8]) -> Result<StreamSurvey, ProgressiveDecodeError> {
+    use ironrdp_pdu::codecs::rfx::progressive::{ProgressiveStreamBlock, decode_progressive_stream_blocks};
+
+    let mut survey = StreamSurvey {
+        reduce_extrapolate: None,
+        first_frame_tiles: 0,
+    };
+    let mut first_frame = FirstFrame::default();
+    for block in decode_progressive_stream_blocks(bitmap_data) {
+        let block = block?;
+        let in_first_frame = first_frame.holds(&block);
+        match block {
+            ProgressiveStreamBlock::Context(context) => {
+                if survey.reduce_extrapolate.is_none() {
+                    survey.reduce_extrapolate = Some(context.uses_reduce_extrapolate());
+                }
+            }
+            ProgressiveStreamBlock::Region { header, tiles } => {
+                for tile in tiles {
+                    tile?;
+                }
+                if in_first_frame {
+                    survey.first_frame_tiles = survey.first_frame_tiles.saturating_add(usize::from(header.num_tiles));
+                }
+            }
+            _ => {}
+        }
+    }
+
+    Ok(survey)
+}
+
+/// Follows the blocks of a stream to tell the REGION blocks of its first FRAME_BEGIN/FRAME_END
+/// pair, the only ones [`ProgressiveDecoder::decode_bitmap`] decodes.
+#[derive(Default)]
+struct FirstFrame {
+    inside: bool,
+    ended: bool,
+}
+
+impl FirstFrame {
+    /// Takes the stream's next block, and tells whether it is a REGION block of the first frame.
+    fn holds(&mut self, block: &ironrdp_pdu::codecs::rfx::progressive::ProgressiveStreamBlock<'_>) -> bool {
+        use ironrdp_pdu::codecs::rfx::progressive::ProgressiveStreamBlock;
+
+        match block {
+            ProgressiveStreamBlock::FrameBegin(_) if !self.ended => {
+                self.inside = true;
+                false
+            }
+            ProgressiveStreamBlock::FrameEnd(_) => {
+                self.inside = false;
+                self.ended = true;
+                false
+            }
+            ProgressiveStreamBlock::Region { .. } => self.inside,
+            _ => false,
+        }
+    }
+}
