+/// A progressive bitmap stream: SYNC, CONTEXT and FRAME_BEGIN blocks, then `blocks`.
+fn progressive_stream(blocks: impl IntoIterator<Item = ProgressiveBlock<'static>>) -> Vec<u8> {
+    let mut stream = vec![
+        ProgressiveBlock::Sync(ProgressiveSyncPdu),
+        ProgressiveBlock::Context(ProgressiveContextPdu {
+            context_id: 0,
+            tile_size: 0x0040,
+            flags: 0,
+        }),
+        ProgressiveBlock::FrameBegin(ProgressiveFrameBeginPdu {
+            frame_index: 0,
+            region_count: 1,
+        }),
+    ];
+    stream.extend(blocks);
+    encode_progressive_stream(&stream).expect("the stream encodes")
+}
