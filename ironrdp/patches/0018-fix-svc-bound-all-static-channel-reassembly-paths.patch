+#[test]
+fn static_channel_refuses_compressed_chunks_streamed_past_its_maximum() {
+    // Compressed chunks aren't held to the declared length: only the channel's maximum bounds them.
+    const LIMIT: usize = 64;
+    let mut channel = StaticVirtualChannel::new(LimitedChannel {
+        max_message_size: LIMIT,
+        received: Vec::new(),
+    });
+    let data = vec![0x55; 16];
+    let compressed = ChannelControlFlags::PACKET_COMPRESSED;
+    assert!(
+        channel
+            .process(&channel_chunk(&data, 16, ChannelControlFlags::FLAG_FIRST | compressed))
+            .is_ok()
+    );
+
+    let chunk = channel_chunk(&data, 16, compressed);
+    let held = (1..)
+        .take(2 * LIMIT / data.len())
+        .find(|_| channel.process(&chunk).is_err())
+        .map(|chunks| chunks * data.len());
+    assert_eq!(held, Some(LIMIT), "refused at the chunk that goes past the maximum");
+}
