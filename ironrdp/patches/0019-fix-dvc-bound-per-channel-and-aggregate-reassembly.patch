+/// The largest message a dynamic virtual channel takes, once reassembled from its fragments, unless its processor
+/// says otherwise ([`DvcProcessor::max_message_size`]): 64 MiB.
+///
+/// A fragmented message is as long as its DVC Data First PDU declares, up to 4 GiB, and its fragments are held until
+/// it is complete: nothing but this bounds what a peer can make the receiver hold. Channels whose messages can
+/// legitimately be longer (the graphics pipeline's) declare their own maximum, and so can channels whose protocol
+/// bounds them well below.
+pub const DEFAULT_MAX_MESSAGE_SIZE: usize = 64 * 1024 * 1024;
+
 /// Represents a message that, when encoded, forms a complete PDU for a given dynamic virtual channel.
 /// This means a message that is ready to be wrapped in [`pdu::DataFirstPdu`] and [`pdu::DataPdu`] PDUs
 /// (being split into multiple of such PDUs if necessary).
@@ -109,10 +118,12 @@ pub trait DvcProcessor: AsAny + Send {
 
     /// Returns the maximum complete, reassembled message size accepted by this channel.
     ///
-    /// This limit is checked before DVC fragments are retained for reassembly.
-    /// `None` preserves the historical behavior without a message-size limit.
+    /// This limit is checked before DVC fragments are retained for reassembly. Defaults to
+    /// [`DEFAULT_MAX_MESSAGE_SIZE`]: a fragmented message is as long as its Data First PDU declares, up to 4 GiB,
+    /// and is held until it is complete, so nothing else would bound what a peer can make the receiver hold.
+    /// `None` takes messages of any length.
     fn max_message_size(&self) -> Option<usize> {
-        None
+        Some(DEFAULT_MAX_MESSAGE_SIZE)
     }
 
