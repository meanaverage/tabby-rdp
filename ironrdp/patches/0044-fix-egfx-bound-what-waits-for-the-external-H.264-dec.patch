+
+/// One payload carrying `count` copies of `pdu`.
+fn payload(pdu: &GfxPdu, count: usize) -> Vec<u8> {
+    let encoded = encode_vec(pdu).expect("encode");
+    wrap_uncompressed(&encoded.repeat(count))
+}
+
+#[test]
+fn too_many_commands_waiting_for_the_decoder_are_an_error() {
+    let evict = GfxPdu::EvictCacheEntry(EvictCacheEntryPdu { cache_slot: 1 });
+    let full = [Avc420Region::full_frame(16, 8, 22)];
+
+    // 65,536 commands may wait behind a frame the decoder has not finished.
+    let mut waiting = client();
+    process_all(&mut waiting, &[start(1), avc420(&full, IDR_ACCESS_UNIT)]);
+    assert!(waiting.process(0, &payload(&evict, 65_535)).is_ok());
+    assert_eq!(waiting.pending_h264_frames(), 1);
+    // One more is more than any server makes wait.
+    assert!(waiting.process(0, &payload(&evict, 1)).is_err());
+
+    // Processed as they come, as many fit in one payload.
+    let mut not_waiting = client();
+    assert!(not_waiting.process(0, &payload(&evict, 65_537)).is_ok());
+}
+
+#[test]
+fn what_waits_is_bounded_while_a_payload_is_processed() {
+    let mut client = client();
+    // One payload with more frames than may wait (nothing completes them): refused once there are too many, not
+    // after all of them were handed out.
+    let frame = avc420(&[Avc420Region::full_frame(16, 8, 22)], IDR_ACCESS_UNIT);
+    assert!(client.process(0, &payload(&frame, 100_000)).is_err());
+    assert!(client.pending_h264_frames() <= 65_537);
+    assert!(client.take_h264_frames().len() <= 65_537);
+}
+
+#[test]
+fn pixels_decoded_ahead_of_their_turn_are_bounded() {
+    let mut client = client();
+    // An 8K surface: 127 MiB of RGBA a picture.
+    let surface = GfxPdu::CreateSurface(CreateSurfacePdu {
+        surface_id: 2,
+        width: 7680,
+        height: 4320,
+        pixel_format: PixelFormat::XRgb,
+    });
+    let picture = avc420_to(2, rect(0, 0, 7680, 4320), &[Avc420Region::full_frame(7680, 4320, 22)]);
+    let mut pdus = vec![
+        surface,
+        start(1),
+        avc420(&[Avc420Region::full_frame(16, 8, 22)], IDR_ACCESS_UNIT),
+    ];
+    pdus.extend(core::iter::repeat_n(picture, 5));
+    process_all(&mut client, &pdus);
+    let frames = client.take_h264_frames();
+    assert_eq!(frames.len(), 6);
+
+    // The first frame is not in yet: four whole 8K pictures may wait behind it, but not a fifth. (Zeroed buffers
+    // take no memory until written.)
+    let picture = || Some(vec![0u8; 7680 * 4320 * 4]);
+    for frame in &frames[1..5] {
+        assert!(client.complete_h264_frame(frame.id, picture()).is_ok());
+    }
+    assert!(client.complete_h264_frame(frames[5].id, picture()).is_err());
+}
+
+#[test]
+fn completions_for_frames_not_pending_are_ignored() {
+    let mut client = client();
+    let full = [Avc420Region::full_frame(16, 8, 22)];
+    process_all(&mut client, &[start(1), avc420(&full, IDR_ACCESS_UNIT), end(1)]);
+    let frame = client.take_h264_frames().remove(0);
+    // Not handed out (yet).
+    assert!(
+        client
+            .complete_h264_frame(frame.id + 1, None)
+            .expect("ignored")
+            .is_empty()
+    );
+    assert_eq!(client.pending_h264_frames(), 1);
+
+    let sent = client
+        .complete_h264_frame(frame.id, Some(solid(1, rect(0, 0, 16, 8))))
+        .expect("complete");
+    assert_eq!(acks(&sent), [(1, 0)]);
+    assert_eq!(client.pending_h264_frames(), 0);
+    // Applied already.
+    assert!(client.complete_h264_frame(frame.id, None).expect("ignored").is_empty());
+}
