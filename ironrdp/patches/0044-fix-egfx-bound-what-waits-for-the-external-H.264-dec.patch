+impl Queued {
+    /// What it holds while it waits, as counted against [`MAX_HELD_BYTES`]: a command's size on the wire, or a
+    /// frame's regions.
+    fn held_bytes(&self) -> usize {
+        match self {
+            Self::Pdu(pdu) => pdu.size(),
+            Self::H264 { regions, .. } => regions.len().saturating_mul(size_of::<ExclusiveRectangle>()),
+        }
+    }
+}
+
+/// The most commands that may wait for the external H.264 decoder, its frames among them.
+///
+/// Commands wait while a frame before them decodes, and so do the acknowledgements that pace the server. A frame
+/// holds a handful of commands, a full repaint from the bitmap cache one per 64x64 tile (2,040 for a 4K screen):
+/// 65,536 is dozens of those.
+const MAX_QUEUED_COMMANDS: usize = 65_536;
+
+/// The most bytes that may wait for the external H.264 decoder: the commands behind its frames (as sent), and the
+/// pixels of frames decoded ahead of their turn.
+///
+/// Twice what the compositor holds: four whole 8K pictures (7680x4320 RGBA, 127 MiB each) waiting behind a fifth.
+const MAX_HELD_BYTES: usize = 512 * 1024 * 1024;
+
 // ============================================================================
 // Handler Trait
 // ============================================================================
