+        self.held_bytes = self.held_bytes.saturating_sub(taken);
+        frames
     }
 
     /// Hands back a frame from [`Self::take_h264_frames`], and processes what waited for it.
@@ -630,25 +672,27 @@ impl GraphicsPipelineClient {
