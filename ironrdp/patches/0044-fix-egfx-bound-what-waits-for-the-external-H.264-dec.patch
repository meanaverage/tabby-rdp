+        }
+        self.held_bytes = self.held_bytes.saturating_add(bytes);
+        let responses = self.process_queue()?;
+        self.check_held()?;
+        Ok(responses)
     }
 
     /// Frames handed to the external decoder whose pixels have not been applied yet.
