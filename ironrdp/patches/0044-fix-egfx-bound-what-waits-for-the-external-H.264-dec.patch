+
+    /// Frame ids wrap around; the pending frames are those handed out last, whatever their ids.
+    #[test]
+    fn pending_h264_frames_are_told_apart_across_the_id_wrap() {
+        let wire = |pdu: GfxPdu| zgfx::wrap_uncompressed(&ironrdp_core::encode_vec(&pdu).unwrap());
+        let whole = ExclusiveRectangle {
+            left: 0,
+            top: 0,
+            right: 2,
+            bottom: 2,
+        };
+        let frame = GfxPdu::WireToSurface1(crate::pdu::WireToSurface1Pdu {
+            surface_id: 1,
+            codec_id: Codec1Type::Avc420,
+            pixel_format: PixelFormat::XRgb,
+            destination_rectangle: whole.clone(),
+            bitmap_data: crate::pdu::encode_avc420_bitmap_stream(
+                &[crate::pdu::Avc420Region::full_frame(2, 2, 22)],
+                &[0, 0, 0, 1, 0x65, 0x88],
+            ),
+        });
+        let mut client = GraphicsPipelineClient::new(Box::new(TestHandler), None).with_external_h264();
+        client.next_h264_id = u32::MAX;
+        for pdu in [
+            GfxPdu::CreateSurface(crate::pdu::CreateSurfacePdu {
+                surface_id: 1,
+                width: 2,
+                height: 2,
+                pixel_format: PixelFormat::XRgb,
+            }),
+            GfxPdu::StartFrame(crate::pdu::StartFramePdu {
+                timestamp: crate::pdu::Timestamp {
+                    milliseconds: 0,
+                    seconds: 0,
+                    minutes: 0,
+                    hours: 0,
+                },
+                frame_id: 1,
+            }),
+            frame.clone(),
+            frame,
+            GfxPdu::EndFrame(crate::pdu::EndFramePdu { frame_id: 1 }),
+        ] {
+            client.process(0, &wire(pdu)).unwrap();
+        }
+        let ids: Vec<u32> = client.take_h264_frames().iter().map(|frame| frame.id).collect();
+        assert_eq!(ids, [u32::MAX, 0]);
+        assert_eq!(client.pending_h264_frames(), 2);
+
+        // Not handed out yet.
+        assert!(client.complete_h264_frame(1, None).unwrap().is_empty());
+        let pixels = || Some(vec![0xff; rgba_len(&whole)]);
+        // The second frame waits for the first, and the acknowledgement for both.
+        assert!(client.complete_h264_frame(0, pixels()).unwrap().is_empty());
+        assert_eq!(client.complete_h264_frame(u32::MAX, pixels()).unwrap().len(), 1);
+        assert_eq!(client.pending_h264_frames(), 0);
+        assert_eq!(client.held_bytes, 0, "nothing waits");
+    }
 }
