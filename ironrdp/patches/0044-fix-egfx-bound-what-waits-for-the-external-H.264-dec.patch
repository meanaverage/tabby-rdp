+    fn check_held(&self) -> PduResult<()> {
+        if MAX_QUEUED_COMMANDS < self.queue.len() || MAX_HELD_BYTES < self.held_bytes {
+            warn!(
+                commands = self.queue.len(),
+                frames = self.pending_h264,
+                bytes = self.held_bytes,
