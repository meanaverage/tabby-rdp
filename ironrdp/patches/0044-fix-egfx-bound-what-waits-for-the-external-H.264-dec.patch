+        let age = self.next_h264_id.wrapping_sub(id);
+        if !usize::try_from(age).is_ok_and(|age| 0 < age && age <= self.pending_h264) {
             warn!(id, "Completion for an H.264 frame that is not pending");
             return Ok(Vec::new());
