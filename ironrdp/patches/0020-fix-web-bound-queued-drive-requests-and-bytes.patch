+        let (mut backend, _queue) = backend(QueueLimits {
+            requests: 1,
+            bytes: 1024,
+        });
+        assert!(backend.handle_drive_io_request(read(1)).unwrap().is_empty());
+
+        let create = ServerDriveIoRequest::ServerCreateDriveRequest(DeviceCreateRequest {
+            device_io_request: io_request(MajorFunction::Create, 2),
