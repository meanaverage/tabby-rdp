+    /// The one response's completion ID, status and length.
+    fn answer(responses: &[SvcMessage]) -> (u32, NtStatus, usize) {
+        let [response] = responses else {
+            panic!("one response, not {}", responses.len());
+        };
+        let bytes = response.encode_unframed_pdu().expect("response encodes");
+        // RDPDR header (4 bytes), then DR_DEVICE_IOCOMPLETION: DeviceId, CompletionId, IoStatus.
+        let field = |at: usize| u32::from_le_bytes(bytes[at..at + 4].try_into().expect("four bytes"));
+        (field(8), NtStatus::from(field(12)), bytes.len())
+    }
+
+    #[test]
+    fn requests_past_the_queue_limit_are_refused() {
+        let (mut backend, mut queue) = backend(QueueLimits {
+            requests: 2,
+            bytes: 1024 * 1024,
+        });
+
+        assert!(backend.handle_drive_io_request(read(1)).unwrap().is_empty());
+        assert!(backend.handle_drive_io_request(read(2)).unwrap().is_empty());
+        let refused = backend.handle_drive_io_request(read(3)).unwrap();
+        assert_eq!(answer(&refused), (3, NtStatus::INSUFFICIENT_RESOURCES, 20));
+
+        // Once the worker is done with one, another takes its place.
+        let served = queue.try_recv().expect("queued request");
+        assert_eq!(served.request, read(1));
+        drop(served);
+        assert!(backend.handle_drive_io_request(read(4)).unwrap().is_empty());
+        let refused = backend.handle_drive_io_request(read(5)).unwrap();
+        assert_eq!(answer(&refused).1, NtStatus::INSUFFICIENT_RESOURCES);
+    }
+
+    #[test]
+    fn requests_past_the_queue_bytes_are_refused() {
+        const WRITE_REQUEST: usize = 20 /* DR_DEVICE_IOREQUEST */ + 32 /* fields, padding */;
+        let (mut backend, mut queue) = backend(QueueLimits {
+            requests: 100,
+            bytes: 1000,
+        });
+
+        // The byte limit also applies when the queue is empty.
+        let refused = backend.handle_drive_io_request(write(1, 1001)).unwrap();
+        assert_eq!(answer(&refused), (1, NtStatus::INSUFFICIENT_RESOURCES, 21));
+        assert!(queue.try_recv().is_err());
+
+        assert!(backend.handle_drive_io_request(write(3, 500)).unwrap().is_empty());
+        assert!(
+            backend
+                .handle_drive_io_request(write(4, 1000 - 500 - 2 * WRITE_REQUEST))
+                .unwrap()
+                .is_empty()
+        );
+        assert_eq!(backend.usage.bytes.load(Ordering::Acquire), 1000);
+        let refused = backend.handle_drive_io_request(write(5, 0)).unwrap();
+        assert_eq!(answer(&refused).1, NtStatus::INSUFFICIENT_RESOURCES);
+        // Requests carrying no data still count.
+        let refused = backend.handle_drive_io_request(read(6)).unwrap();
+        assert_eq!(answer(&refused).1, NtStatus::INSUFFICIENT_RESOURCES);
+    }
+
+    #[test]
+    fn in_flight_requests_and_queue_drop_release_their_budget() {
+        let (mut backend, mut queue) = backend(QueueLimits {
+            requests: 1,
+            bytes: 1024,
+        });
+        assert!(backend.handle_drive_io_request(read(1)).unwrap().is_empty());
+        let in_flight = queue.try_recv().expect("queued request");
