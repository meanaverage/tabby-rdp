+/// How many requests may wait for the worker (queued, or being served), and how much they may hold in all.
+///
+/// The server doesn't wait for one request's response before sending the next, and nothing else bounds what waits:
+/// A request past either limit is answered at once with STATUS_INSUFFICIENT_RESOURCES instead of being queued,
+/// including a request that exceeds the byte limit while the queue is empty.
+#[derive(Debug, Clone, Copy)]
+struct QueueLimits {
+    requests: usize,
+    /// Bytes, counted as the requests' size on the wire: their data and paths, mostly.
+    bytes: usize,
+}
+
+impl QueueLimits {
+    /// A server sends one request per I/O its applications do, and even a copy on many threads has a few dozen
+    /// outstanding; servers read 64 KiB or so at a time, and write alike. 1,024 requests holding 64 MiB is a thousand
+    /// such writes.
+    const DEFAULT: Self = Self {
+        requests: 1024,
+        bytes: 64 * 1024 * 1024,
+    };
+}
+
+/// What the requests waiting for the worker hold: counted in by the backend, out by each request's [`QueuePlace`].
+#[derive(Debug, Default)]
+struct QueueUsage {
+    requests: AtomicUsize,
+    bytes: AtomicUsize,
+}
+
+/// A request's place in the queue, given up when the worker is done with it (or the queue is dropped).
+#[derive(Debug)]
+struct QueuePlace {
+    bytes: usize,
+    usage: Arc<QueueUsage>,
+}
+
+impl Drop for QueuePlace {
+    fn drop(&mut self) {
+        self.usage.requests.fetch_sub(1, Ordering::AcqRel);
+        self.usage.bytes.fetch_sub(self.bytes, Ordering::AcqRel);
+    }
+}
+
+/// A request on its way to the worker.
+#[derive(Debug)]
+struct Queued {
+    request: ServerDriveIoRequest,
+    _place: QueuePlace,
+}
+
 /// Drive redirection served by a JavaScript file system (see the module documentation): the SVC processor's side,
 /// which queues the server's requests for the [`DriveWorker`].
 #[derive(Debug)]
 pub(crate) struct WasmDriveBackend {
     drives: Vec<SharedDrive>,
-    requests: mpsc::UnboundedSender<ServerDriveIoRequest>,
+    requests: mpsc::UnboundedSender<Queued>,
+    limits: QueueLimits,
+    usage: Arc<QueueUsage>,
+    /// Requests are being refused, and that was logged.
+    refusing: bool,
 }
 
 impl_as_any!(WasmDriveBackend);
@@ -352,7 +409,35 @@ impl WasmDriveBackend {
             open: HashMap::new(),
         };
         spawn_local(worker.run(queue, events));
-        Self { drives, requests }
+        Self::with_queue(drives, requests, QueueLimits::DEFAULT)
+    }
+
+    /// The backend queuing requests for whoever takes them from `requests`, within `limits`.
+    fn with_queue(drives: Vec<SharedDrive>, requests: mpsc::UnboundedSender<Queued>, limits: QueueLimits) -> Self {
+        Self {
+            drives,
+            requests,
+            limits,
+            usage: Arc::new(QueueUsage::default()),
+            refusing: false,
+        }
+    }
+
+    /// A place in the queue for a request `bytes` long, if it has room for it (see [`QueueLimits`]).
+    fn place(&self, bytes: usize) -> Option<QueuePlace> {
+        // Only the backend counts requests in, so the room it sees can't be taken meanwhile.
+        let requests = self.usage.requests.load(Ordering::Acquire);
+        let queued_bytes = self.usage.bytes.load(Ordering::Acquire);
+        let new_bytes = queued_bytes.checked_add(bytes)?;
+        if !(requests < self.limits.requests && new_bytes <= self.limits.bytes) {
+            return None;
+        }
+        self.usage.requests.fetch_add(1, Ordering::AcqRel);
+        self.usage.bytes.fetch_add(bytes, Ordering::AcqRel);
+        Some(QueuePlace {
+            bytes,
+            usage: Arc::clone(&self.usage),
+        })
     }
 
