     use super::*;
 
+    fn io_request(major_function: MajorFunction, completion_id: u32) -> DeviceIoRequest {
+        DeviceIoRequest {
+            device_id: 1,
+            file_id: 1,
+            completion_id,
+            major_function,
+            minor_function: MinorFunction::from(0),
+        }
+    }
+
+    fn read(completion_id: u32) -> ServerDriveIoRequest {
+        ServerDriveIoRequest::DeviceReadRequest(DeviceReadRequest {
+            device_io_request: io_request(MajorFunction::Read, completion_id),
+            length: 64 * 1024,
+            offset: 0,
+        })
+    }
+
+    fn write(completion_id: u32, length: usize) -> ServerDriveIoRequest {
+        ServerDriveIoRequest::DeviceWriteRequest(DeviceWriteRequest {
+            device_io_request: io_request(MajorFunction::Write, completion_id),
+            offset: 0,
+            write_data: vec![0x55; length],
