 /// DRDYNVC Static Virtual Channel (the Remote Desktop Protocol: Dynamic Virtual Channel Extension)
@@ -157,7 +158,7 @@ pub struct DrdynvcClient {
     tunnel_channels: BTreeMap<DynamicChannelId, SoftSyncTunnelType>,
