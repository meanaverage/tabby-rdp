+            // sends on the tunnel.
             for channel_id in list.channel_ids() {
-                if self.dynamic_channels.get_by_channel_id(*channel_id).is_none() {
-                    selected_channels.clear();
-                    break;
+                if self.dynamic_channels.get_by_channel_id(*channel_id).is_some() {
