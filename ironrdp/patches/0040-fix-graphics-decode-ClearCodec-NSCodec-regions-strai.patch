+/// Reads a plane's bytes in order, decoding its run-length encoding as they are read, so that
+/// the plane is never held whole.
+struct PlaneReader<'a> {
+    field: &'static str,
+    plane: Plane<'a>,
+}
+
+enum Plane<'a> {
+    /// A plane stored raw: its bytes not yet read.
+    Raw(&'a [u8]),
+    /// A run-length encoded plane.
+    Rle {
+        /// The segments not yet read.
+        segments: &'a [u8],
+        /// The value of the run being read, and how many of its bytes are left.
+        run: (u8, usize),
+        /// Bytes of the plane that no segment has claimed yet: at first, all but its EndData.
+        unclaimed: usize,
+        /// The plane's last four bytes, stored raw after its segments: the ones not yet read.
+        end_data: &'a [u8],
+    },
+}
+
