+#[test]
+fn clearcodec_nscodec_planes_take_no_memory() {
+    // A 91-byte stream of an 8192x8192 NSCodec region: four planes of 64 MiB, each a single run
+    // and the four bytes of its EndData. Decoded into planes, then into an image of their own,
+    // the region took 512 MiB on top of the 256 MiB image.
+    let plane_len = 8192 * 8192;
+    let mut plane = vec![0x10, 0x10, 0xFF];
+    plane.extend_from_slice(&u32::try_from(plane_len - 4).unwrap().to_le_bytes());
+    plane.extend_from_slice(&[0x20, 0x20, 0x20, 0x20]);
+    let mut nscodec = Vec::new();
+    for _ in 0..4 {
+        nscodec.extend_from_slice(&u32::try_from(plane.len()).unwrap().to_le_bytes());
+    }
+    nscodec.extend_from_slice(&[1, 0, 0, 0]); // colorLossLevel, chromaSubsamplingLevel, reserved
+    for _ in 0..4 {
+        nscodec.extend_from_slice(&plane);
+    }
+    let mut subcodec_data = Vec::new();
+    for value in [0u16, 0, 8192, 8192] {
+        subcodec_data.extend_from_slice(&value.to_le_bytes()); // x, y, width, height
+    }
+    subcodec_data.extend_from_slice(&u32::try_from(nscodec.len()).unwrap().to_le_bytes());
+    subcodec_data.push(0x01); // NSCodec
+    subcodec_data.extend_from_slice(&nscodec);
+    let stream = clearcodec_stream(&[], &[], &subcodec_data);
+    assert_eq!(stream.len(), 91);
+    let mut decoder = ClearCodecDecoder::new();
+
+    let (pixels, peak) = peak_heap(|| decoder.decode(&stream, 8192, 8192));
+
+    // Y, Co and Cg of 0x10 make (R, G, B) = (0x10, 0x20, 0), and of 0x20 (0x20, 0x40, 0).
+    let pixels = pixels.unwrap();
+    assert_eq!(pixels[..4], [0x00, 0x20, 0x10, 0x10]);
+    assert_eq!(pixels[pixels.len() - 4..], [0x00, 0x40, 0x20, 0x20]);
+    assert!(
+        peak < 256 * 1024 * 1024 + 1024 * 1024,
+        "decoding the region took {peak} bytes"
+    );
+}
