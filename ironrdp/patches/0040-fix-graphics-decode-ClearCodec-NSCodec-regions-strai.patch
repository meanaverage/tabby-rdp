+/// Decodes the run at the start of `segments`, and moves past it.
+///
+/// A value repeated is followed by a length factor: the run length less two, or 0xFF and a
+/// 32-bit run length. Any other value is a run of one.
+fn decode_run(segments: &mut &[u8], field: &'static str) -> DecodeResult<(u8, usize)> {
+    let Some((&value, rest)) = segments.split_first() else {
+        return Err(invalid_field_err!(field, "RLE plane is missing a run"));
+    };
+
+    let (length, rest) = match rest {
+        [repeated, rest @ ..] if *repeated == value => match rest {
+            [] => return Err(invalid_field_err!(field, "RLE run is missing its length factor")),
+            [u8::MAX, rest @ ..] => {
+                let Some((length, rest)) = rest.split_first_chunk::<4>() else {
+                    return Err(invalid_field_err!(field, "long RLE run is missing its length factor"));
+                };
+                let length = usize::try_from(u32::from_le_bytes(*length))
+                    .map_err(|_| invalid_field_err!(field, "long RLE run length does not fit in usize"))?;
+                (length, rest)
+            }
+            [factor, rest @ ..] => (usize::from(*factor) + 2, rest),
+        },
+        _ => (1, rest),
+    };
 
-    Ok(decoded)
+    *segments = rest;
+    Ok((value, length))
