+        assert!(read_plane(&[0x33, 0x33, 0xFF, 0x10, 0x00, 1, 2, 3, 4], 20).is_err());
+    }
+
+    #[test]
+    fn decodes_into_a_region_of_a_larger_image() {
+        // A 2x2 region at (1, 1) of a 4x3 image.
+        let data = stream(&[10, 20, 30, 40], &[0; 4], &[0; 4], &[], 1, false);
+        let mut image = vec![0xEE; 4 * 3 * 4];
+
+        decode(&data, 2, 2, &mut image[(4 + 1) * 4..], 4 * 4).unwrap();
+
+        let mut expected = vec![0xEE; 4 * 3 * 4];
+        for (index, luma) in [(5, 10), (6, 20), (9, 30), (10, 40)] {
+            expected[index * 4..index * 4 + 4].copy_from_slice(&[luma, luma, luma, 0xFF]);
+        }
+        assert_eq!(image, expected);
+    }
+
+    #[test]
+    fn rejects_a_destination_too_small_for_the_image() {
+        let data = stream(&[10, 20, 30, 40], &[0; 4], &[0; 4], &[], 1, false);
+        let mut image = vec![0; 2 * 2 * 4 - 1];
+
+        assert!(decode(&data, 2, 2, &mut image, 2 * 4).is_err());
     }
