+        for (let id = 0; id < 32_768; id++) {
+            decoder.decode(afterRecreate(id), done);
+        }
+        expect(decoder.failed).toMatch(/^H\.264 decoders opened for surface 1 faster than/);
+        expect(FakeDecoder.instances.length).toBe(16);
