+    it('fails when the decoders of all surfaces together open faster than monitors are resized', () => {
+        const failures: string[] = [];
+        decoder.close();
+        decoder = new WebCodecsH264Decoder({ onFailure: (reason) => failures.push(reason), now: () => clock });
+        // A new surface id for each stream, as some servers give each new surface: 128 in a row, then 32 a second.
+        let id = 0;
+        for (; id < 128; id++) {
+            decoder.decode({ ...afterRecreate(id, id), endedSurfaces: id > 0 ? [id - 1] : [] }, done);
+        }
+        clock += 1000;
+        for (; id < 160; id++) {
+            decoder.decode({ ...afterRecreate(id, id), endedSurfaces: [id - 1] }, done);
+        }
+        expect(decoder.failed).toBeNull();
+
+        decoder.decode({ ...afterRecreate(160, 160), endedSurfaces: [159] }, done);
+        expect(failures).toEqual(['H.264 decoders opened faster than 128 in a row and 32 a second']);
+        expect(FakeDecoder.instances.length).toBe(160);
+    });
+
+    it('keeps the count of a surface while it matters, however many surfaces come and go', () => {
+        // Surface 1 opens all it may in a row; 64 other surfaces come and go; surface 1 still may not open another.
+        const failures: string[] = [];
+        decoder.close();
+        decoder = new WebCodecsH264Decoder({ onFailure: (reason) => failures.push(reason), now: () => clock });
+        let id = 0;
+        for (; id < 16; id++) {
+            decoder.decode(afterRecreate(id), done);
+        }
+        for (let surfaceId = 2; surfaceId < 66; surfaceId++, id++) {
+            decoder.decode({ ...afterRecreate(id, surfaceId), endedSurfaces: [surfaceId - 1] }, done);
+        }
+        expect(decoder.failed).toBeNull();
+        decoder.decode(afterRecreate(id), done);
+        expect(failures).toEqual(['H.264 decoders opened for surface 1 faster than 16 in a row and 4 a second']);
+    });
 });
 
