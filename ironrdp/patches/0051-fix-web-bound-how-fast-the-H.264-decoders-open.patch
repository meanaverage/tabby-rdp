+/** How often something may happen: `inARow` times in a row, and `perSecond` on average after that. */
+interface RateLimit {
+    inARow: number;
+    perSecond: number;
+}
+
+/**
+ * Counts what happens against a `RateLimit`: each time takes one of an allowance of `inARow`, which comes back at
+ * `perSecond`.
+ */
+class Rate {
+    private allowance: number;
+    private at: number;
+
+    constructor(
+        private readonly limit: RateLimit,
+        now: number,
+    ) {
+        this.allowance = limit.inARow;
+        this.at = now;
+    }
+
+    /** Counts one more time, unless the limit allows none now. */
+    take(now: number): boolean {
+        this.catchUp(now);
+        if (this.allowance < 1) {
+            return false;
+        }
+        this.allowance -= 1;
+        return true;
+    }
+
+    /** Whether all of the allowance is back, as if nothing had been counted. */
+    rested(now: number): boolean {
+        this.catchUp(now);
+        return this.allowance >= this.limit.inARow;
+    }
+
+    private catchUp(now: number): void {
+        // A clock that goes back gives nothing back.
+        if (now > this.at) {
+            const back = ((now - this.at) * this.limit.perSecond) / 1000;
+            this.allowance = Math.min(this.limit.inARow, this.allowance + back);
+            this.at = now;
+        }
+    }
+}
