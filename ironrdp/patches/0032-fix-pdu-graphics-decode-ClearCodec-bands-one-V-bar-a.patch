diff --git a/crates/ironrdp-testsuite-core/tests/peak_heap.rs b/crates/ironrdp-testsuite-core/tests/peak_heap.rs
new file mode 100644
index 00000000..6925a07b
--- /dev/null
+++ b/crates/ironrdp-testsuite-core/tests/peak_heap.rs
@@ -0,0 +1,113 @@
+#![allow(unused_crate_dependencies)] // false positives because there is both a library and a binary
+//! Peak heap tests: how much memory decoders take for the input a server sends them.
+//!
+//! They are a test binary of their own, not modules of `integration_tests_core`, because they
+//! replace the global allocator with one that counts the bytes each thread holds.
+
+use core::alloc::{GlobalAlloc, Layout};
+use core::cell::Cell;
+use std::alloc::System;
+
+use ironrdp_graphics::clearcodec::ClearCodecDecoder;
+
+/// The system allocator, counting the bytes each thread holds.
+struct CountingAllocator;
+
+#[global_allocator]
+static ALLOCATOR: CountingAllocator = CountingAllocator;
+
+thread_local! {
+    /// Bytes this thread allocated and has not freed, counted from an arbitrary origin.
+    static HELD: Cell<isize> = const { Cell::new(0) };
+    /// The most `HELD` has been since [`peak_heap`] reset it.
+    static PEAK: Cell<isize> = const { Cell::new(0) };
+}
+
+fn count_allocated(bytes: usize) {
+    // A layout's size never exceeds isize::MAX.
+    let held = HELD.get().saturating_add(isize::try_from(bytes).unwrap_or(isize::MAX));
+    HELD.set(held);
+    PEAK.set(PEAK.get().max(held));
+}
+
+fn count_freed(bytes: usize) {
+    HELD.set(HELD.get().saturating_sub(isize::try_from(bytes).unwrap_or(isize::MAX)));
+}
+
+// SAFETY: each method only counts its sizes, then hands its arguments to the system allocator,
+// whose blocks it returns: it meets GlobalAlloc's contract as the system allocator does.
+unsafe impl GlobalAlloc for CountingAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        count_allocated(layout.size());
+        // SAFETY: our caller meets alloc's contract.
+        unsafe { System.alloc(layout) }
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        count_allocated(layout.size());
+        // SAFETY: our caller meets alloc_zeroed's contract.
+        unsafe { System.alloc_zeroed(layout) }
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        count_freed(layout.size());
+        // SAFETY: our caller meets dealloc's contract, and ptr comes from System, through us.
+        unsafe { System.dealloc(ptr, layout) }
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        // A block that moves is held twice until it is copied: count the new one first.
+        count_allocated(new_size);
+        count_freed(layout.size());
+        // SAFETY: our caller meets realloc's contract, and ptr comes from System, through us.
+        unsafe { System.realloc(ptr, layout, new_size) }
+    }
+}
+
+/// Runs `f`, returning its result and the most bytes this thread held at once while it ran, on
+/// top of what it held before.
+fn peak_heap<T>(f: impl FnOnce() -> T) -> (T, usize) {
+    let start = HELD.get();
+    PEAK.set(start);
+    let result = f();
+    let peak = PEAK.get().saturating_sub(start);
+    (result, usize::try_from(peak).unwrap_or(0))
+}
+
+#[test]
+fn clearcodec_bands_past_the_destination_take_no_memory() {
+    // 256 bands of 65536 columns each, 32 MiB, over a 2x2 destination: columns 0 and 1 carry
+    // pixels, and every other column is a two-byte V-bar cache hit beyond the destination.
+    // Decoded whole, the layer took 512 MiB on 64-bit targets.
+    let mut bands_data = Vec::new();
+    for _ in 0..256 {
+        bands_data.extend_from_slice(&0u16.to_le_bytes()); // x_start
+        bands_data.extend_from_slice(&u16::MAX.to_le_bytes()); // x_end
+        bands_data.extend_from_slice(&0u16.to_le_bytes()); // y_start
+        bands_data.extend_from_slice(&1u16.to_le_bytes()); // y_end
+        bands_data.extend_from_slice(&[0x00, 0x00, 0x00]); // background BGR
+
+        // Short V-bar cache misses covering both rows: red in column 0, green in column 1.
+        for bgr in [[0x00, 0x00, 0xFF], [0x00, 0xFF, 0x00]] {
+            bands_data.extend_from_slice(&(2u16 << 8).to_le_bytes());
+            bands_data.extend_from_slice(&bgr);
+            bands_data.extend_from_slice(&bgr);
+        }
+        for _ in 2..=u16::MAX {
+            bands_data.extend_from_slice(&0x8000u16.to_le_bytes());
+        }
+    }
+    let mut stream = vec![0x00, 0x00]; // flags, seq
+    stream.extend_from_slice(&0u32.to_le_bytes()); // residualByteCount
+    stream.extend_from_slice(&u32::try_from(bands_data.len()).unwrap().to_le_bytes()); // bandsByteCount
+    stream.extend_from_slice(&0u32.to_le_bytes()); // subcodecByteCount
+    stream.extend_from_slice(&bands_data);
+    let mut decoder = ClearCodecDecoder::new();
+
+    let (pixels, peak) = peak_heap(|| decoder.decode(&stream, 2, 2));
+
+    let red = [0x00, 0x00, 0xFF, 0xFF];
+    let green = [0x00, 0xFF, 0x00, 0xFF];
+    assert_eq!(pixels.unwrap(), [red, green, red, green].concat());
+    assert!(peak < 1024 * 1024, "decoding the layer took {peak} bytes");
+}
