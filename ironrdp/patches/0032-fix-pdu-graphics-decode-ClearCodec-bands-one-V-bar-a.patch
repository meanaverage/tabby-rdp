@@ -122,6 +192,29 @@ fn decode_single_band<'a>(src: &mut ReadCursor<'a>) -> DecodeResult<Band<'a>> {
         blue_bkg,
         green_bkg,
         red_bkg,
+    })
+}
+
+fn decode_single_band<'a>(src: &mut ReadCursor<'a>) -> DecodeResult<Band<'a>> {
+    let header = decode_band_header(src)?;
+
+    // The vector grows with the V-bars actually read: a band header alone can claim 65536
+    // columns.
+    let mut vbars = Vec::new();
+
+    for _ in header.x_start..=header.x_end {
+        let vbar = decode_vbar(src, header.height())?;
+        vbars.push(vbar);
+    }
+
+    Ok(Band {
+        x_start: header.x_start,
+        x_end: header.x_end,
+        y_start: header.y_start,
+        y_end: header.y_end,
+        blue_bkg: header.blue_bkg,
+        green_bkg: header.green_bkg,
+        red_bkg: header.red_bkg,
         vbars,
     })
 }
@@ -249,4 +342,88 @@ mod tests {
         let bands = decode_bands_layer(&[]).unwrap();
         assert!(bands.is_empty());
     }
+
+    fn band_header(x_start: u16, x_end: u16, y_start: u16, y_end: u16, background: [u8; 3]) -> Vec<u8> {
+        let mut data = Vec::new();
+        data.extend_from_slice(&x_start.to_le_bytes());
+        data.extend_from_slice(&x_end.to_le_bytes());
+        data.extend_from_slice(&y_start.to_le_bytes());
+        data.extend_from_slice(&y_end.to_le_bytes());
+        data.extend_from_slice(&background);
+        data
+    }
+
+    #[test]
+    fn decode_bands_layer_vbars_yields_each_vbar_with_its_band_and_column() {
+        // Two full V-bar cache hits for columns 3 and 4.
+        let mut data = band_header(3, 4, 0, 1, [1, 2, 3]);
+        data.extend_from_slice(&(0x8000u16 | 7).to_le_bytes());
+        data.extend_from_slice(&(0x8000u16 | 8).to_le_bytes());
+        // A short V-bar cache hit for the last column there is.
+        data.extend_from_slice(&band_header(u16::MAX, u16::MAX, 10, 12, [4, 5, 6]));
+        data.extend_from_slice(&(0x4000u16 | 9).to_le_bytes());
+        data.push(1);
+        // Fewer bytes than a band header are left over.
+        data.extend_from_slice(&[0; 10]);
+
+        let vbars = decode_bands_layer_vbars(&data)
+            .map(|vbar| {
+                let (band, x, vbar) = vbar.unwrap();
+                let vbar = match vbar {
+                    VBar::CacheHit { index } => (index, None),
+                    VBar::ShortCacheHit { index, y_on } => (index, Some(y_on)),
+                    VBar::ShortCacheMiss(_) => panic!("expected a cache hit"),
+                };
+                (band.x_start, band.y_start, band.height(), band.red_bkg, x, vbar)
+            })
+            .collect::<Vec<_>>();
+
+        assert_eq!(
+            vbars,
+            [
+                (3, 0, 2, 3, 3, (7, None)),
+                (3, 0, 2, 3, 4, (8, None)),
+                (u16::MAX, 10, 3, 6, u16::MAX, (9, Some(1))),
+            ]
+        );
+
+        // The bands decode_bands_layer collects hold the same V-bars.
+        let bands = decode_bands_layer(&data).unwrap();
+        assert_eq!(
+            bands
+                .iter()
+                .map(|band| (band.x_start, band.vbars.len()))
+                .collect::<Vec<_>>(),
+            [(3, 2), (u16::MAX, 1)]
+        );
+    }
+
+    #[test]
+    fn decode_bands_layer_vbars_yields_vbars_until_a_band_fails_to_decode() {
+        let mut data = band_header(0, 1, 0, 0, [0, 0, 0]);
+        data.extend_from_slice(&0x8000u16.to_le_bytes());
+        data.extend_from_slice(&0x8001u16.to_le_bytes());
+        // yEnd < yStart.
+        data.extend_from_slice(&band_header(0, 0, 1, 0, [0, 0, 0]));
+        data.extend_from_slice(&0x8002u16.to_le_bytes());
+
+        let mut vbars = decode_bands_layer_vbars(&data);
+
+        assert!(matches!(vbars.next(), Some(Ok((_, 0, VBar::CacheHit { index: 0 })))));
+        assert!(matches!(vbars.next(), Some(Ok((_, 1, VBar::CacheHit { index: 1 })))));
+        assert!(matches!(vbars.next(), Some(Err(_))));
+        assert!(vbars.next().is_none());
+    }
+
+    #[test]
+    fn decode_bands_layer_vbars_fails_on_a_band_missing_its_vbars() {
+        // A header claiming 65536 columns, and no V-bar.
+        let data = band_header(0, u16::MAX, 0, 0, [0, 0, 0]);
+
+        let mut vbars = decode_bands_layer_vbars(&data);
+
+        assert!(matches!(vbars.next(), Some(Err(_))));
+        assert!(vbars.next().is_none());
+        decode_bands_layer(&data).unwrap_err();
+    }
 }
