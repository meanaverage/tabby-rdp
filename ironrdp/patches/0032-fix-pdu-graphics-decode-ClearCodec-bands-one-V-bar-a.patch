+/// The header of a band: the columns and rows it covers, and its background color.
+///
+/// One V-bar per column from `x_start` to `x_end` (inclusive) follows it on the wire.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct BandHeader {
+    pub x_start: u16,
+    pub x_end: u16,
+    pub y_start: u16,
+    pub y_end: u16,
+    /// Background color (BGR).
+    pub blue_bkg: u8,
+    pub green_bkg: u8,
+    pub red_bkg: u8,
+}
+
+impl BandHeader {
+    /// Number of rows the band covers: from 1 to [`MAX_BAND_HEIGHT`] for a decoded header.
+    pub fn height(&self) -> u16 {
+        self.y_end.saturating_sub(self.y_start).saturating_add(1)
+    }
+}
+
 /// Decode all bands from the bands layer data.
+///
+/// This holds every V-bar of the layer at once, each eight to sixteen times the two bytes it can
+/// take on the wire; [`decode_bands_layer_vbars`] reads them one at a time instead.
 pub fn decode_bands_layer<'a>(data: &'a [u8]) -> DecodeResult<Vec<Band<'a>>> {
     let mut bands = Vec::new();
     let mut src = ReadCursor::new(data);
@@ -79,7 +104,62 @@ pub fn decode_bands_layer<'a>(data: &'a [u8]) -> DecodeResult<Vec<Band<'a>>> {
     Ok(bands)
 }
 
-fn decode_single_band<'a>(src: &mut ReadCursor<'a>) -> DecodeResult<Band<'a>> {
+/// Decodes the bands layer one V-bar at a time.
+///
+/// The iterator yields each V-bar in wire order, with the header of its band and its column (from
+/// the band's `x_start` to its `x_end`), and ends after the first error. Unlike
+/// [`decode_bands_layer`], it holds one V-bar at a time, however many the layer has.
+pub fn decode_bands_layer_vbars(data: &[u8]) -> BandsLayerVBars<'_> {
+    BandsLayerVBars {
+        src: ReadCursor::new(data),
+        band: None,
+        done: false,
+    }
+}
+
+/// Iterator over the V-bars of a bands layer, returned by [`decode_bands_layer_vbars`].
+#[derive(Debug)]
+pub struct BandsLayerVBars<'a> {
+    src: ReadCursor<'a>,
+    /// The band being read, and the column of its next V-bar.
+    band: Option<(BandHeader, u16)>,
+    done: bool,
+}
+
+impl<'a> Iterator for BandsLayerVBars<'a> {
+    type Item = DecodeResult<(BandHeader, u16, VBar<'a>)>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        if self.done {
+            return None;
+        }
+
+        let next = self.decode_next().transpose();
+        self.done = !matches!(next, Some(Ok(_)));
+        next
+    }
+}
+
+impl<'a> BandsLayerVBars<'a> {
+    fn decode_next(&mut self) -> DecodeResult<Option<(BandHeader, u16, VBar<'a>)>> {
+        let (header, x) = match self.band {
+            Some(band) => band,
+            // Fewer bytes than a band header are left over, as with decode_bands_layer.
+            None if self.src.len() < Band::HEADER_SIZE => return Ok(None),
+            None => {
+                let header = decode_band_header(&mut self.src)?;
+                (header, header.x_start)
+            }
+        };
+
+        let vbar = decode_vbar(&mut self.src, header.height())?;
+        self.band = if x < header.x_end { Some((header, x + 1)) } else { None };
+
+        Ok(Some((header, x, vbar)))
+    }
+}
+
+fn decode_band_header(src: &mut ReadCursor<'_>) -> DecodeResult<BandHeader> {
     ensure_size!(ctx: Band::NAME, in: src, size: Band::HEADER_SIZE);
 
     let x_start = src.read_u16();
@@ -104,17 +184,7 @@ fn decode_single_band<'a>(src: &mut ReadCursor<'a>) -> DecodeResult<Band<'a>> {
         return Err(invalid_field_err!("xEnd", "xEnd < xStart", in: src));
     }
 
-    // `x_end - x_start` is at most u16::MAX (when x_end = u16::MAX and
-    // x_start = 0), so the `+ 1` would overflow u16. Cast to usize first.
-    let column_count = usize::from(x_end - x_start) + 1;
