+#[test]
+fn client_refuses_a_surface_larger_than_the_compositor_holds() {
+    // 16384 pixels an edge is as large as the compositor allocates.
+    let mut client = setup_active_client_with_surface(None, 1, 16384, 2);
+    assert!(client.get_surface(1).is_some());
+
+    for (width, height) in [(16385, 2), (2, 16385), (65535, 65535)] {
+        let create = GfxPdu::CreateSurface(CreateSurfacePdu {
+            surface_id: 2,
+            width,
+            height,
+            pixel_format: PixelFormat::XRgb,
+        });
+        client.process(0, &encode_for_process(&create)).expect("create");
+        assert!(client.get_surface(2).is_none(), "{width}x{height} is not tracked");
+    }
+
+    // Re-created too large, surface 1 is gone rather than left as it was.
+    let create = GfxPdu::CreateSurface(CreateSurfacePdu {
+        surface_id: 1,
+        width: 16385,
+        height: 2,
+        pixel_format: PixelFormat::XRgb,
+    });
+    client.process(0, &encode_for_process(&create)).expect("create");
+    assert!(client.get_surface(1).is_none());
+    let pdu = GfxPdu::WireToSurface1(WireToSurface1Pdu {
+        surface_id: 1,
+        codec_id: Codec1Type::Uncompressed,
+        pixel_format: PixelFormat::XRgb,
+        destination_rectangle: ExclusiveRectangle {
+            left: 0,
+            top: 0,
+            right: 2,
+            bottom: 2,
+        },
+        bitmap_data: vec![0u8; 2 * 2 * 4],
+    });
+    assert!(
+        client.process(0, &encode_for_process(&pdu)).is_err(),
+        "commands for it fail as for any unknown surface"
+    );
+}
