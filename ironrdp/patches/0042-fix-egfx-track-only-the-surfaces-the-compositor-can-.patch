+#[test]
+fn a_surface_too_large_for_the_compositor_takes_no_frames() {
+    let mut client = client();
+    // Surface 1 (16x8, mapped) re-created larger than the compositor holds: it is gone, not left as it was.
+    let huge = GfxPdu::CreateSurface(CreateSurfacePdu {
+        surface_id: 1,
+        width: 65535,
+        height: 65535,
+        pixel_format: PixelFormat::XRgb,
+    });
+    let fill = GfxPdu::SolidFill(SolidFillPdu {
+        surface_id: 1,
+        fill_pixel: Color {
+            b: 0,
+            g: 0,
+            r: 9,
+            xa: 0xff,
+        },
+        rectangles: vec![rect(0, 0, 16, 8)],
+    });
+    let sent = process_all(&mut client, &[huge, start(1), fill, end(1)]);
+    assert_eq!(acks(&sent), [(1, 0)]);
+    assert!(client.get_surface(1).is_none());
+    assert!(
+        client.drain_output().is_empty(),
+        "the surface it replaced is not drawn either"
+    );
+
+    // A frame for it is refused like one for any unknown surface, rather than decoded for nothing.
+    let pdu = avc420_to(1, rect(0, 0, 64, 64), &[Avc420Region::new(0, 0, 64, 64, 22, 100)]);
+    assert!(client.process(0, &wire(&start(2))).is_ok());
+    assert!(client.process(0, &wire(&pdu)).is_err());
+    assert!(client.take_h264_frames().is_empty());
+}
