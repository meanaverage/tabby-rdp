diff --git a/crates/ironrdp-egfx/src/compositor.rs b/crates/ironrdp-egfx/src/compositor.rs
index 00a02164..1368d730 100644
--- a/crates/ironrdp-egfx/src/compositor.rs
+++ b/crates/ironrdp-egfx/src/compositor.rs
@@ -351,23 +351,37 @@ impl Compositor {
         self.surfaces.contains_key(&id) && self.charge(len)
     }
 
+    /// Whether a surface of this size can be held at all: non-zero and within
+    /// [`MAX_SURFACE_DIM`] on both edges.
+    ///
+    /// The client refuses a `CreateSurface` that fails this, as
+    /// [`Self::create_surface`] does, so that both agree on which surfaces exist
+    /// and how large they are. A surface that passes can still be refused by the
+    /// byte budget.
+    pub(crate) fn holds_surface(width: u16, height: u16) -> bool {
+        0 < width && width <= MAX_SURFACE_DIM && 0 < height && height <= MAX_SURFACE_DIM
+    }
+
     /// Handle `CreateSurface`: allocate a zeroed RGBA8888 canvas.
     ///
-    /// Surfaces beyond [`MAX_SURFACE_DIM`] on either edge are skipped rather than
-    /// allocated; subsequent commands targeting them become no-ops (the metadata
-    /// tracked by the client is unaffected).
+    /// The new surface replaces any surface under its id. One that fails
+    /// [`Self::holds_surface`], or that the budget cannot cover, is refused rather
+    /// than allocated: the id then has no surface, and subsequent commands
+    /// targeting it become no-ops.
     pub(crate) fn create_surface(&mut self, id: u16, width: u16, height: u16) {
-        if width == 0 || height == 0 || width > MAX_SURFACE_DIM || height > MAX_SURFACE_DIM {
-            return;
-        }
-        let len = usize::from(width) * usize::from(height) * BYTES_PER_PIXEL;
-
-        // Release first: `BTreeMap::insert` drops any surface already under this id,
-        // so re-creating one must not charge twice for the same slot.
+        // Release first, whether the new surface is refused or not: `BTreeMap::insert`
+        // drops any surface already under this id, so re-creating one must not charge
+        // twice for the same slot, and a refused one must not leave the surface it
+        // replaces in place (still mapped, and still drawn by commands for the id).
         if let Some(previous) = self.surfaces.remove(&id) {
             self.release(previous.data.len());
         }
 
+        if !Self::holds_surface(width, height) {
+            return;
+        }
+        let len = usize::from(width) * usize::from(height) * BYTES_PER_PIXEL;
+
         if !self.charge(len) {
             return;
         }
@@ -1612,6 +1626,40 @@ mod tests {
         assert_eq!(c.surfaces.len(), 1);
     }
 
+    /// A surface re-created too large to hold leaves no surface under its id, rather
+    /// than the one it replaced: that one would stay mapped and take the commands
+    /// meant for the new one.
+    #[test]
+    fn recreating_a_surface_too_large_to_hold_drops_the_one_it_replaces() {
+        assert!(Compositor::holds_surface(MAX_SURFACE_DIM, MAX_SURFACE_DIM));
+        assert!(!Compositor::holds_surface(MAX_SURFACE_DIM + 1, 1));
+        assert!(!Compositor::holds_surface(1, MAX_SURFACE_DIM + 1));
+
+        let mut c = Compositor::default();
+        c.reset(64, 64);
+        c.create_surface(1, 16, 16);
+        c.map_surface(1, 0, 0);
+        c.end_frame();
+        let _ = c.drain_output();
+
+        c.create_surface(1, MAX_SURFACE_DIM + 1, 16);
+        assert!(c.surfaces.is_empty());
+        assert_eq!(c.allocated_bytes, 0, "the replaced surface's charge is released");
+
+        let red = Color {
+            b: 0,
+            g: 0,
+            r: 0xff,
+            xa: 0xff,
+        };
+        c.solid_fill(1, &red, &[rect(0, 0, 16, 16)]);
+        c.end_frame();
+        assert!(
+            c.drain_output().is_empty(),
+            "nothing is drawn for a surface that does not exist"
+        );
+    }
+
     /// `ResetGraphics` empties the surface map, so its charge goes with it; the cache
     /// survives the reset and so does its charge.
     #[test]
