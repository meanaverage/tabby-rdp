From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: meanaverage <18336095+meanaverage@users.noreply.github.com>
Date: Tue, 17 Nov 2026 11:14:10 -0800
Subject: [PATCH] fix(egfx): report unavailable frame-ack queue depth

Frame acknowledgements carry the number of unprocessed graphics bytes.
Counting frames delayed for WebCodecs gives the field the wrong units.
Keep acknowledgements ordered and report unavailable, as upstream does.
---
 crates/ironrdp-egfx/src/client.rs             | 27 +++----------------
 .../tests/egfx/external_h264.rs               |  6 ++---
 2 files changed, 7 insertions(+), 26 deletions(-)

diff --git a/crates/ironrdp-egfx/src/client.rs b/crates/ironrdp-egfx/src/client.rs
index 9f987d3e..ee5f44a9 100644
--- a/crates/ironrdp-egfx/src/client.rs
+++ b/crates/ironrdp-egfx/src/client.rs
@@ -507,7 +507,6 @@ pub struct GraphicsPipelineClient {
     surfaces: BTreeMap<u16, Surface>,
     compositor: Compositor,
     current_frame_id: Option<u32>,
-    frames_queued: u32,
     total_frames_decoded: u32,
     pending_output_reset: Option<(u16, u16)>,
 
@@ -526,8 +525,6 @@ pub struct GraphicsPipelineClient {
     /// What waits for the external decoder, in bytes: the commands and frames in `queue`, the pixels in
     /// `h264_results` and the access units in `h264_frames`.
     held_bytes: usize,
-    /// `EndFrame`s in `queue`: frames received but not yet processed.
-    queued_frame_ends: u32,
     /// Surface sizes as of the commands received so far, which can be ahead of `surfaces` while commands wait in
     /// `queue`: a frame is handed out when it arrives, and its regions are bounded by its surface then. Like
     /// `surfaces`, it leaves out surfaces too large for the compositor.
@@ -560,7 +557,6 @@ impl GraphicsPipelineClient {
             surfaces: BTreeMap::new(),
             compositor: Compositor::default(),
             current_frame_id: None,
-            frames_queued: 0,
             total_frames_decoded: 0,
             pending_output_reset: None,
             external_h264: false,
@@ -570,7 +566,6 @@ impl GraphicsPipelineClient {
             queue: VecDeque::new(),
             pending_h264: 0,
             held_bytes: 0,
-            queued_frame_ends: 0,
             received_surfaces: BTreeMap::new(),
             h264_surfaces: BTreeSet::new(),
             ended_h264_surfaces: Vec::new(),
@@ -754,9 +749,6 @@ impl GraphicsPipelineClient {
             }
             other => other,
         };
-        if matches!(pdu, GfxPdu::EndFrame(_)) {
-            self.queued_frame_ends = self.queued_frame_ends.saturating_add(1);
-        }
         let queued = Queued::Pdu(pdu);
         self.held_bytes = self.held_bytes.saturating_add(queued.held_bytes());
         self.queue.push_back(queued);
@@ -795,12 +787,7 @@ impl GraphicsPipelineClient {
             };
             self.held_bytes = self.held_bytes.saturating_sub(queued.held_bytes());
             match queued {
-                Queued::Pdu(pdu) => {
-                    if matches!(pdu, GfxPdu::EndFrame(_)) {
-                        self.queued_frame_ends = self.queued_frame_ends.saturating_sub(1);
-                    }
-                    responses.extend(self.handle_pdu(pdu)?);
-                }
+                Queued::Pdu(pdu) => responses.extend(self.handle_pdu(pdu)?),
                 Queued::H264 {
                     id,
                     surface_id,
@@ -985,7 +972,6 @@ impl GraphicsPipelineClient {
             }
             GfxPdu::StartFrame(start) => {
                 self.current_frame_id = Some(start.frame_id);
-                self.frames_queued = self.frames_queued.saturating_add(1);
                 self.progressive_decoder.begin_frame();
                 trace!(frame_id = start.frame_id, "StartFrame");
                 Ok(vec![])
@@ -1155,7 +1141,6 @@ impl GraphicsPipelineClient {
         // per spec, capabilities are negotiated via CapabilitiesConfirm before
         // ResetGraphics, and a ResetGraphics does not re-negotiate capabilities.
         self.current_frame_id = None;
-        self.frames_queued = 0;
 
         // Reset decoder state for new stream
         if let Some(ref mut decoder) = self.h264_decoder {
@@ -1583,7 +1568,6 @@ impl GraphicsPipelineClient {
     fn handle_end_frame(&mut self, frame_id: u32) -> PduResult<Vec<DvcMessage>> {
         self.total_frames_decoded = self.total_frames_decoded.wrapping_add(1);
         self.current_frame_id = None;
-        self.frames_queued = self.frames_queued.saturating_sub(1);
 
         self.progressive_decoder.end_frame();
 
@@ -1593,11 +1577,10 @@ impl GraphicsPipelineClient {
         self.handler.on_frame_complete(frame_id);
 
         // Per [3.3.5.12]: client MUST send FrameAcknowledge after EndFrame.
-        // We send the actual queue depth (not Unavailable / 0xFFFFFFFF as FreeRDP does);
-        // the real value gives the server backpressure information for frame pacing.
-        // Frames still waiting behind an H.264 frame being decoded outside count as queued too.
+        // The queue depth is measured in bytes of unprocessed graphics messages.
+        // We track decoder memory and frame completion, but do not measure those wire bytes.
         let ack = GfxPdu::FrameAcknowledge(FrameAcknowledgePdu {
-            queue_depth: QueueDepth::from_u32(self.frames_queued.saturating_add(self.queued_frame_ends)),
+            queue_depth: QueueDepth::Unavailable,
             frame_id,
             total_frames_decoded: self.total_frames_decoded,
         });
@@ -2257,7 +2240,6 @@ mod tests {
             frame_id: 42,
         }));
         assert!(client.current_frame_id.is_some());
-        assert_eq!(client.frames_queued, 1);
 
         let _ = client.handle_pdu(GfxPdu::ResetGraphics(crate::pdu::ResetGraphicsPdu {
             width: 1920,
@@ -2267,7 +2249,6 @@ mod tests {
 
         assert!(client.surfaces.is_empty(), "surfaces should be cleared");
         assert!(client.current_frame_id.is_none(), "frame_id should be reset");
-        assert_eq!(client.frames_queued, 0, "frame queue should be reset");
     }
 
     #[test]
diff --git a/crates/ironrdp-testsuite-core/tests/egfx/external_h264.rs b/crates/ironrdp-testsuite-core/tests/egfx/external_h264.rs
index 02b79eae..cf73fabc 100644
--- a/crates/ironrdp-testsuite-core/tests/egfx/external_h264.rs
+++ b/crates/ironrdp-testsuite-core/tests/egfx/external_h264.rs
@@ -291,7 +291,7 @@ fn frames_complete_in_order_whatever_order_the_decoder_finishes_in() {
         .complete_h264_frame(frames[0].id, Some(solid(1, rect(0, 0, 16, 8))))
         .expect("complete first");
     // Frame 1 is acknowledged while frame 2 still waits in the queue.
-    assert_eq!(acks(&sent), [(1, 1), (2, 0)]);
+    assert_eq!(acks(&sent), [(1, 0), (2, 0)]);
     let output = client.drain_output();
     assert_eq!(output.last().expect("output").data, solid(2, rect(0, 0, 16, 8)));
 }
@@ -405,8 +405,8 @@ fn avc444_main_views_are_shown_and_auxiliary_views_only_decoded() {
             &client.complete_h264_frame(frame.id, Some(pixels)).expect("complete"),
         ));
     }
-    // Each acknowledgement counts the frames still waiting behind it.
-    assert_eq!(acknowledged, [(1, 2), (2, 1), (3, 0)]);
+    // Queue depth stays unavailable while other frames await acknowledgement.
+    assert_eq!(acknowledged, [(1, 0), (2, 0), (3, 0)]);
     // The last picture shown is the second main view; the auxiliary views leave the surface alone.
     let output = client.drain_output();
     let last = output.last().expect("output");
-- 
