     });
 
+    it('reads regions that are close together as one box', async () => {
+        decoder.decode(
+            frame(0, true, [
+                { left: 0, top: 0, right: 4, bottom: 2 },
+                { left: 4, top: 0, right: 6, bottom: 2 },
+                { left: 0, top: 2, right: 6, bottom: 3 },
+            ]),
+            done,
+        );
+        const picture = FakeDecoder.instances[0].emit(0);
+        await flush();
+        expect(picture.copied).toEqual([{ x: 0, y: 0, width: 6, height: 3 }]);
+        const pixels = done.mock.calls[0][1] as Uint8Array;
+        expect(pixels.length).toBe(18 * 4);
+        // The second region's first pixel, then the third's.
+        expect(Array.from(pixels.subarray(8 * 4, 9 * 4))).toEqual([4, 0, 0, 255]);
+        expect(Array.from(pixels.subarray(12 * 4, 13 * 4))).toEqual([0, 2, 0, 255]);
+    });
+
+    it('reads regions that are far apart one by one, not the picture between them', async () => {
+        decoder.decode(
+            frame(0, true, [
+                { left: 0, top: 0, right: 1, bottom: 1 },
+                { left: 3839, top: 2159, right: 3840, bottom: 2160 },
+            ]),
+            done,
+        );
+        const picture = FakeDecoder.instances[0].emit(0, 3840, 2160);
+        await flush();
+        // Two pixels read, not the 4K picture's 33 MB for their bounding box.
+        expect(picture.copied).toEqual([
+            { x: 0, y: 0, width: 1, height: 1 },
+            { x: 3839, y: 2159, width: 1, height: 1 },
+        ]);
+        expect(Array.from(done.mock.calls[0][1] as Uint8Array)).toEqual([0, 0, 0, 255, 3839 & 255, 2159 & 255, 0, 255]);
+    });
+
