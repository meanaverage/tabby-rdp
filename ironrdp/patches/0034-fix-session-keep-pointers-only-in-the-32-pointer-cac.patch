From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: meanaverage <18336095+meanaverage@users.noreply.github.com>
Date: Sun, 4 Oct 2026 13:13:04 -0700
Subject: [PATCH] fix(session): keep pointers only in the 32 pointer cache
 slots

The pointer cache was a map keyed by the server's cacheIndex, a 16-bit
value, with no bound: every Color, New and Large Pointer Update stored
its decoded bitmap, and only a failed decode removed one. The client
advertises 32 slots in its Pointer Capability Set (MS-RDPBCGR
2.2.7.1.5), and a server may only use indices below that, but nothing
stopped one from sending pointers at new indices: 65536 of them, each
up to 576 KiB decoded now that pointers are capped at 384x384, and up to
hundreds of megabytes each before that.

PointerCache now has POINTER_CACHE_SIZE (32) slots, the number
ironrdp-connector advertises, and insert gives the pointer back for an
index past them. The session still shows such a pointer but does not
cache it, and logs a warning. The cache holds at most 32 pointers,
18 MiB.
---
 crates/ironrdp-session/src/fast_path.rs | 71 +++++++++++++++++++++----
 crates/ironrdp-session/src/pointer.rs   | 35 +++++++++---
 2 files changed, 87 insertions(+), 19 deletions(-)

diff --git a/crates/ironrdp-session/src/fast_path.rs b/crates/ironrdp-session/src/fast_path.rs
index 5f6ebf97..cf2ad304 100644
--- a/crates/ironrdp-session/src/fast_path.rs
+++ b/crates/ironrdp-session/src/fast_path.rs
@@ -594,9 +594,7 @@ impl Processor {
                     }
                 };
 
-                let _ = self
-                    .pointer_cache
-                    .insert(usize::from(cache_index), Arc::clone(&decoded_pointer));
+                self.cache_pointer(cache_index, &decoded_pointer);
 
                 if !self.pointer_software_rendering {
                     processor_updates.push(UpdateKind::PointerBitmap(Arc::clone(&decoded_pointer)));
@@ -641,9 +639,7 @@ impl Processor {
                     }
                 };
 
-                let _ = self
-                    .pointer_cache
-                    .insert(usize::from(cache_index), Arc::clone(&decoded_pointer));
+                self.cache_pointer(cache_index, &decoded_pointer);
 
                 if !self.pointer_software_rendering {
                     processor_updates.push(UpdateKind::PointerBitmap(Arc::clone(&decoded_pointer)));
@@ -666,9 +662,7 @@ impl Processor {
                     }
                 };
 
-                let _ = self
-                    .pointer_cache
-                    .insert(usize::from(cache_index), Arc::clone(&decoded_pointer));
+                self.cache_pointer(cache_index, &decoded_pointer);
 
                 if !self.pointer_software_rendering {
                     processor_updates.push(UpdateKind::PointerBitmap(Arc::clone(&decoded_pointer)));
@@ -693,6 +687,20 @@ impl Processor {
         Ok(processor_updates)
     }
 
+    fn cache_pointer(&mut self, cache_index: u16, pointer: &Arc<DecodedPointer>) {
+        if self
+            .pointer_cache
+            .insert(usize::from(cache_index), Arc::clone(pointer))
+            .is_err()
+        {
+            // The pointer is still shown: it just can't be recalled by a Cached Pointer Update.
+            warn!(
+                cache_index,
+                "Not caching a pointer whose cache index is past the pointer cache"
+            );
+        }
+    }
+
     fn fallback_after_pointer_decode_failure(
         &mut self,
         image: &mut DecodedImage,
@@ -1362,7 +1370,8 @@ mod tests {
         .build();
         processor
             .pointer_cache
-            .insert(0, Arc::new(DecodedPointer::new_invisible()));
+            .insert(0, Arc::new(DecodedPointer::new_invisible()))
+            .expect("slot 0 is in the cache");
         let mut image = DecodedImage::new(PixelFormat::RgbA32, 4, 3);
         let pointer = PointerAttribute {
             xor_bpp: 2,
@@ -1395,7 +1404,8 @@ mod tests {
         .build();
         processor
             .pointer_cache
-            .insert(0, Arc::new(DecodedPointer::new_invisible()));
+            .insert(0, Arc::new(DecodedPointer::new_invisible()))
+            .expect("slot 0 is in the cache");
         let mut image = DecodedImage::new(PixelFormat::RgbA32, 4, 3);
         let pointer = ColorPointerAttribute {
             cache_index: 0,
@@ -1413,6 +1423,45 @@ mod tests {
         assert!(matches!(updates.as_slice(), [UpdateKind::PointerDefault]));
         assert!(!processor.pointer_cache.is_cached(0));
     }
+
+    #[test]
+    fn pointer_past_the_pointer_cache_is_shown_but_not_cached() {
+        let mut processor = ProcessorBuilder {
+            io_channel_id: 0,
+            user_channel_id: 0,
+            share_id: 0,
+            enable_server_pointer: true,
+            pointer_software_rendering: false,
+        }
+        .build();
+        let mut image = DecodedImage::new(PixelFormat::RgbA32, 4, 3);
+
+        for cache_index in [0, 31, 32, u16::MAX] {
+            // One 24 bpp pixel: a 4-byte XOR scanline and a 2-byte AND scanline.
+            let pointer = ColorPointerAttribute {
+                cache_index,
+                hot_spot: Point16 { x: 0, y: 0 },
+                width: 1,
+                height: 1,
+                xor_mask: &[0, 0, 0, 0],
+                and_mask: &[0, 0],
+            };
+
+            let updates = processor
+                .process_pointer_update(&mut image, PointerUpdateData::Color(pointer))
+                .expect("a pointer past the cache must not fail the session");
+
+            assert!(
+                matches!(updates.as_slice(), [UpdateKind::PointerBitmap(_)]),
+                "cache index {cache_index}"
+            );
+        }
+
+        let cached = (0..=u16::MAX)
+            .filter(|&cache_index| processor.pointer_cache.is_cached(usize::from(cache_index)))
+            .collect::<Vec<_>>();
+        assert_eq!(cached, [0, 31]);
+    }
 }
