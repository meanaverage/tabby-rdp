diff --git a/crates/ironrdp-session/src/pointer.rs b/crates/ironrdp-session/src/pointer.rs
index ce9e90e1..7484b1ce 100644
--- a/crates/ironrdp-session/src/pointer.rs
+++ b/crates/ironrdp-session/src/pointer.rs
@@ -1,28 +1,47 @@
-use std::collections::HashMap;
 use std::sync::Arc;
 
 use ironrdp_graphics::pointer::DecodedPointer;
 
+/// Number of slots in the pointer cache.
+///
+/// A server stores a pointer at a `cacheIndex` below the cache size the client advertises in its
+/// Pointer Capability Set ([MS-RDPBCGR] 2.2.7.1.5). ironrdp-connector advertises 32 slots for the
+/// color pointer cache and 32 for the pointer cache, which this cache holds together.
+///
+/// [MS-RDPBCGR]: https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-rdpbcgr/
+pub const POINTER_CACHE_SIZE: usize = 32;
+
 #[derive(Debug, Clone, Default)]
 pub struct PointerCache {
-    // TODO(@pacancoder) maybe use Vec<Optional<...>> instead?
-    cache: HashMap<usize, Arc<DecodedPointer>>,
+    cache: [Option<Arc<DecodedPointer>>; POINTER_CACHE_SIZE],
 }
 
 impl PointerCache {
-    pub fn insert(&mut self, id: usize, pointer: Arc<DecodedPointer>) -> Option<Arc<DecodedPointer>> {
-        self.cache.insert(id, pointer)
+    /// Stores `pointer` in slot `id`, returning the pointer the slot held.
+    ///
+    /// # Errors
+    ///
+    /// Gives `pointer` back when `id` is not a slot, that is not below [`POINTER_CACHE_SIZE`].
+    pub fn insert(
+        &mut self,
+        id: usize,
+        pointer: Arc<DecodedPointer>,
+    ) -> Result<Option<Arc<DecodedPointer>>, Arc<DecodedPointer>> {
+        match self.cache.get_mut(id) {
+            Some(slot) => Ok(slot.replace(pointer)),
+            None => Err(pointer),
+        }
     }
 
     pub fn get(&self, id: usize) -> Option<Arc<DecodedPointer>> {
-        self.cache.get(&id).cloned()
+        self.cache.get(id).cloned().flatten()
     }
 
     pub fn remove(&mut self, id: usize) -> Option<Arc<DecodedPointer>> {
-        self.cache.remove(&id)
+        self.cache.get_mut(id).and_then(Option::take)
     }
 
     pub fn is_cached(&self, id: usize) -> bool {
-        self.cache.contains_key(&id)
+        self.cache.get(id).is_some_and(Option::is_some)
     }
 }
