@@ -107,3 +177,21 @@ fn rectangle(rect: &ExclusiveRectangle) -> JsValue {
     }
     object.into()
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pixel_queue_budget_rejects_overflow_and_releases_consumed_events() {
+        let budget = PixelBudget::default();
+        let first = budget.reserve(MAX_QUEUED_PIXEL_BYTES - 4).unwrap();
+        let last = budget.reserve(4).unwrap();
+        assert!(budget.reserve(1).is_none());
+        assert!(budget.reserve(usize::MAX).is_none());
+        drop(first);
+        assert!(budget.reserve(MAX_QUEUED_PIXEL_BYTES - 4).is_some());
+        drop(last);
+        assert_eq!(budget.0.load(Ordering::Relaxed), 0);
+    }
+}
