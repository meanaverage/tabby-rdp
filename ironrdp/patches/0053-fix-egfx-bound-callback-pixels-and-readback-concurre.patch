 use crate::session::RdpInputEvent;
 
+const MAX_QUEUED_PIXEL_BYTES: usize = 256 * 1024 * 1024;
+
+/// Pixel copies waiting in the event queue are charged until the event is consumed or dropped.
+#[derive(Clone, Debug, Default)]
+struct PixelBudget(Arc<AtomicUsize>);
+
+impl PixelBudget {
+    fn reserve(&self, bytes: usize) -> Option<PixelReservation> {
+        self.0
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |used| {
+                used.checked_add(bytes).filter(|&total| total <= MAX_QUEUED_PIXEL_BYTES)
+            })
+            .ok()?;
+        Some(PixelReservation {
+            budget: self.clone(),
+            bytes,
+        })
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct PixelReservation {
+    budget: PixelBudget,
+    bytes: usize,
+}
+
+impl Drop for PixelReservation {
+    fn drop(&mut self) {
+        self.budget.0.fetch_sub(self.bytes, Ordering::Relaxed);
+    }
+}
