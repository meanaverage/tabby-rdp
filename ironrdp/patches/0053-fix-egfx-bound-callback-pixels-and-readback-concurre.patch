+#[test]
+fn ended_streams_are_available_without_a_later_h264_frame() {
+    for end in [
+        GfxPdu::DeleteSurface(DeleteSurfacePdu { surface_id: 1 }),
+        GfxPdu::ResetGraphics(ResetGraphicsPdu {
+            width: 16,
+            height: 8,
+            monitors: vec![],
+        }),
+    ] {
+        let mut client = client();
+        process_all(
+            &mut client,
+            &[
+                avc420_to(1, rect(0, 0, 16, 8), &[Avc420Region::full_frame(16, 8, 22)]),
+                end,
+            ],
+        );
+        assert_eq!(client.take_h264_frames().len(), 1);
+        assert_eq!(client.take_ended_h264_surfaces(), [1]);
+        assert!(client.take_ended_h264_surfaces().is_empty());
+    }
+}
