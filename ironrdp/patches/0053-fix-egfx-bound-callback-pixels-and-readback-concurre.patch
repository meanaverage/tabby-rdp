+
+    pub(crate) fn end_surfaces(&self, surfaces: Vec<u16>) -> anyhow::Result<()> {
+        if surfaces.is_empty() {
+            return Ok(());
+        }
+        let end = js_sys::Reflect::get(&self.decoder, &JsValue::from_str("endSurfaces"))
+            .ok()
+            .and_then(|end| end.dyn_into::<js_sys::Function>().ok());
+        if let Some(end) = end {
+            let surfaces = surfaces.into_iter().map(JsValue::from).collect::<js_sys::Array>();
+            end.call1(&self.decoder, &surfaces)
+                .map_err(|error| anyhow::anyhow!("ending H.264 streams: {error:?}"))?;
+        }
+        Ok(())
+    }
 }
 
