+#[test]
+fn clearcodec_image_is_held_once() {
+    // A 41-byte command: a ClearCodec stream without layers (flags, seq and three zero layer sizes)
+    // for an 8192x8192 destination, the largest the decoder takes, on a 1x1 surface. The image
+    // takes 256 MiB, and its RGBA copy took 256 MiB more.
+    let mut client = graphics_pipeline_client(1, 1);
+    let command = wire_to_surface1(Codec1Type::ClearCodec, 8192, 8192, clearcodec_stream(&[], &[], &[]));
+    assert_eq!(command.len(), 41);
+    // The first ClearCodec command also allocates the decoder's caches, about 1.4 MiB.
+    let first = wire_to_surface1(Codec1Type::ClearCodec, 1, 1, clearcodec_stream(&[], &[], &[]));
+    client.process(0, &first).expect("the first command decodes");
+
+    let (result, peak) = peak_heap(|| client.process(0, &command));
+
+    result.expect("the command decodes");
+    assert!(peak < 257 * 1024 * 1024, "decoding the command took {peak} bytes");
+}
+
+#[test]
+fn clearcodec_and_planar_commands_fail_without_memory_for_their_images() {
+    // The command above, and a 4.3 MB Planar command of an 8192x8192 image, which takes 192 MiB
+    // of planes, 192 MiB of RGB24 and 256 MiB of RGBA, in turn. Each limit leaves too little for
+    // one of those buffers, after the ones before it.
+    let clearcodec = wire_to_surface1(Codec1Type::ClearCodec, 8192, 8192, clearcodec_stream(&[], &[], &[]));
+    let planar = wire_to_surface1(Codec1Type::Planar, 8192, 8192, planar_zero_rle_stream(8192, 8192));
+    let mib = 1024 * 1024;
+
+    for (command, limit) in [
+        (&clearcodec, 128 * mib),
+        (&planar, 128 * mib),
+        (&planar, 320 * mib),
+        (&planar, 420 * mib),
+    ] {
+        let mut client = graphics_pipeline_client(1, 1);
+
+        let result = with_heap_limit(limit, || client.process(0, command));
+
+        // The allocation fails rather than aborting, and the update it was for is dropped: an
+        // undecodable surface update doesn't end the session.
+        assert!(result.is_ok(), "{:?}", result.as_ref().err());
+        assert_eq!(client.dropped_updates(), 1, "the command decoded in {limit} bytes");
+    }
+}
