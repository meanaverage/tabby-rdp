 /// The system allocator, counting the bytes each thread holds.
 struct CountingAllocator;
@@ -27,30 +37,45 @@ thread_local! {
     static HELD: Cell<isize> = const { Cell::new(0) };
     /// The most `HELD` has been since [`peak_heap`] reset it.
     static PEAK: Cell<isize> = const { Cell::new(0) };
+    /// The most `HELD` may be: an allocation that would take it further fails, as when memory
+    /// runs out. [`with_heap_limit`] sets it.
+    static LIMIT: Cell<isize> = const { Cell::new(isize::MAX) };
 }
 
-fn count_allocated(bytes: usize) {
+/// Counts an allocation of `bytes`, and returns true, unless it would take this thread past its
+/// limit: then the allocation must fail.
+fn count_allocated(bytes: usize) -> bool {
     // A layout's size never exceeds isize::MAX.
     let held = HELD.get().saturating_add(isize::try_from(bytes).unwrap_or(isize::MAX));
+    if held > LIMIT.get() {
+        return false;
+    }
     HELD.set(held);
     PEAK.set(PEAK.get().max(held));
+    true
 }
 
 fn count_freed(bytes: usize) {
     HELD.set(HELD.get().saturating_sub(isize::try_from(bytes).unwrap_or(isize::MAX)));
 }
 
-// SAFETY: each method only counts its sizes, then hands its arguments to the system allocator,
-// whose blocks it returns: it meets GlobalAlloc's contract as the system allocator does.
+// SAFETY: each method counts its sizes, then either fails, returning null as GlobalAlloc lets an
+// allocator do when memory is exhausted (leaving a block it was to reallocate as it was), or
+// hands its arguments to the system allocator, whose blocks it returns: it meets GlobalAlloc's
+// contract as the system allocator does.
 unsafe impl GlobalAlloc for CountingAllocator {
     unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
-        count_allocated(layout.size());
+        if !count_allocated(layout.size()) {
+            return core::ptr::null_mut();
+        }
         // SAFETY: our caller meets alloc's contract.
         unsafe { System.alloc(layout) }
     }
 
     unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
-        count_allocated(layout.size());
+        if !count_allocated(layout.size()) {
+            return core::ptr::null_mut();
+        }
         // SAFETY: our caller meets alloc_zeroed's contract.
         unsafe { System.alloc_zeroed(layout) }
     }
@@ -63,7 +88,9 @@ unsafe impl GlobalAlloc for CountingAllocator {
 
     unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
         // A block that moves is held twice until it is copied: count the new one first.
-        count_allocated(new_size);
+        if !count_allocated(new_size) {
+            return core::ptr::null_mut();
+        }
         count_freed(layout.size());
         // SAFETY: our caller meets realloc's contract, and ptr comes from System, through us.
         unsafe { System.realloc(ptr, layout, new_size) }
@@ -80,6 +107,101 @@ fn peak_heap<T>(f: impl FnOnce() -> T) -> (T, usize) {
     (result, usize::try_from(peak).unwrap_or(0))
 }
 
+/// Runs `f` with this thread able to allocate at most `limit` bytes on top of what it holds
+/// already: an allocation that would take it further fails, as when memory runs out.
+fn with_heap_limit<T>(limit: usize, f: impl FnOnce() -> T) -> T {
+    /// Lifts the limit when `f` returns, or panics.
+    struct Lift;
+
+    impl Drop for Lift {
+        fn drop(&mut self) {
+            LIMIT.set(isize::MAX);
+        }
+    }
+
+    LIMIT.set(HELD.get().saturating_add(isize::try_from(limit).unwrap_or(isize::MAX)));
+    let _lift = Lift;
+    f()
+}
+
+struct NoopHandler;
+
+impl GraphicsPipelineHandler for NoopHandler {}
+
+/// The message a server sends for `pdu`: the PDU in an uncompressed ZGFX segment.
+fn zgfx_message(pdu: &GfxPdu) -> Vec<u8> {
+    wrap_uncompressed(&encode_vec(pdu).expect("the PDU encodes"))
+}
+
+/// A graphics pipeline client whose capabilities are confirmed, with a `width` x `height`
+/// surface 1.
+fn graphics_pipeline_client(width: u16, height: u16) -> GraphicsPipelineClient {
+    let mut client = GraphicsPipelineClient::new(Box::new(NoopHandler), None);
+    let confirm = GfxPdu::CapabilitiesConfirm(CapabilitiesConfirmPdu::from_typed(&CapabilitySet::V8 {
+        flags: CapabilitiesV8Flags::empty(),
+    }));
+    client
+        .process(0, &zgfx_message(&confirm))
+        .expect("the capabilities are confirmed");
+    let create = GfxPdu::CreateSurface(CreateSurfacePdu {
+        surface_id: 1,
+        width,
+        height,
+        pixel_format: PixelFormat::XRgb,
+    });
+    client
+        .process(0, &zgfx_message(&create))
+        .expect("the surface is created");
+    client
+}
+
+/// The message of a WireToSurface1 PDU drawing `bitmap_data`, coded with `codec_id`, into a
+/// `width` x `height` rectangle at the origin of surface 1.
+fn wire_to_surface1(codec_id: Codec1Type, width: u16, height: u16, bitmap_data: Vec<u8>) -> Vec<u8> {
+    zgfx_message(&GfxPdu::WireToSurface1(WireToSurface1Pdu {
+        surface_id: 1,
+        codec_id,
+        pixel_format: PixelFormat::XRgb,
+        destination_rectangle: ExclusiveRectangle {
+            left: 0,
+            top: 0,
+            right: width,
+            bottom: height,
+        },
+        bitmap_data,
+    }))
+}
+
+/// A ClearCodec bitmap stream of the given layers, without glyph or cache flags.
+fn clearcodec_stream(residual_data: &[u8], bands_data: &[u8], subcodec_data: &[u8]) -> Vec<u8> {
+    let mut stream = vec![0x00, 0x00]; // flags, seq
+    for layer in [residual_data, bands_data, subcodec_data] {
+        stream.extend_from_slice(&u32::try_from(layer.len()).expect("a layer fits in 4 GiB").to_le_bytes());
+    }
+    for layer in [residual_data, bands_data, subcodec_data] {
+        stream.extend_from_slice(layer);
+    }
+    stream
+}
+
+/// An RDP6 bitmap stream of RLE-compressed planes, without alpha, of a `width` x `height` image
+/// whose bytes are all zero: about one byte per 47 pixels of each plane.
+fn planar_zero_rle_stream(width: usize, height: usize) -> Vec<u8> {
+    // Each scanline is runs of 47 bytes (control byte 0xF2), then a run of the `width % 47` left,
+    // which must be 0 or from 3 to 15.
+    let mut scanline = vec![0xF2; width / 47];
+    if !width.is_multiple_of(47) {
+        scanline.push(u8::try_from(width % 47).expect("a remainder of 47 fits in a byte"));
+    }
+
+    // RLE, no alpha, ARGB.
+    let mut stream = vec![0x30];
+    for _ in 0..3 * height {
+        stream.extend_from_slice(&scanline);
+    }
+    stream
+}
