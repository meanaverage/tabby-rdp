 #[test]
 fn clearcodec_bands_past_the_destination_take_no_memory() {
     // 256 bands of 65536 columns each, 32 MiB, over a 2x2 destination: columns 0 and 1 carry
@@ -118,6 +240,50 @@ fn clearcodec_bands_past_the_destination_take_no_memory() {
     assert!(peak < 1024 * 1024, "decoding the layer took {peak} bytes");
