+/// Convert BGRA pixel data to RGBA8888, in place
+///
+/// ClearCodec produces BGRA output per [MS-RDPEGFX 2.2.4.1]. Reorder to
+/// [R, G, B, A] for the uniform `BitmapUpdate` pixel format. The image takes
+/// up to 256 MiB, for an 8192x8192 destination, so it is reordered where it
+/// is rather than copied.
+fn convert_bgra_to_rgba_in_place(pixels: &mut [u8]) {
+    debug_assert!(
+        pixels.len().is_multiple_of(4),
+        "BGRA input length not aligned to 4 bytes"
+    );
+    for pixel in pixels.chunks_exact_mut(4) {
+        pixel.swap(0, 2);
     }
-    dst
 }
 
