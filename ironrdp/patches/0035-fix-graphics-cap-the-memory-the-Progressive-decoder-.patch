+                5,
+                0,
+                MAX_SURFACE_DIM,
+                MAX_SURFACE_DIM,
+                &minimal_progressive_stream(true)
+            ),
+            Err(ProgressiveDecodeError::MemoryLimitExceeded { .. })
+        ));
+        decoder.delete_surface(1);
+        assert!(
+            decoder
+                .decode_bitmap(
+                    5,
+                    0,
+                    MAX_SURFACE_DIM,
+                    MAX_SURFACE_DIM,
+                    &minimal_progressive_stream(true)
+                )
+                .is_ok()
+        );
+        assert_eq!(decoder.memory.used, held_bytes(&decoder));
+    }
+
+    #[test]
+    fn decoder_charges_codec_contexts_for_the_memory_they_take() {
+        use ironrdp_pdu::codecs::rfx::progressive::{
+            ProgressiveBlock, ProgressiveContextPdu, ProgressiveSyncPdu, encode_progressive_stream,
+        };
+
+        let mut decoder = ProgressiveDecoder::new();
+        decoder.memory.limit = 1 << 20;
+        // Inside a frame, each codec context also has an entry in frame_tiles.
+        decoder.begin_frame();
+        let context = encode_progressive_stream(&[
+            ProgressiveBlock::Sync(ProgressiveSyncPdu),
+            ProgressiveBlock::Context(ProgressiveContextPdu {
+                context_id: 0,
+                tile_size: 0x0040,
+                flags: 0,
+            }),
+        ])
+        .unwrap();
+        decoder.decode_bitmap(1, 0, 1, 1, &context).unwrap();
+
+        // Empty payloads open more codec contexts on the one-tile surface: they share its tile state and its
+        // frame tiles, so however many there are, the surface is charged once.
+        for codec_context_id in 1..1_000 {
+            decoder.decode_bitmap(1, codec_context_id, 1, 1, &[]).unwrap();
+        }
+        assert_eq!(decoder.surfaces.len(), 1);
+        assert_eq!(decoder.frame_tiles.len(), 1);
+        assert_eq!(decoder.memory.used, held_bytes(&decoder));
+    }
+
+    #[test]
+    fn decoder_refuses_tiles_past_its_memory_limit() {
+        let mut decoder = ProgressiveDecoder::new();
+        // Room for a 2x1-tile grid and one tile with its sub-band reference.
+        decoder.memory.limit = surface_grid_bytes(2) + size_of::<TileState>() + REFERENCE_BYTES;
+
+        assert!(
+            decoder
+                .decode_bitmap(1, 0, 128, 64, &simple_tile_stream_at(0, 0, true))
+                .is_ok()
+        );
+        // Decoding a tile again takes no more memory.
+        assert!(
+            decoder
+                .decode_bitmap(1, 0, 128, 64, &simple_tile_stream_at(0, 0, false))
+                .is_ok()
+        );
+        assert!(matches!(
+            decoder.decode_bitmap(1, 0, 128, 64, &simple_tile_stream_at(1, 0, false)),
+            Err(ProgressiveDecodeError::MemoryLimitExceeded { .. })
+        ));
+        assert!(decoder.surfaces[&1].get(1, 0).is_none());
+        assert_eq!(decoder.memory.used, held_bytes(&decoder));
+
+        decoder.delete_surface(1);
+        assert_eq!(decoder.memory.used, 0);
+    }
+
+    #[test]
+    fn upgrade_of_a_tile_without_a_first_pass_does_not_fill_its_slot() {
+        let mut decoder = ProgressiveDecoder::new();
+        let stream = upgrade_tile_stream(
+            &[],
+            ComponentCodecQuant::LOSSLESS,
+            ComponentCodecQuant::LOSSLESS,
+            ComponentCodecQuant::LOSSLESS,
+            true,
+        );
+
+        let tiles = decoder.decode_bitmap(1, 0, 64, 64, &stream).unwrap();
+
+        assert!(tiles.is_empty());
+        assert!(decoder.surfaces[&1].get(0, 0).is_none());
+        assert_eq!(decoder.memory.used, surface_grid_bytes(1));
+    }
+
+    #[test]
+    fn decoder_memory_follows_resizes_resets_and_deletions() {
+        let mut decoder = ProgressiveDecoder::new();
+
+        assert!(
+            decoder
+                .decode_bitmap(1, 0, 64, 64, &simple_tile_stream_at(0, 0, true))
+                .is_ok()
+        );
+        assert!(
+            decoder
+                .decode_bitmap(2, 0, 64, 64, &simple_tile_stream_at(0, 0, true))
+                .is_ok()
+        );
+        assert_eq!(decoder.memory.used, held_bytes(&decoder));
+
+        // A resized surface gets a new, empty, tile grid.
+        assert!(
+            decoder
+                .decode_bitmap(1, 0, 256, 128, &simple_tile_stream_at(3, 1, false))
+                .is_ok()
+        );
+        assert_eq!(decoder.memory.used, held_bytes(&decoder));
+
+        decoder.reset();
+        assert_eq!(decoder.memory.used, 3 * REFERENCE_BYTES);
+        assert_eq!(decoder.memory.used, held_bytes(&decoder));
+
+        decoder.delete_surface(1);
+        assert_eq!(decoder.memory.used, REFERENCE_BYTES);
+        decoder.delete_surface(2);
+        assert_eq!(decoder.memory.used, 0);
+    }
 }
