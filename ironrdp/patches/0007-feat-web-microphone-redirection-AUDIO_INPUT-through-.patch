+//! Microphone redirection (MS-RDPEAI over the `AUDIO_INPUT` dynamic channel).
+//!
+//! Servers open the channel when a remote application starts recording and close it when it stops (Windows
+//! does, and so does GNOME Remote Desktop once something records from its PipeWire source), so a listener hands
+//! out a fresh [`RdpeaiClient`] for every opening. The capture backend lives inside that DVC processor, which
+//! must be `Send`: it only tells the session loop which format the server wants, and the loop hands that to the
+//! JS callback registered with the `audio_input` extension. JS captures the microphone itself and pushes 16-bit
+//! PCM back with the `audio_input_data` extension; [`AudioInputSink::push`] cuts it into Data PDUs for the open
+//! channel.
+
+use std::sync::{Arc, Mutex};
+
+use futures_channel::mpsc;
+use ironrdp::dvc::{DvcChannelListener, DvcClientProcessor};
+use ironrdp::rdpsnd::pdu::{AudioFormat, WaveFormat};
+use ironrdp_rdpeai::client::{AudioPacketSink, RdpeaiCaptureHandler, RdpeaiClient};
+use ironrdp_rdpeai::pdu::{MAX_DATA_PACKET_SIZE, OpenReplyPdu, pcm_format};
+use ironrdp_svc::SvcMessage;
+use tracing::{debug, warn};
+use wasm_bindgen::JsValue;
+
+use crate::session::RdpInputEvent;
+
+/// What the capture backend tells the session loop (and so the JS callback).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum AudioInputMessage {
+    /// Start capturing (or switch to this format): interleaved 16-bit PCM at this rate and channel count.
+    Open { sample_rate: u32, channels: u16 },
+    /// Stop capturing: the server closed the device.
+    Close,
+}
+
+/// DRDYNVC Data PDUs for the open `AUDIO_INPUT` channel, encoded, on their way to the session loop.
+///
+/// Encoded because session events must be `Sync` and [`SvcMessage`] is not; the loop wraps them again (they
+/// carry no extra channel flags).
+#[derive(Debug)]
+pub(crate) struct AudioInputUplink(Vec<Vec<u8>>);
+
+impl AudioInputUplink {
+    pub(crate) fn into_messages(self) -> Vec<SvcMessage> {
+        self.0.into_iter().map(SvcMessage::from).collect()
+    }
+}
+
+struct OpenCapture {
+    sink: AudioPacketSink,
+    packet_size: usize,
+    buffer: Vec<u8>,
+}
+
+/// Where PCM from JS goes: the open channel's packet sink, if the server has the device open.
+///
+/// Shared by the session (which receives the PCM) and the capture backends the listener creates.
+#[derive(Clone, Default)]
+pub(crate) struct AudioInputSink(Arc<Mutex<Option<OpenCapture>>>);
+
+impl AudioInputSink {
+    /// Queues interleaved 16-bit little-endian PCM in the negotiated format, and sends every full packet.
+    ///
+    /// Returns false (and drops the data) while the server has no capture open, which is normal right after it
+    /// closed the device.
+    pub(crate) fn push(&self, data: &[u8]) -> bool {
+        let Ok(mut guard) = self.0.lock() else {
+            return false;
+        };
+        let Some(open) = guard.as_mut() else {
+            return false;
+        };
+        open.buffer.extend_from_slice(data);
+        let mut start = 0;
+        while open.buffer.len() - start >= open.packet_size {
+            let end = start + open.packet_size;
+            (open.sink)(open.buffer[start..end].to_vec());
+            start = end;
+        }
+        open.buffer.drain(..start);
+        true
+    }
+
+    fn open(&self, sink: AudioPacketSink, packet_size: usize) {
+        if let Ok(mut guard) = self.0.lock() {
+            *guard = Some(OpenCapture {
+                sink,
+                packet_size,
+                buffer: Vec::with_capacity(packet_size),
+            });
+        }
+    }
+
+    fn set_packet_size(&self, packet_size: usize) {
+        if let Ok(mut guard) = self.0.lock() {
+            if let Some(open) = guard.as_mut() {
+                open.packet_size = packet_size;
+                // Samples buffered in the previous format would be misread in the new one.
+                open.buffer.clear();
+            }
+        }
+    }
+
+    fn close(&self) {
+        if let Ok(mut guard) = self.0.lock() {
+            *guard = None;
+        }
+    }
+}
+
+/// Uncompressed 16-bit PCM only: it's what the browser produces (after resampling), and all servers accept it.
+///
+/// GNOME Remote Desktop only takes 44.1 kHz stereo (or A-law); Windows offers many and picks from this list.
+/// Mono first where the server also has it: it halves the upload, and a microphone is mono anyway.
+fn default_formats() -> Vec<AudioFormat> {
+    vec![
+        pcm_format(1, 48_000, 16),
+        pcm_format(1, 44_100, 16),
+        pcm_format(2, 48_000, 16),
+        pcm_format(2, 44_100, 16),
+        pcm_format(1, 22_050, 16),
+        pcm_format(2, 22_050, 16),
+        pcm_format(1, 16_000, 16),
+    ]
+}
+
+/// The capture backend of one `AUDIO_INPUT` channel opening.
+pub(crate) struct WasmCaptureBackend {
+    tx: mpsc::UnboundedSender<RdpInputEvent>,
+    sink: AudioInputSink,
+    formats: Vec<AudioFormat>,
+    /// Frames per Data PDU, from the server's Open.
+    frames_per_packet: Option<usize>,
+}
+
+impl WasmCaptureBackend {
+    pub(crate) fn new(tx: mpsc::UnboundedSender<RdpInputEvent>, sink: AudioInputSink) -> Self {
+        Self {
+            tx,
+            sink,
+            formats: default_formats(),
+            frames_per_packet: None,
+        }
+    }
+
+    fn send(&self, message: AudioInputMessage) {
+        if self.tx.unbounded_send(RdpInputEvent::AudioInput(message)).is_err() {
+            debug!("Audio input message dropped: the session loop is gone");
+        }
+    }
+
+    /// The Data PDU size for `frames` frames in `format`, if the format is one this backend produces.
+    fn packet_size(format: &AudioFormat, frames: usize) -> Option<usize> {
+        if format.format != WaveFormat::PCM || format.bits_per_sample != 16 || format.n_channels == 0 {
+            return None;
+        }
+        let size = frames.checked_mul(usize::from(format.n_channels))?.checked_mul(2)?;
+        (0 < size && size <= MAX_DATA_PACKET_SIZE).then_some(size)
+    }
+}
+
+impl RdpeaiCaptureHandler for WasmCaptureBackend {
+    fn supported_formats(&self) -> &[AudioFormat] {
+        &self.formats
+    }
+
+    fn open(
+        &mut self,
+        capture_format: &AudioFormat,
+        encode_format: &AudioFormat,
+        packet_size: usize,
+        sink: AudioPacketSink,
+    ) -> i32 {
+        // Data PDUs carry the encoding format (`initialFormat`, one of ours); the capture WAVEFORMATEX only tells
+        // the packet length in frames. It needn't match the encoding: GNOME Remote Desktop describes 44.1 kHz
+        // stereo as WAVE_FORMAT_EXTENSIBLE, and FreeRDP's client ignores it altogether.
+        let frames = packet_size / (usize::from(capture_format.n_channels.max(1)) * 2);
+        let Some(size) = Self::packet_size(encode_format, frames) else {
+            warn!(
+                ?encode_format,
+                frames, "Refusing audio capture open: unsupported format"
+            );
+            return OpenReplyPdu::E_FAIL;
+        };
+        self.frames_per_packet = Some(frames);
+        self.sink.open(sink, size);
+        debug!(
+            sample_rate = encode_format.n_samples_per_sec,
+            channels = encode_format.n_channels,
+            packet_size = size,
+            "Audio capture opened"
+        );
+        self.send(AudioInputMessage::Open {
+            sample_rate: encode_format.n_samples_per_sec,
+            channels: encode_format.n_channels,
+        });
+        OpenReplyPdu::S_OK
+    }
+
+    fn set_format(&mut self, encode_format: &AudioFormat, _packet_size: usize) -> bool {
+        let Some(size) = self
+            .frames_per_packet
+            .and_then(|frames| Self::packet_size(encode_format, frames))
+        else {
+            return false;
+        };
+        self.sink.set_packet_size(size);
+        self.send(AudioInputMessage::Open {
+            sample_rate: encode_format.n_samples_per_sec,
+            channels: encode_format.n_channels,
+        });
+        true
+    }
+
+    fn close(&mut self) {
+        // The client also closes a backend that never opened (channel closed during negotiation).
+        if self.frames_per_packet.take().is_some() {
+            self.sink.close();
+            self.send(AudioInputMessage::Close);
+        }
+    }
+}
+
+/// Hands out a fresh `AUDIO_INPUT` client for every channel the server opens (see the module docs).
+pub(crate) struct AudioInputListener {
+    pub(crate) tx: mpsc::UnboundedSender<RdpInputEvent>,
+    pub(crate) sink: AudioInputSink,
+}
+
+impl DvcChannelListener for AudioInputListener {
+    fn channel_name(&self) -> &str {
+        ironrdp_rdpeai::CHANNEL_NAME
+    }
+
+    fn create(&mut self, _channel_id: u32) -> Option<Box<dyn DvcClientProcessor>> {
+        let uplink_tx = self.tx.clone();
+        Some(Box::new(RdpeaiClient::new(
+            Box::new(WasmCaptureBackend::new(self.tx.clone(), self.sink.clone())),
+            Box::new(move |_channel_id, messages| {
+                let encoded = messages
+                    .iter()
+                    .map(SvcMessage::encode_unframed_pdu)
+                    .collect::<Result<Vec<_>, _>>()
+                    .map_err(|error| ironrdp_pdu::encode_err!(error))?;
+                if uplink_tx
+                    .unbounded_send(RdpInputEvent::AudioInputUplink(AudioInputUplink(encoded)))
+                    .is_err()
+                {
+                    debug!("Audio input data dropped: the session loop is gone");
+                }
+                Ok(())
+            }),
+        )))
+    }
+}
+
+/// The message as the object the JS callback receives: `{ type: 'open', sampleRate, channels }` or
+/// `{ type: 'close' }`.
+pub(crate) fn to_js(message: AudioInputMessage) -> JsValue {
+    let object = js_sys::Object::new();
+    let set = |key: &str, value: JsValue| {
+        let _ = js_sys::Reflect::set(&object, &JsValue::from_str(key), &value);
+    };
+    match message {
+        AudioInputMessage::Open { sample_rate, channels } => {
+            set("type", JsValue::from_str("open"));
+            set("sampleRate", JsValue::from(sample_rate));
+            set("channels", JsValue::from(channels));
+        }
+        AudioInputMessage::Close => set("type", JsValue::from_str("close")),
+    }
+    object.into()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn backend() -> (
+        WasmCaptureBackend,
+        mpsc::UnboundedReceiver<RdpInputEvent>,
+        AudioInputSink,
+    ) {
+        let (tx, rx) = mpsc::unbounded();
+        let sink = AudioInputSink::default();
+        (WasmCaptureBackend::new(tx, sink.clone()), rx, sink)
+    }
+
+    fn collecting_sink() -> (AudioPacketSink, Arc<Mutex<Vec<Vec<u8>>>>) {
+        let packets = Arc::new(Mutex::new(Vec::new()));
+        let collected = Arc::clone(&packets);
+        (
+            Box::new(move |packet| collected.lock().expect("lock").push(packet)),
+            packets,
+        )
+    }
+
+    fn next_message(rx: &mut mpsc::UnboundedReceiver<RdpInputEvent>) -> Option<AudioInputMessage> {
+        match rx.try_recv() {
+            Ok(RdpInputEvent::AudioInput(message)) => Some(message),
+            _ => None,
+        }
+    }
+
+    /// GNOME Remote Desktop's Open: 441 frames of 44.1 kHz stereo, described as WAVE_FORMAT_EXTENSIBLE.
+    fn extensible_capture_format() -> AudioFormat {
+        AudioFormat {
+            format: WaveFormat::EXTENSIBLE,
+            data: Some(vec![0; 22]),
+            ..pcm_format(2, 44_100, 16)
+        }
+    }
+
+    #[test]
+    fn open_reports_the_encoding_format_and_packetizes_pushed_pcm() {
+        let (mut backend, mut rx, sink) = backend();
+        let (packet_sink, packets) = collecting_sink();
+        let result = backend.open(
+            &extensible_capture_format(),
+            &pcm_format(2, 44_100, 16),
+            441 * 4,
+            packet_sink,
+        );
+        assert_eq!(result, OpenReplyPdu::S_OK);
+        assert_eq!(
+            next_message(&mut rx),
+            Some(AudioInputMessage::Open {
+                sample_rate: 44_100,
+                channels: 2
+            })
+        );
+
+        assert!(sink.push(&[1; 1000]));
+        assert!(packets.lock().expect("lock").is_empty());
+        assert!(sink.push(&[2; 3000]));
+        let sent = packets.lock().expect("lock").clone();
+        assert_eq!(sent.len(), 2);
+        assert!(sent.iter().all(|packet| packet.len() == 1764));
+        assert_eq!(&sent[0][..1000], &[1; 1000][..]);
+        assert_eq!(sent[0][1000], 2);
+    }
+
+    #[test]
+    fn packet_length_follows_the_encoding_channels() {
+        // Stereo capture described, mono encoding chosen: same frames per packet, half the bytes.
+        let (mut backend, _rx, sink) = backend();
+        let (packet_sink, packets) = collecting_sink();
+        let capture = pcm_format(2, 48_000, 16);
+        assert_eq!(
+            backend.open(&capture, &pcm_format(1, 48_000, 16), 480 * 4, packet_sink),
+            OpenReplyPdu::S_OK
+        );
+        sink.push(&[0; 960]);
+        assert_eq!(packets.lock().expect("lock").len(), 1);
+    }
+
+    #[test]
+    fn format_change_keeps_frames_per_packet_and_tells_js() {
+        let (mut backend, mut rx, sink) = backend();
+        let (packet_sink, packets) = collecting_sink();
+        backend.open(
+            &pcm_format(1, 48_000, 16),
+            &pcm_format(1, 48_000, 16),
+            480 * 2,
+            packet_sink,
+        );
+        let _ = next_message(&mut rx);
+        sink.push(&[0; 100]);
+
+        assert!(backend.set_format(&pcm_format(2, 44_100, 16), 480 * 2));
+        assert_eq!(
+            next_message(&mut rx),
+            Some(AudioInputMessage::Open {
+                sample_rate: 44_100,
+                channels: 2
+            })
+        );
+        // The 100 bytes in the old format were dropped; a packet is now 480 stereo frames.
+        sink.push(&[0; 1920]);
+        let sent = packets.lock().expect("lock").clone();
+        assert_eq!(sent.len(), 1);
+        assert_eq!(sent[0].len(), 1920);
+    }
+
+    #[test]
+    fn close_stops_forwarding_and_is_reported_once() {
+        let (mut backend, mut rx, sink) = backend();
+        let (packet_sink, packets) = collecting_sink();
+        backend.open(
+            &pcm_format(1, 16_000, 16),
+            &pcm_format(1, 16_000, 16),
+            160 * 2,
+            packet_sink,
+        );
+        let _ = next_message(&mut rx);
+
+        backend.close();
+        backend.close();
+        assert_eq!(next_message(&mut rx), Some(AudioInputMessage::Close));
+        assert_eq!(next_message(&mut rx), None);
+        assert!(!sink.push(&[0; 640]));
+        assert!(packets.lock().expect("lock").is_empty());
+    }
+
+    #[test]
+    fn close_without_open_says_nothing() {
+        let (mut backend, mut rx, _sink) = backend();
+        backend.close();
+        assert_eq!(next_message(&mut rx), None);
+    }
+
+    #[test]
+    fn open_refuses_formats_it_cannot_produce() {
+        let (mut backend, mut rx, _sink) = backend();
+        let (packet_sink, _) = collecting_sink();
+        let alaw = AudioFormat {
+            format: WaveFormat::ALAW,
+            bits_per_sample: 8,
+            ..pcm_format(2, 44_100, 8)
+        };
+        assert_eq!(
+            backend.open(&pcm_format(2, 44_100, 16), &alaw, 441 * 4, packet_sink),
+            OpenReplyPdu::E_FAIL
+        );
+        assert_eq!(next_message(&mut rx), None);
+    }
+}
