     return new Extension('audio_playback', callback);
 }
 
+/**
+ * Redirects a microphone (MS-RDPEAI). The server asks for it only while a remote application records:
+ * `callback` receives `{ type: 'open', sampleRate, channels }` when capture should start (or switch format),
+ * and `{ type: 'close' }` when it should stop. While open, push the captured audio with `audioInputData`.
+ */
+export function audioInput(callback: (message: unknown) => void): Extension {
+    return new Extension('audio_input', callback);
+}
+
+/**
+ * Captured audio for the server, as interleaved 16-bit PCM in the format of the last `open` message, for
+ * `invokeExtension`. Any length will do: it is sent in the packet size the server asked for. Audio arriving after
+ * the server closed the capture is dropped.
+ */
+export function audioInputData(samples: Int16Array | Uint8Array): Extension {
+    // The WASM side takes bytes; view an Int16Array's buffer rather than converting it element by element.
+    const bytes =
+        samples instanceof Uint8Array
+            ? samples
+            : new Uint8Array(samples.buffer, samples.byteOffset, samples.byteLength);
+    return new Extension('audio_input_data', bytes);
+}
+
 export function kdcProxyUrl(url: string): Extension {
     return new Extension('kdc_proxy_url', url);
 }
