+/// Records what `open` got, and keeps the sink to push captured audio later (as a host that captures on its own
+/// schedule, such as a browser, does).
+struct PushCapture {
+    formats: Vec<AudioFormat>,
+    opened: Arc<Mutex<Option<OpenedCapture>>>,
+}
+
+type OpenedCapture = (AudioFormat, AudioFormat, usize, AudioPacketSink);
+
+impl RdpeaiCaptureHandler for PushCapture {
+    fn supported_formats(&self) -> &[AudioFormat] {
+        &self.formats
+    }
+
+    fn open(
+        &mut self,
+        capture_format: &AudioFormat,
+        encode_format: &AudioFormat,
+        packet_size: usize,
+        sink: AudioPacketSink,
+    ) -> i32 {
+        *self.opened.lock().unwrap() = Some((capture_format.clone(), encode_format.clone(), packet_size, sink));
+        OpenReplyPdu::S_OK
+    }
+
+    fn set_format(&mut self, _encode_format: &AudioFormat, _packet_size: usize) -> bool {
+        true
+    }
+
+    fn close(&mut self) {
+        *self.opened.lock().unwrap() = None;
+    }
+}
+
+/// GNOME Remote Desktop offers A-law and PCM, both 44.1 kHz stereo, and describes the capture format of its Open
+/// as WAVE_FORMAT_EXTENSIBLE (PCM subtype), with 441 frames per packet.
+#[test]
+fn gnome_remote_desktop_negotiation_and_pushed_data() {
+    let pcm = pcm_format(2, 44_100, 16);
+    let alaw = AudioFormat {
+        format: WaveFormat::ALAW,
+        n_channels: 2,
+        n_samples_per_sec: 44_100,
+        n_avg_bytes_per_sec: 88_200,
+        n_block_align: 2,
+        bits_per_sample: 8,
+        data: None,
+    };
+    let extensible_extra = vec![
+        16, 0, // wValidBitsPerSample
+        3, 0, 0, 0, // dwChannelMask
+        0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10, 0x00, // SubFormat: KSDATAFORMAT_SUBTYPE_PCM
+        0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71,
+    ];
+    let capture = AudioFormat {
+        format: WaveFormat::EXTENSIBLE,
+        data: Some(extensible_extra),
+        ..pcm_format(2, 44_100, 16)
+    };
+
+    let opened = Arc::new(Mutex::new(None));
+    let uplinked = Arc::new(Mutex::new(Vec::new()));
+    let uplink_log = Arc::clone(&uplinked);
+    let mut client = RdpeaiClient::new(
+        Box::new(PushCapture {
+            formats: vec![pcm_format(1, 48_000, 16), pcm_format(1, 44_100, 16), pcm.clone()],
+            opened: Arc::clone(&opened),
+        }),
+        Box::new(move |channel_id, messages| {
+            uplink_log.lock().unwrap().push((channel_id, messages.len()));
+            Ok(())
+        }),
+    );
+
+    client.start(3).unwrap();
+    let _ = process_encoded(&mut client, 3, RdpeaiPdu::Version(VersionPdu::new(Version::V1)));
+    let formats_out = process_encoded(
+        &mut client,
+        3,
+        RdpeaiPdu::Formats(FormatsPdu::server(vec![alaw, pcm.clone()])),
+    );
+    match decode_dvc(&formats_out[1]) {
+        // Only the format both sides have, so GNOME's Open refers to index 0.
+        RdpeaiPdu::Formats(formats) => assert_eq!(formats.formats, vec![pcm.clone()]),
+        other => panic!("expected client Formats, got {other:?}"),
+    }
+
+    let open_out = process_encoded(
+        &mut client,
+        3,
+        RdpeaiPdu::Open(OpenPdu {
+            frames_per_packet: 441,
+            initial_format: 0,
+            capture_format: capture.clone(),
+        }),
+    );
+    match decode_dvc(&open_out[1]) {
+        RdpeaiPdu::OpenReply(reply) => assert_eq!(reply.result, OpenReplyPdu::S_OK),
+        other => panic!("expected OpenReply ok, got {other:?}"),
+    }
+
+    let (open_capture, open_encode, packet_size, mut sink) = opened.lock().unwrap().take().expect("opened");
+    assert_eq!(open_capture, capture);
+    assert_eq!(open_encode, pcm);
+    assert_eq!(packet_size, 441 * 2 * 2);
+
+    // Audio pushed later goes out on the channel as Incoming Data, then Data (1765 bytes: two DVC chunks).
+    sink(vec![0; packet_size]);
+    assert_eq!(*uplinked.lock().unwrap(), vec![(3, 3)]);
+}
