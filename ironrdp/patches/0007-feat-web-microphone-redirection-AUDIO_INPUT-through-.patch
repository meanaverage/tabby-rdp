diff --git a/web-client/iron-remote-desktop-rdp/src/audioInput.test.ts b/web-client/iron-remote-desktop-rdp/src/audioInput.test.ts
new file mode 100644
index 00000000..a482e2fd
--- /dev/null
+++ b/web-client/iron-remote-desktop-rdp/src/audioInput.test.ts
@@ -0,0 +1,48 @@
+import { describe, it, expect, vi } from 'vitest';
+
+// The real Extension lives in the WASM package; a plain stand-in shows what reaches it.
+vi.mock('../../../crates/ironrdp-web/pkg/ironrdp_web', () => ({
+    default: () => Promise.resolve(),
+    setup: () => {},
+    DesktopSize: class {},
+    DeviceEvent: class {},
+    InputTransaction: class {},
+    SessionBuilder: class {},
+    ClipboardData: class {},
+    RdpFile: class {},
+    Extension: class {
+        constructor(
+            public ident: string,
+            public value: unknown,
+        ) {}
+    },
+}));
+
+const { audioInput, audioInputData } = await import('./main');
+
+describe('audio input extensions', () => {
+    it('registers the callback under audio_input', () => {
+        const callback = () => {};
+        expect(audioInput(callback)).toEqual({ ident: 'audio_input', value: callback });
+    });
+
+    it('passes the bytes of an Int16Array, little-endian, without converting samples', () => {
+        const samples = new Int16Array([0x0102, -2, 32767]);
+        const ext = audioInputData(samples) as unknown as { ident: string; value: Uint8Array };
+        expect(ext.ident).toBe('audio_input_data');
+        expect(ext.value).toBeInstanceOf(Uint8Array);
+        expect(Array.from(ext.value)).toEqual([0x02, 0x01, 0xfe, 0xff, 0xff, 0x7f]);
+        expect(ext.value.buffer).toBe(samples.buffer);
+    });
+
+    it('respects the offset of a view into a larger buffer', () => {
+        const all = new Int16Array([1, 2, 3, 4]);
+        const ext = audioInputData(all.subarray(2)) as unknown as { value: Uint8Array };
+        expect(Array.from(ext.value)).toEqual([3, 0, 4, 0]);
+    });
+
+    it('passes a Uint8Array as is', () => {
+        const bytes = new Uint8Array([1, 2, 3, 4]);
+        expect((audioInputData(bytes) as unknown as { value: Uint8Array }).value).toBe(bytes);
+    });
+});
