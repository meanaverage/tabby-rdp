diff --git a/web-client/iron-remote-desktop/src/services/clipboardPause.test.ts b/web-client/iron-remote-desktop/src/services/clipboardPause.test.ts
new file mode 100644
index 00000000..62ae4156
--- /dev/null
+++ b/web-client/iron-remote-desktop/src/services/clipboardPause.test.ts
@@ -0,0 +1,262 @@
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+import { RemoteDesktopService } from './remote-desktop.service';
+import { ClipboardService } from './clipboard.service';
+import type { RemoteDesktopModule } from '../interfaces/RemoteDesktopModule';
+import type { ClipboardData } from '../interfaces/ClipboardData';
+
+/**
+ * A paused clipboard (a session that is only watched) goes neither way: the local clipboard isn't read or sent, and
+ * what the server copies is dropped. Pausing withdraws what this side offered, unless the server copied something of
+ * its own since; resuming offers it again.
+ */
+
+function textData(text: string): ClipboardData {
+    return {
+        items: () => [{ mimeType: () => 'text/plain', value: () => text }],
+        isEmpty: () => false,
+    } as unknown as ClipboardData;
+}
+
+// The session's ClipboardData, keeping the text it is given so that a test can tell what was sent.
+class SentData {
+    text = '';
+    addText(_kind: string, text: string) {
+        this.text = text;
+    }
+    addBinary() {}
+    isEmpty() {
+        return this.text === '';
+    }
+}
+
+const module = { ClipboardData: SentData } as unknown as RemoteDesktopModule;
+
+describe('paused clipboard', () => {
+    let local: string;
+    let written: string[];
+    let reads: ReturnType<typeof vi.fn>;
+    // What the session was handed for the server: the text of each clipboard sent, '' for an empty one.
+    let sent: string[];
+
+    async function started(): Promise<{ service: RemoteDesktopService; clipboard: ClipboardService }> {
+        const service = new RemoteDesktopService(module);
+        vi.spyOn(service, 'onClipboardChanged').mockImplementation(async (data) => {
+            sent.push((data as unknown as SentData).text);
+        });
+        vi.spyOn(service, 'onClipboardChangedEmpty').mockImplementation(async () => {
+            sent.push('');
+        });
+        const clipboard = new ClipboardService(service, module);
+        await clipboard.initClipboard();
+        service.sessionStartedObservable.publish(null);
+        return { service, clipboard };
+    }
+
+    // What the service hands a clipboard update from the server to (the auto-mode callback ClipboardService installed).
+    function remoteCopies(service: RemoteDesktopService, text: string) {
+        (service as unknown as { onRemoteClipboardChanged: (data: ClipboardData) => void }).onRemoteClipboardChanged(
+            textData(text),
+        );
+    }
+
+    // The server asking for the client's clipboard as the channel starts.
+    function forceUpdate(service: RemoteDesktopService): Promise<void> {
+        return (service as unknown as { onForceClipboardUpdate: () => Promise<void> }).onForceClipboardUpdate();
+    }
+
+    // Turns of the monitoring loop (100 ms each) and the clipboard reads and writes they wait for; timers are fake.
+    const turns = (n = 3) => vi.advanceTimersByTimeAsync(100 * n + 1);
+
+    beforeEach(() => {
+        vi.useFakeTimers({ toFake: ['setTimeout', 'clearTimeout'] });
+        local = '';
+        written = [];
+        sent = [];
+        reads = vi.fn(async () =>
+            local === '' ? [] : [{ types: ['text/plain'], getType: async () => ({ text: async () => local }) }],
+        );
+        vi.spyOn(document, 'hasFocus').mockImplementation(() => true);
+        vi.stubGlobal('isSecureContext', true);
+        // jsdom's Blob can't be read back; the service only wraps the text in one.
+        vi.stubGlobal(
+            'Blob',
+            class {
+                constructor(readonly parts: string[]) {}
+            },
+        );
+        vi.stubGlobal(
+            'ClipboardItem',
+            class {
+                constructor(readonly items: Record<string, { parts: string[] }>) {}
+            },
+        );
+        vi.stubGlobal('navigator', {
+            ...navigator,
+            clipboard: {
+                read: reads,
+                write: vi.fn(async ([item]: [{ items: Record<string, { parts: string[] }> }]) => {
+                    written.push(item.items['text/plain'].parts[0]);
+                }),
+                readText: vi.fn(),
+                writeText: vi.fn(),
+            },
+            permissions: { query: vi.fn(async () => ({ state: 'granted' })) },
+        });
+    });
+
+    afterEach(() => {
+        vi.useRealTimers();
+        vi.restoreAllMocks();
+        vi.unstubAllGlobals();
+    });
+
+    it('neither reads the local clipboard nor sends it while paused', async () => {
+        const { clipboard } = await started();
+        await clipboard.setPaused(true);
+        local = 'copied here';
+        reads.mockClear();
+        await turns(5);
+
+        expect(reads).not.toHaveBeenCalled();
+        expect(sent).toEqual([]);
+        clipboard.dispose();
+    });
+
+    it("drops the server's copies while paused, and doesn't write them once resumed", async () => {
+        const { service, clipboard } = await started();
+        await clipboard.setPaused(true);
+        remoteCopies(service, 'copied there');
+        await turns();
+        expect(written).toEqual([]);
+
+        await clipboard.setPaused(false);
+        clipboard.flushFocused();
+        await turns();
+        expect(written).toEqual([]);
+        clipboard.dispose();
+    });
+
+    it("drops a server's copy that was waiting for the focus when pausing", async () => {
+        const { service, clipboard } = await started();
+        vi.mocked(document.hasFocus).mockImplementation(() => false);
+        remoteCopies(service, 'waiting');
+        await clipboard.setPaused(true);
+        vi.mocked(document.hasFocus).mockImplementation(() => true);
+        await clipboard.setPaused(false);
+        clipboard.flushFocused();
+        await turns();
+
+        expect(written).toEqual([]);
+        clipboard.dispose();
+    });
+
+    it('withdraws what this side offered, and offers it again on resuming', async () => {
+        const { clipboard } = await started();
+        local = 'secret';
+        await turns();
+        expect(sent).toEqual(['secret']);
+
+        await clipboard.setPaused(true);
+        expect(sent).toEqual(['secret', '']);
+
+        // Unchanged here meanwhile, it is offered again all the same: pausing took it back.
+        await clipboard.setPaused(false);
+        await turns();
+        expect(sent).toEqual(['secret', '', 'secret']);
+        clipboard.dispose();
+    });
+
+    it("leaves the server's own copy alone, and offers nothing new on resuming", async () => {
+        const { service, clipboard } = await started();
+        local = 'mine';
+        await turns();
+        remoteCopies(service, 'theirs');
+        await turns();
+        expect(written).toEqual(['theirs']);
+        // Here it is the server's copy now, which the monitoring loop doesn't send back.
+        local = 'theirs';
+        await turns();
+
+        await clipboard.setPaused(true);
+        await clipboard.setPaused(false);
+        await turns();
+        expect(sent).toEqual(['mine']);
+        clipboard.dispose();
+    });
+
+    it("doesn't offer this side's clipboard again over a copy the server made while paused", async () => {
+        const { service, clipboard } = await started();
+        local = 'mine';
+        await turns();
+        await clipboard.setPaused(true);
+        remoteCopies(service, 'theirs');
+        await clipboard.setPaused(false);
+        await turns();
+
+        expect(sent).toEqual(['mine', '']);
+        expect(written).toEqual([]);
+        clipboard.dispose();
+    });
+
+    it('sends copies made here while paused once resumed, as it does after the focus comes back', async () => {
+        const { service, clipboard } = await started();
+        remoteCopies(service, 'theirs');
+        await turns();
+        local = 'theirs';
+        await turns();
+        await clipboard.setPaused(true);
+        local = 'copied while watching';
+        await turns();
+        expect(sent).toEqual([]);
+
+        await clipboard.setPaused(false);
+        await turns();
+        expect(sent).toEqual(['copied while watching']);
+        clipboard.dispose();
+    });
+
+    it('answers the initial clipboard request with an empty one while paused', async () => {
+        const { service, clipboard } = await started();
+        local = 'secret';
+        await turns();
+        await clipboard.setPaused(true);
+        await forceUpdate(service);
+        expect(sent).toEqual(['secret', '', '']);
+
+        // Not paused, the last clipboard sent goes as usual.
+        await clipboard.setPaused(false);
+        await turns();
+        await forceUpdate(service);
+        expect(sent).toEqual(['secret', '', '', 'secret', 'secret']);
+        clipboard.dispose();
+    });
+
+    it('answers the initial clipboard request with an empty one while paused when nothing was withdrawn', async () => {
+        const { service, clipboard } = await started();
+        local = 'mine';
+        await turns();
+        remoteCopies(service, 'theirs');
+        await clipboard.setPaused(true);
+        await forceUpdate(service);
+        expect(sent).toEqual(['mine', '']);
+
+        // What the request would have got is offered on resuming.
+        await clipboard.setPaused(false);
+        await turns();
+        expect(sent).toEqual(['mine', '', 'mine']);
+        clipboard.dispose();
+    });
+
+    it('refuses to send the clipboard on request while paused', async () => {
+        const { clipboard } = await started();
+        local = 'secret';
+        await clipboard.setPaused(true);
+        await expect(clipboard.sendClipboardData()).rejects.toMatchObject({ backtrace: expect.any(Function) });
+        expect(sent).toEqual([]);
+
+        await clipboard.setPaused(false);
+        await clipboard.sendClipboardData();
+        expect(sent).toEqual(['secret']);
+        clipboard.dispose();
+    });
+});
