+    /// Queues a decoded PDU; with an external H.264 decoder, an AVC420 frame is handed out right away, so that
+    /// decoding overlaps with receiving what follows.
+    fn enqueue(&mut self, pdu: GfxPdu) -> PduResult<()> {
