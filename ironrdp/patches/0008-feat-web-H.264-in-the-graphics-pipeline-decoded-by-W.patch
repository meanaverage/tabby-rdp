+#[test]
+fn avc444_main_views_are_shown_and_auxiliary_views_only_decoded() {
+    let mut client = client();
+    let main = [0, 0, 0, 1, 0x21, 0x01];
+    let auxiliary = [0, 0, 0, 1, 0x21, 0x02];
+    process_all(
+        &mut client,
+        &[
+            start(1),
+            // LC 0: main view and auxiliary view
+            avc444(Encoding::LUMA_AND_CHROMA, &main, Some(&auxiliary)),
+            end(1),
+            start(2),
+            // LC 1: main view alone
+            avc444(Encoding::LUMA, &main, None),
+            end(2),
+            start(3),
+            // LC 2: auxiliary view alone
+            avc444(Encoding::CHROMA, &auxiliary, None),
+            end(3),
+        ],
+    );
+    let frames = client.take_h264_frames();
+    // Every access unit goes to the decoder, in order, so that the stream stays whole.
+    let handed_out: Vec<(&[u8], usize)> = frames.iter().map(|f| (f.data.as_slice(), f.regions.len())).collect();
+    assert_eq!(
+        handed_out,
+        [(&main[..], 1), (&auxiliary[..], 0), (&main[..], 1), (&auxiliary[..], 0)]
+    );
