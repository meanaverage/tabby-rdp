@@ -0,0 +1,500 @@
+//! H.264 bitstream helpers for decoders that run outside the channel processor
+//!
+//! A platform decoder (a browser's WebCodecs `VideoDecoder`, VideoToolbox, Media Foundation, VA-API) takes an
+//! ITU-T H.264 Annex B byte stream, which is what [MS-RDPEGFX] 2.2.4.4 specifies for AVC420 bitmap streams. These
+//! helpers bring the bitstream into the shape such decoders expect, and answer the questions a caller of one has to
+//! answer (is this access unit a key frame?).
+//!
+//! [MS-RDPEGFX] 2.2.4.4: https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-rdpegfx/5f12c20e-2ea1-4ad1-a2a0-019ee3893731
+
+use std::borrow::Cow;
+
+use crate::pdu::avc_to_annex_b;
+
+const NAL_TYPE_IDR: u8 = 5;
+const NAL_TYPE_SPS: u8 = 7;
+
+/// Returns the bitstream as an Annex B byte stream.
+///
+/// MS-RDPEGFX specifies Annex B, and servers such as GNOME Remote Desktop send it; an input that is instead a
+/// complete chain of 4-byte length-prefixed NAL units (as some encoders produce) is converted. A leading start code
+/// is taken as Annex B first, so a stream that happens to also parse as a length chain is left alone.
+#[must_use]
+pub fn to_annex_b(data: &[u8]) -> Cow<'_, [u8]> {
+    if starts_with_start_code(data) || !is_length_prefixed(data) {
+        Cow::Borrowed(data)
+    } else {
+        Cow::Owned(avc_to_annex_b(data))
+    }
+}
+
+fn starts_with_start_code(data: &[u8]) -> bool {
+    data.starts_with(&[0, 0, 1]) || data.starts_with(&[0, 0, 0, 1])
+}
+
+/// Whether `data` is a non-empty chain of 4-byte big-endian length prefixes, each followed by a NAL unit with a
+/// clear forbidden_zero_bit, ending exactly at the end of the buffer.
+fn is_length_prefixed(mut data: &[u8]) -> bool {
+    if data.is_empty() {
+        return false;
+    }
+    while !data.is_empty() {
+        let Some((prefix, rest)) = data.split_first_chunk::<4>() else {
+            return false;
+        };
+        let Ok(length) = usize::try_from(u32::from_be_bytes(*prefix)) else {
+            return false;
+        };
+        if length == 0 || length > rest.len() || rest[0] & 0x80 != 0 {
+            return false;
+        }
+        data = &rest[length..];
+    }
+    true
+}
+
+/// The NAL units of an Annex B byte stream, without start codes or trailing zero bytes.
+pub fn nal_units(annex_b: &[u8]) -> impl Iterator<Item = &[u8]> {
+    let mut rest = find_start_code(annex_b).map(|(_, payload)| payload);
+    core::iter::from_fn(move || {
+        loop {
+            let current = rest?;
+            let (nal, next) = match find_start_code(current) {
+                Some((start, payload)) => (&current[..start], Some(payload)),
+                None => (current, None),
+            };
+            rest = next;
+            // Zero bytes before a start code are trailing_zero_8bits (or the first byte of a 4-byte start code),
+            // not part of the NAL unit, whose last byte is never zero.
+            let end = nal.iter().rposition(|&byte| byte != 0).map_or(0, |last| last + 1);
+            if end > 0 {
+                return Some(&nal[..end]);
+            }
+        }
+    })
+}
+
+/// Finds the first `00 00 01`; returns its offset and what follows it.
+fn find_start_code(data: &[u8]) -> Option<(usize, &[u8])> {
+    data.windows(3)
+        .position(|window| window == [0, 0, 1])
+        .map(|start| (start, &data[start + 3..]))
+}
+
+fn nal_type(nal: &[u8]) -> Option<u8> {
+    nal.first().map(|header| header & 0x1F)
+}
+
+/// Whether the access unit contains an IDR picture, which a decoder can start from.
+#[must_use]
+pub fn is_key_frame(annex_b: &[u8]) -> bool {
+    nal_units(annex_b).any(|nal| nal_type(nal) == Some(NAL_TYPE_IDR))
+}
+
+/// Declares, in each sequence parameter set that leaves it open, that pictures are output in decoding order.
+///
+/// Without a VUI `bitstream_restriction`, a decoder has to assume the stream may reorder pictures, and conformant
+/// ones (Chromium's, which drives VideoToolbox, VA-API and D3D11 behind WebCodecs) hold each decoded picture back
+/// until the decoded picture buffer is full. A remote desktop never sends B-frames, but encoders that omit the VUI
+/// then delay every frame by several others, and the last frame of an update is not shown until more arrive. This
+/// adds `bitstream_restriction` with `max_num_reorder_frames = 0` (and `max_dec_frame_buffering =
+/// max_num_ref_frames`), as WebRTC does for the same reason. SPSs that already carry a restriction, or that cannot
+/// be parsed, are left unchanged, and so is everything else in the stream.
+#[must_use]
+pub fn with_low_latency_output(annex_b: &[u8]) -> Cow<'_, [u8]> {
+    if !nal_units(annex_b).any(|nal| nal_type(nal) == Some(NAL_TYPE_SPS) && low_latency_sps(nal).is_some()) {
+        return Cow::Borrowed(annex_b);
+    }
+    let mut out = Vec::with_capacity(annex_b.len() + 16);
+    for nal in nal_units(annex_b) {
+        out.extend_from_slice(&[0, 0, 0, 1]);
+        match (nal_type(nal) == Some(NAL_TYPE_SPS))
+            .then(|| low_latency_sps(nal))
+            .flatten()
+        {
+            Some(rewritten) => out.extend_from_slice(&rewritten),
+            None => out.extend_from_slice(nal),
+        }
+    }
+    Cow::Owned(out)
+}
+
+/// What [`parse_sps`] reads from a sequence parameter set.
+#[derive(Debug, Clone, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct SpsInfo {
+    pub profile_idc: u8,
+    pub level_idc: u8,
+    pub max_num_ref_frames: u32,
+    pub width_in_mbs: u32,
+    pub height_in_map_units: u32,
+    /// `video_full_range_flag`, when the VUI signals the video type.
+    pub full_range: Option<bool>,
+    /// `max_num_reorder_frames` and `max_dec_frame_buffering`, when the VUI has a `bitstream_restriction`.
+    pub bitstream_restriction: Option<(u32, u32)>,
+}
+
+/// Parses a sequence parameter set NAL unit (header byte included), up to the end of its VUI.
+#[must_use]
+pub fn parse_sps(nal: &[u8]) -> Option<SpsInfo> {
+    if nal_type(nal) != Some(NAL_TYPE_SPS) {
+        return None;
+    }
+    let rbsp = unescape(&nal[1..]);
+    let mut reader = BitReader::new(&rbsp);
+    let layout = SpsLayout::read(&mut reader)?;
+    Some(layout.info)
+}
+
+/// The rewritten SPS NAL unit, or `None` when it already has a bitstream restriction or cannot be parsed.
+fn low_latency_sps(nal: &[u8]) -> Option<Vec<u8>> {
+    let rbsp = unescape(nal.get(1..)?);
+    let mut reader = BitReader::new(&rbsp);
+    let layout = SpsLayout::read(&mut reader)?;
+    if layout.info.bitstream_restriction.is_some() {
+        return None;
+    }
+
+    let mut writer = BitWriter::default();
+    // Everything before the flag that is changed stays as it was, bit for bit.
+    writer.copy_bits(&rbsp, layout.open_flag_position);
+    if !layout.has_vui {
+        writer.bit(true); // vui_parameters_present_flag
+        writer.bit(false); // aspect_ratio_info_present_flag
+        writer.bit(false); // overscan_info_present_flag
+        writer.bit(false); // video_signal_type_present_flag
+        writer.bit(false); // chroma_loc_info_present_flag
+        writer.bit(false); // timing_info_present_flag
+        writer.bit(false); // nal_hrd_parameters_present_flag
+        writer.bit(false); // vcl_hrd_parameters_present_flag
+        writer.bit(false); // pic_struct_present_flag
+    }
+    writer.bit(true); // bitstream_restriction_flag
+    writer.bit(true); // motion_vectors_over_pic_boundaries_flag
+    writer.ue(2); // max_bytes_per_pic_denom (the inferred default)
+    writer.ue(1); // max_bits_per_mb_denom (the inferred default)
+    writer.ue(16); // log2_max_mv_length_horizontal
+    writer.ue(16); // log2_max_mv_length_vertical
+    writer.ue(0); // max_num_reorder_frames
+    writer.ue(layout.info.max_num_ref_frames.max(1)); // max_dec_frame_buffering
+    writer.bit(true); // rbsp_stop_one_bit
+    let rbsp = writer.finish();
+
+    let mut out = Vec::with_capacity(rbsp.len() + 8);
+    out.push(nal[0]);
+    escape_into(&rbsp, &mut out);
+    Some(out)
+}
+
+/// An SPS as far as this module needs it.
+struct SpsLayout {
+    info: SpsInfo,
+    has_vui: bool,
+    /// Bit position of the flag to set: `vui_parameters_present_flag` without a VUI, else
+    /// `bitstream_restriction_flag`.
+    open_flag_position: usize,
+}
+
+const MAX_UE: u32 = 1 << 16;
+
+impl SpsLayout {
+    fn read(r: &mut BitReader<'_>) -> Option<Self> {
+        let profile_idc = u8::try_from(r.bits(8)?).ok()?;
+        r.bits(8)?; // constraint_set flags, reserved_zero_2bits
+        let level_idc = u8::try_from(r.bits(8)?).ok()?;
+        r.ue()?; // seq_parameter_set_id
+        if matches!(
+            profile_idc,
+            100 | 110 | 122 | 244 | 44 | 83 | 86 | 118 | 128 | 138 | 139 | 134 | 135
+        ) {
+            let chroma_format_idc = r.ue()?;
+            if chroma_format_idc == 3 {
+                r.bits(1)?; // separate_colour_plane_flag
+            }
+            r.ue()?; // bit_depth_luma_minus8
+            r.ue()?; // bit_depth_chroma_minus8
+            r.bits(1)?; // qpprime_y_zero_transform_bypass_flag
+            if r.flag()? {
+                // seq_scaling_matrix_present_flag
+                let lists = if chroma_format_idc == 3 { 12 } else { 8 };
+                for index in 0..lists {
+                    if r.flag()? {
+                        skip_scaling_list(r, if index < 6 { 16 } else { 64 })?;
+                    }
+                }
+            }
+        }
+        r.ue()?; // log2_max_frame_num_minus4
+        match r.ue()? {
+            // pic_order_cnt_type
+            0 => {
+                r.ue()?; // log2_max_pic_order_cnt_lsb_minus4
+            }
+            1 => {
+                r.bits(1)?; // delta_pic_order_always_zero_flag
+                r.se()?; // offset_for_non_ref_pic
+                r.se()?; // offset_for_top_to_bottom_field
+                let cycle = r.ue()?;
+                if cycle > 255 {
+                    return None;
+                }
+                for _ in 0..cycle {
+                    r.se()?; // offset_for_ref_frame
+                }
+            }
+            2 => {}
+            _ => return None,
+        }
+        let max_num_ref_frames = r.ue()?;
+        r.bits(1)?; // gaps_in_frame_num_value_allowed_flag
+        let width_in_mbs = r.ue()?.checked_add(1)?;
+        let height_in_map_units = r.ue()?.checked_add(1)?;
+        if !r.flag()? {
+            // frame_mbs_only_flag
+            r.bits(1)?; // mb_adaptive_frame_field_flag
+        }
+        r.bits(1)?; // direct_8x8_inference_flag
+        if r.flag()? {
+            // frame_cropping_flag
+            for _ in 0..4 {
+                r.ue()?;
+            }
+        }
+
+        let mut info = SpsInfo {
+            profile_idc,
+            level_idc,
+            max_num_ref_frames,
+            width_in_mbs,
+            height_in_map_units,
+            full_range: None,
+            bitstream_restriction: None,
+        };
+        let vui_flag_position = r.position();
+        if !r.flag()? {
+            return Some(Self {
+                info,
+                has_vui: false,
+                open_flag_position: vui_flag_position,
+            });
+        }
+
+        if r.flag()? {
+            // aspect_ratio_info_present_flag
+            if r.bits(8)? == 255 {
+                r.bits(16)?; // sar_width
+                r.bits(16)?; // sar_height
+            }
+        }
+        if r.flag()? {
+            // overscan_info_present_flag
+            r.bits(1)?;
+        }
+        if r.flag()? {
+            // video_signal_type_present_flag
+            r.bits(3)?; // video_format
+            info.full_range = Some(r.flag()?);
+            if r.flag()? {
+                // colour_description_present_flag
+                r.bits(24)?;
+            }
+        }
+        if r.flag()? {
+            // chroma_loc_info_present_flag
+            r.ue()?;
+            r.ue()?;
+        }
+        if r.flag()? {
+            // timing_info_present_flag
+            r.bits(32)?;
+            r.bits(32)?;
+            r.bits(1)?;
+        }
+        let nal_hrd = r.flag()?;
+        if nal_hrd {
+            skip_hrd_parameters(r)?;
+        }
+        let vcl_hrd = r.flag()?;
+        if vcl_hrd {
+            skip_hrd_parameters(r)?;
+        }
+        if nal_hrd || vcl_hrd {
+            r.bits(1)?; // low_delay_hrd_flag
+        }
+        r.bits(1)?; // pic_struct_present_flag
+        let restriction_flag_position = r.position();
+        if r.flag()? {
+            r.bits(1)?; // motion_vectors_over_pic_boundaries_flag
+            r.ue()?; // max_bytes_per_pic_denom
+            r.ue()?; // max_bits_per_mb_denom
+            r.ue()?; // log2_max_mv_length_horizontal
+            r.ue()?; // log2_max_mv_length_vertical
+            let reorder = r.ue()?;
+            let buffering = r.ue()?;
+            info.bitstream_restriction = Some((reorder, buffering));
+        }
+        Some(Self {
+            info,
+            has_vui: true,
+            open_flag_position: restriction_flag_position,
+        })
+    }
+}
+
+fn skip_scaling_list(r: &mut BitReader<'_>, size: usize) -> Option<()> {
+    let mut last_scale = 8i64;
+    let mut next_scale = 8i64;
+    for _ in 0..size {
+        if next_scale != 0 {
+            let delta = i64::from(r.se()?);
+            next_scale = (last_scale + delta + 256).rem_euclid(256);
+        }
+        if next_scale != 0 {
+            last_scale = next_scale;
+        }
+    }
+    Some(())
+}
+
+fn skip_hrd_parameters(r: &mut BitReader<'_>) -> Option<()> {
+    let cpb_count = r.ue()?.checked_add(1)?;
+    if cpb_count > 32 {
+        return None;
+    }
+    r.bits(4)?; // bit_rate_scale
+    r.bits(4)?; // cpb_size_scale
+    for _ in 0..cpb_count {
+        r.ue()?; // bit_rate_value_minus1
+        r.ue()?; // cpb_size_value_minus1
+        r.bits(1)?; // cbr_flag
+    }
+    r.bits(20)?; // four 5-bit lengths
+    Some(())
+}
+
+/// Removes emulation prevention bytes (`00 00 03` -> `00 00`).
+fn unescape(data: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(data.len());
+    let mut zeros = 0;
+    for &byte in data {
+        if zeros >= 2 && byte == 3 {
+            zeros = 0;
+            continue;
+        }
+        zeros = if byte == 0 { zeros + 1 } else { 0 };
+        out.push(byte);
+    }
+    out
+}
+
+/// Inserts emulation prevention bytes so that no start code appears inside the NAL unit.
+fn escape_into(rbsp: &[u8], out: &mut Vec<u8>) {
+    let mut zeros = 0;
+    for &byte in rbsp {
+        if zeros >= 2 && byte <= 3 {
+            out.push(3);
+            zeros = 0;
+        }
+        zeros = if byte == 0 { zeros + 1 } else { 0 };
+        out.push(byte);
+    }
+}
+
+struct BitReader<'a> {
+    data: &'a [u8],
+    position: usize,
+}
+
+impl<'a> BitReader<'a> {
+    fn new(data: &'a [u8]) -> Self {
+        Self { data, position: 0 }
+    }
+
+    fn position(&self) -> usize {
+        self.position
+    }
+
+    fn bit(&mut self) -> Option<bool> {
+        let byte = self.data.get(self.position / 8)?;
+        let bit = (byte >> (7 - self.position % 8)) & 1;
+        self.position += 1;
+        Some(bit == 1)
+    }
+
+    fn flag(&mut self) -> Option<bool> {
+        self.bit()
+    }
+
+    fn bits(&mut self, count: u32) -> Option<u32> {
+        debug_assert!(count <= 32);
+        let mut value = 0u64;
+        for _ in 0..count {
+            value = (value << 1) | u64::from(self.bit()?);
+        }
+        u32::try_from(value).ok()
+    }
+
+    /// Unsigned Exp-Golomb, bounded well above anything an SPS holds.
+    fn ue(&mut self) -> Option<u32> {
+        let mut leading_zeros = 0;
+        while !self.bit()? {
+            leading_zeros += 1;
+            if leading_zeros > 16 {
+                return None;
+            }
+        }
+        let value = (1u32 << leading_zeros) - 1 + self.bits(leading_zeros)?;
+        (value <= MAX_UE).then_some(value)
+    }
+
+    /// Signed Exp-Golomb.
+    fn se(&mut self) -> Option<i32> {
+        let code = i32::try_from(self.ue()?).ok()?;
+        Some(if code % 2 == 1 { (code + 1) / 2 } else { -(code / 2) })
+    }
+}
+
+#[derive(Default)]
+struct BitWriter {
+    data: Vec<u8>,
+    bits: usize,
+}
+
+impl BitWriter {
+    fn bit(&mut self, value: bool) {
+        if self.bits.is_multiple_of(8) {
+            self.data.push(0);
+        }
+        if value {
+            if let Some(last) = self.data.last_mut() {
+                *last |= 0x80 >> (self.bits % 8);
+            }
+        }
+        self.bits += 1;
+    }
+
+    fn copy_bits(&mut self, source: &[u8], count: usize) {
+        for position in 0..count {
+            let bit = source
+                .get(position / 8)
+                .is_some_and(|byte| (byte >> (7 - position % 8)) & 1 == 1);
+            self.bit(bit);
+        }
+    }
+
+    fn ue(&mut self, value: u32) {
+        let code = u64::from(value) + 1;
+        let length = 64 - code.leading_zeros();
+        for _ in 1..length {
+            self.bit(false);
+        }
+        for shift in (0..length).rev() {
+            self.bit((code >> shift) & 1 == 1);
+        }
+    }
+
+    /// The written bits, zero-padded to a byte boundary (the caller has written the stop bit).
+    fn finish(self) -> Vec<u8> {
+        self.data
+    }
+}
