+//! `GraphicsPipelineClient::with_external_h264`: AVC420 frames (and AVC444 main views) decoded outside the
+//! processor, whose pixels are applied (and frames acknowledged) in the order the server sent them.
+
+use ironrdp_core::{Decode as _, Encode as _, ReadCursor, WriteCursor, encode_vec};
+use ironrdp_dvc::{DvcMessage, DvcProcessor as _};
+use ironrdp_egfx::client::{GraphicsPipelineClient, GraphicsPipelineHandler};
+use ironrdp_egfx::pdu::{
+    Avc420BitmapStream, Avc420Region, Avc444BitmapStream, CapabilitiesConfirmPdu, CapabilitiesV8Flags,
+    CapabilitiesV81Flags, CapabilitiesV107Flags, CapabilitySet, CapabilityVersion, Codec1Type, Color, CreateSurfacePdu,
+    Encoding, EndFramePdu, GfxPdu, MapSurfaceToOutputPdu, PixelFormat, ResetGraphicsPdu, SolidFillPdu, StartFramePdu,
+    Timestamp, WireToSurface1Pdu, encode_avc420_bitmap_stream,
+};
+use ironrdp_graphics::zgfx::wrap_uncompressed;
+use ironrdp_pdu::geometry::ExclusiveRectangle;
+
+struct NoopHandler;
+impl GraphicsPipelineHandler for NoopHandler {}
+
+/// Advertises V10.7 (H.264 as AVC444) ahead of the default sets, as the web client does.
+struct AvcHandler;
+impl GraphicsPipelineHandler for AvcHandler {
+    fn capabilities(&self) -> Vec<CapabilitySet> {
+        vec![
+            CapabilitySet::V10_7 {
+                flags: CapabilitiesV107Flags::SMALL_CACHE,
+            },
+            CapabilitySet::V8_1 {
+                flags: CapabilitiesV81Flags::AVC420_ENABLED | CapabilitiesV81Flags::SMALL_CACHE,
+            },
+            CapabilitySet::V8 {
+                flags: CapabilitiesV8Flags::SMALL_CACHE,
+            },
+        ]
+    }
+}
+
+fn advertised(client: &mut GraphicsPipelineClient) -> Vec<CapabilityVersion> {
+    let messages = client.start(0).expect("start");
+    let encoded = encode_vec(messages[0].as_ref()).expect("encode");
+    let GfxPdu::CapabilitiesAdvertise(caps) = GfxPdu::decode(&mut ReadCursor::new(&encoded)).expect("decode") else {
+        panic!("expected CapabilitiesAdvertise");
+    };
+    caps.0.iter().map(|cap| cap.version).collect()
+}
+
+/// An AVC444 `WireToSurface1` (codec AVC444v2) with the given LC and streams.
+fn avc444(encoding: Encoding, stream1: &[u8], stream2: Option<&[u8]>) -> GfxPdu {
+    let region = [rect(0, 0, 16, 8)];
+    let quality = [ironrdp_egfx::pdu::QuantQuality {
+        quantization_parameter: 22,
+        progressive: false,
+        quality: 100,
+    }];
+    let stream = |data| Avc420BitmapStream {
+        rectangles: region.to_vec(),
+        quant_qual_vals: quality.to_vec(),
+        data,
+    };
+    let pdu = Avc444BitmapStream {
+        encoding,
+        stream1: stream(stream1),
+        stream2: stream2.map(stream),
+    };
+    let mut bitmap_data = vec![0u8; pdu.size()];
+    pdu.encode(&mut WriteCursor::new(&mut bitmap_data)).expect("encode");
+    GfxPdu::WireToSurface1(WireToSurface1Pdu {
+        surface_id: 1,
+        codec_id: Codec1Type::Avc444v2,
+        pixel_format: PixelFormat::XRgb,
+        destination_rectangle: rect(0, 0, 16, 8),
+        bitmap_data,
+    })
+}
+
+fn rect(left: u16, top: u16, right: u16, bottom: u16) -> ExclusiveRectangle {
+    ExclusiveRectangle {
+        left,
+        top,
+        right,
+        bottom,
+    }
+}
+
+fn wire(pdu: &GfxPdu) -> Vec<u8> {
+    let mut buf = vec![0u8; pdu.size()];
+    pdu.encode(&mut WriteCursor::new(&mut buf)).expect("encode");
+    wrap_uncompressed(&buf)
+}
+
+fn acks(messages: &[DvcMessage]) -> Vec<(u32, u32)> {
+    messages
+        .iter()
+        .filter_map(|message| {
+            let encoded = encode_vec(message.as_ref()).expect("encode");
+            match GfxPdu::decode(&mut ReadCursor::new(&encoded)).expect("decode") {
+                GfxPdu::FrameAcknowledge(ack) => Some((ack.frame_id, ack.queue_depth.to_u32())),
+                _ => None,
+            }
+        })
+        .collect()
+}
+
+const IDR_ACCESS_UNIT: &[u8] = &[
+    0x00, 0x00, 0x00, 0x01, 0x27, 0x64, 0x00, 0x0d, 0xac, 0x56, 0x81, 0x41, 0xf9, // SPS, no VUI
+    0x00, 0x00, 0x00, 0x01, 0x28, 0xee, 0x3c, 0xb0, // PPS
+    0x00, 0x00, 0x00, 0x01, 0x25, 0xb8, 0x00, 0x04, // IDR slice
+];
+
+/// An active client with a 16x8 surface 1 mapped at the output origin.
+fn client() -> GraphicsPipelineClient {
+    let mut client = GraphicsPipelineClient::new(Box::new(NoopHandler), None).with_external_h264();
+    let setup = [
+        GfxPdu::CapabilitiesConfirm(CapabilitiesConfirmPdu::from_typed(&CapabilitySet::V8_1 {
+            flags: CapabilitiesV81Flags::AVC420_ENABLED,
+        })),
+        GfxPdu::ResetGraphics(ResetGraphicsPdu {
+            width: 16,
+            height: 8,
+            monitors: vec![],
+        }),
+        GfxPdu::CreateSurface(CreateSurfacePdu {
+            surface_id: 1,
+            width: 16,
+            height: 8,
+            pixel_format: PixelFormat::XRgb,
+        }),
+        GfxPdu::MapSurfaceToOutput(MapSurfaceToOutputPdu {
+            surface_id: 1,
+            output_origin_x: 0,
+            output_origin_y: 0,
+        }),
+    ];
+    for pdu in setup.into_iter().chain([start(0), end(0)]) {
+        client.process(0, &wire(&pdu)).expect("setup");
+    }
+    // Mapping the surface paints it: start from a committed, drained output.
+    let _ = client.drain_output();
+    client
+}
+
+fn start(frame_id: u32) -> GfxPdu {
+    GfxPdu::StartFrame(StartFramePdu {
+        timestamp: Timestamp {
+            milliseconds: 0,
+            seconds: 0,
+            minutes: 0,
+            hours: 0,
+        },
+        frame_id,
+    })
+}
+
+fn end(frame_id: u32) -> GfxPdu {
+    GfxPdu::EndFrame(EndFramePdu { frame_id })
+}
+
+fn avc420(regions: &[Avc420Region], data: &[u8]) -> GfxPdu {
+    GfxPdu::WireToSurface1(WireToSurface1Pdu {
+        surface_id: 1,
+        codec_id: Codec1Type::Avc420,
+        pixel_format: PixelFormat::XRgb,
+        destination_rectangle: rect(0, 0, 16, 8),
+        bitmap_data: encode_avc420_bitmap_stream(regions, data),
+    })
+}
+
+fn process_all(client: &mut GraphicsPipelineClient, pdus: &[GfxPdu]) -> Vec<DvcMessage> {
+    pdus.iter()
+        .flat_map(|pdu| client.process(0, &wire(pdu)).expect("process"))
+        .collect()
+}
+
+fn solid(r: u8, rect: ExclusiveRectangle) -> Vec<u8> {
+    let pixels = usize::from(rect.right - rect.left) * usize::from(rect.bottom - rect.top);
+    [r, 0, 0, 0xff].repeat(pixels)
+}
+
+#[test]
+fn avc420_is_advertised() {
+    let mut client = GraphicsPipelineClient::new(Box::new(NoopHandler), None).with_external_h264();
+    let messages = client.start(0).expect("start");
+    let encoded = encode_vec(messages[0].as_ref()).expect("encode");
+    let GfxPdu::CapabilitiesAdvertise(caps) = GfxPdu::decode(&mut ReadCursor::new(&encoded)).expect("decode") else {
+        panic!("expected CapabilitiesAdvertise");
+    };
+    let versions: Vec<CapabilityVersion> = caps.0.iter().map(|cap| cap.version).collect();
+    assert_eq!(versions, [CapabilityVersion::V8_1, CapabilityVersion::V8]);
+}
+
+#[test]
+fn frames_are_handed_out_and_acknowledged_once_applied() {
+    let mut client = client();
+    let regions = [
+        Avc420Region::new(2, 1, 6, 3, 22, 100),
+        Avc420Region::new(10, 4, 20, 6, 22, 100),
+    ];
+    let sent = process_all(&mut client, &[start(7), avc420(&regions, IDR_ACCESS_UNIT), end(7)]);
+    assert!(acks(&sent).is_empty(), "no acknowledgement before the pixels are in");
+    assert_eq!(client.pending_h264_frames(), 1);
+
+    let frames = client.take_h264_frames();
+    assert_eq!(frames.len(), 1);
+    let frame = &frames[0];
+    assert_eq!(frame.surface_id, 1);
+    assert!(frame.key_frame);
+    // The second region is clipped to the destination rectangle.
+    assert_eq!(frame.regions, [rect(2, 1, 6, 3), rect(10, 4, 16, 6)]);
+    // The SPS now declares output in decoding order; the rest is as sent.
+    assert!(frame.data.len() > IDR_ACCESS_UNIT.len());
+    assert!(frame.data.ends_with(&IDR_ACCESS_UNIT[13..]));
+    assert!(client.take_h264_frames().is_empty());
+    assert!(client.drain_output().is_empty(), "nothing drawn yet");
+
+    let pixels = [solid(1, frame.regions[0].clone()), solid(2, frame.regions[1].clone())].concat();
+    let sent = client.complete_h264_frame(frame.id, Some(pixels)).expect("complete");
+    assert_eq!(acks(&sent), [(7, 0)]);
+    assert_eq!(client.pending_h264_frames(), 0);
+
+    let output = client.drain_output();
+    assert_eq!(output.len(), 2);
+    assert_eq!(output[0].region, rect(2, 1, 6, 3));
+    assert_eq!(output[0].data, solid(1, rect(2, 1, 6, 3)));
+    assert_eq!(output[1].region, rect(10, 4, 16, 6));
+    assert_eq!(output[1].data, solid(2, rect(10, 4, 16, 6)));
+}
+
+#[test]
+fn commands_after_a_frame_wait_for_it() {
+    let mut client = client();
+    let fill = GfxPdu::SolidFill(SolidFillPdu {
+        surface_id: 1,
+        fill_pixel: Color {
+            b: 0,
+            g: 0,
+            r: 9,
+            xa: 0xff,
+        },
+        rectangles: vec![rect(0, 0, 2, 2)],
+    });
+    process_all(
+        &mut client,
+        &[
+            start(1),
+            avc420(&[Avc420Region::full_frame(16, 8, 22)], IDR_ACCESS_UNIT),
+            fill,
+            end(1),
+        ],
+    );
+    let frame = client.take_h264_frames().remove(0);
+
+    let sent = client
+        .complete_h264_frame(frame.id, Some(solid(1, rect(0, 0, 16, 8))))
+        .expect("complete");
+    assert_eq!(acks(&sent), [(1, 0)]);
+    // The fill came after the frame, so it is on top.
+    let output = client.drain_output();
+    let whole = output
+        .iter()
+        .find(|u| u.region == rect(0, 0, 16, 8))
+        .expect("full-surface update");
+    assert_eq!(&whole.data[..4], &[9, 0, 0, 0xff]);
+    assert_eq!(&whole.data[4 * 2..4 * 3], &[1, 0, 0, 0xff]);
+}
+
+#[test]
+fn frames_complete_in_order_whatever_order_the_decoder_finishes_in() {
+    let mut client = client();
+    let full = [Avc420Region::full_frame(16, 8, 22)];
+    process_all(
+        &mut client,
+        &[
+            start(1),
+            avc420(&full, IDR_ACCESS_UNIT),
+            end(1),
+            start(2),
+            avc420(&full, &[0, 0, 0, 1, 0x21, 0x9a]),
+            end(2),
+        ],
+    );
+    let frames = client.take_h264_frames();
+    assert_eq!(frames.len(), 2);
+    assert_eq!(frames[1].id, frames[0].id + 1);
+    assert!(!frames[1].key_frame);
+
+    let sent = client
+        .complete_h264_frame(frames[1].id, Some(solid(2, rect(0, 0, 16, 8))))
+        .expect("complete second");
+    assert!(acks(&sent).is_empty(), "the first frame is not in yet");
+
+    let sent = client
+        .complete_h264_frame(frames[0].id, Some(solid(1, rect(0, 0, 16, 8))))
+        .expect("complete first");
+    // Frame 1 is acknowledged while frame 2 still waits in the queue.
+    assert_eq!(acks(&sent), [(1, 1), (2, 0)]);
+    let output = client.drain_output();
+    assert_eq!(output.last().expect("output").data, solid(2, rect(0, 0, 16, 8)));
+}
+
+#[test]
+fn a_frame_without_pixels_is_still_acknowledged() {
