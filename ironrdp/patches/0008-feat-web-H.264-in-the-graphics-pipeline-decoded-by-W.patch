@@ -0,0 +1,314 @@
+import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
+import { WebCodecsH264Decoder, h264Supported, type H264Frame } from './H264Decoder';
+
+/**
+ * WebCodecsH264Decoder against a stand-in VideoDecoder (jsdom has no WebCodecs). Pictures are width x height, and
+ * each pixel's RGBA is (x, y, id, 255), so a test can tell which picture and which pixels a region was read from.
+ * The real decoder is checked in a browser by the plugin's end-to-end suite.
+ */
+
+interface FakeChunk {
+    type: 'key' | 'delta';
+    timestamp: number;
+    data: Uint8Array;
+}
+
+class FakePicture {
+    closed = false;
+    readonly visibleRect: { x: number; y: number; width: number; height: number };
+    readonly codedWidth: number;
+    readonly codedHeight: number;
+    constructor(
+        readonly timestamp: number,
+        width: number,
+        height: number,
+        private readonly failCopy?: Error,
+    ) {
+        this.visibleRect = { x: 0, y: 0, width, height };
+        this.codedWidth = width;
+        this.codedHeight = height;
+    }
+    async copyTo(
+        into: Uint8Array,
+        options: { rect: { x: number; y: number; width: number; height: number }; format: string },
+    ): Promise<void> {
+        if (this.failCopy) {
+            throw this.failCopy;
+        }
+        expect(options.format).toBe('RGBA');
+        const { x, y, width, height } = options.rect;
+        for (let row = 0; row < height; row++) {
+            for (let col = 0; col < width; col++) {
+                into.set([x + col, y + row, this.timestamp, 255], (row * width + col) * 4);
+            }
+        }
+    }
+    close(): void {
+        this.closed = true;
+    }
+}
+
+class FakeDecoder {
+    static instances: FakeDecoder[] = [];
+    state = 'unconfigured';
+    config: VideoDecoderConfig | null = null;
+    chunks: FakeChunk[] = [];
+    constructor(readonly init: { output: (picture: FakePicture) => void; error: (error: DOMException) => void }) {
+        FakeDecoder.instances.push(this);
+    }
+    configure(config: VideoDecoderConfig): void {
+        this.config = config;
+        this.state = 'configured';
+    }
+    decode(chunk: FakeChunk): void {
+        this.chunks.push(chunk);
+    }
+    close(): void {
+        this.state = 'closed';
+    }
+    /** Outputs the picture for a chunk it was given. */
+    emit(timestamp: number, width = 64, height = 32, failCopy?: Error): FakePicture {
+        const picture = new FakePicture(timestamp, width, height, failCopy);
+        this.init.output(picture);
+        return picture;
+    }
+}
+
+class FakeChunkClass implements FakeChunk {
+    type: 'key' | 'delta';
+    timestamp: number;
+    data: Uint8Array;
+    constructor(init: FakeChunk) {
+        this.type = init.type;
+        this.timestamp = init.timestamp;
+        this.data = init.data;
+    }
+}
+
+function frame(id: number, keyFrame: boolean, regions = [{ left: 0, top: 0, right: 2, bottom: 1 }]): H264Frame {
+    return {
+        id,
+        surfaceId: 1,
+        keyFrame,
+        data: new Uint8Array([0, 0, 0, 1, keyFrame ? 0x65 : 0x41]),
+        destination: { left: 0, top: 0, right: 64, bottom: 32 },
+        regions,
+    };
+}
+
+const flush = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+describe('WebCodecsH264Decoder', () => {
+    let clock = 0;
+    let decoder: WebCodecsH264Decoder;
+    let done: ReturnType<typeof vi.fn>;
+
+    beforeEach(() => {
+        FakeDecoder.instances = [];
+        vi.stubGlobal('VideoDecoder', FakeDecoder);
+        vi.stubGlobal('EncodedVideoChunk', FakeChunkClass);
+        clock = 0;
+        done = vi.fn();
+        decoder = new WebCodecsH264Decoder({ stallMs: 1000, now: () => clock });
+    });
+
+    afterEach(() => {
+        decoder.close();
+        vi.unstubAllGlobals();
+        vi.useRealTimers();
+    });
+
+    it('configures full-range BT.709 and low latency', () => {
+        decoder.decode(frame(0, true), done);
+        const config = FakeDecoder.instances[0].config!;
+        expect(config.codec).toMatch(/^avc1\./);
+        expect(config.optimizeForLatency).toBe(true);
+        expect(config.colorSpace).toEqual({ primaries: 'bt709', transfer: 'bt709', matrix: 'bt709', fullRange: true });
+    });
+
+    it('passes over delta frames until a key frame, then decodes', () => {
+        decoder.decode(frame(0, false), done);
+        expect(done).toHaveBeenCalledWith(0, null);
+        expect(decoder.stats.skipped).toBe(1);
+
+        decoder.decode(frame(1, true), done);
+        decoder.decode(frame(2, false), done);
+        const chunks = FakeDecoder.instances[0].chunks;
+        expect(chunks.map((c) => [c.type, c.timestamp])).toEqual([
+            ['key', 1],
+            ['delta', 2],
+        ]);
+        expect(decoder.stats.pending).toBe(2);
+    });
+
+    it('hands back the pixels of each region, in turn', async () => {
+        decoder.decode(
+            frame(0, true, [
+                { left: 1, top: 2, right: 3, bottom: 3 },
+                { left: 10, top: 20, right: 11, bottom: 22 },
+            ]),
+            done,
+        );
+        const picture = FakeDecoder.instances[0].emit(0);
+        await flush();
+        expect(done).toHaveBeenCalledTimes(1);
+        const [id, pixels] = done.mock.calls[0];
+        expect(id).toBe(0);
+        // (1,2) (2,2), then (10,20) (10,21)
+        expect(Array.from(pixels as Uint8Array)).toEqual([1, 2, 0, 255, 2, 2, 0, 255, 10, 20, 0, 255, 10, 21, 0, 255]);
+        expect(picture.closed).toBe(true);
+        expect(decoder.stats.frames).toBe(1);
+        expect(decoder.stats.pending).toBe(0);
+    });
+
+    it('takes a picture the size of a destination elsewhere on the surface as starting there', async () => {
+        const offset: H264Frame = {
+            ...frame(0, true, [{ left: 105, top: 51, right: 106, bottom: 52 }]),
+            destination: { left: 100, top: 50, right: 164, bottom: 82 },
+        };
+        decoder.decode(offset, done);
+        FakeDecoder.instances[0].emit(0);
+        await flush();
+        expect(Array.from(done.mock.calls[0][1] as Uint8Array)).toEqual([5, 1, 0, 255]);
+    });
+
+    it('fails on a region larger than the picture before allocating for it', async () => {
+        const failures: string[] = [];
+        decoder.close();
+        decoder = new WebCodecsH264Decoder({ onFailure: (reason) => failures.push(reason), now: () => clock });
+        // 65535x65535 RGBA would be a 17 GB buffer.
+        decoder.decode(frame(0, true, [{ left: 0, top: 0, right: 65535, bottom: 65535 }]), done);
+        FakeDecoder.instances[0].emit(0);
+        await flush();
+        expect(done.mock.calls[0][1]).toBeNull();
+        expect(failures.join()).toMatch(/outside the 64x32 picture/);
+    });
+
+    it('completes frames the decoder never output without pixels', async () => {
+        decoder.decode(frame(0, true), done);
+        decoder.decode(frame(1, false), done);
+        decoder.decode(frame(2, false), done);
+        FakeDecoder.instances[0].emit(2);
+        await flush();
+        expect(done.mock.calls.map((call) => [call[0], call[1] === null])).toEqual([
+            [0, true],
+            [1, true],
+            [2, false],
+        ]);
+        expect(decoder.stats.dropped).toBe(2);
+    });
+
+    it('fails on a decoder error: frames in flight and later ones get the error', () => {
+        const onFailure = vi.fn();
+        decoder.close();
+        decoder = new WebCodecsH264Decoder({ onFailure, now: () => clock });
+        decoder.decode(frame(0, true), done);
+        FakeDecoder.instances[0].init.error(new DOMException('bad bitstream', 'EncodingError'));
+        expect(done).toHaveBeenCalledWith(0, null, 'EncodingError: bad bitstream');
+        expect(onFailure).toHaveBeenCalledWith('EncodingError: bad bitstream');
+        expect(FakeDecoder.instances[0].state).toBe('closed');
+
+        decoder.decode(frame(1, false), done);
+        expect(done).toHaveBeenLastCalledWith(1, null, 'EncodingError: bad bitstream');
+    });
+
+    it('tells a decoder the browser took back from one that failed', () => {
+        decoder.decode(frame(0, true), done);
+        FakeDecoder.instances[0].init.error(
+            new DOMException('Codec reclaimed due to inactivity.', 'QuotaExceededError'),
+        );
+        expect(decoder.failed).toMatch(/QuotaExceededError/);
+        expect(decoder.reclaimed).toBe(true);
+    });
+
+    it('fails when a picture does not come out in time', () => {
+        vi.useFakeTimers();
+        decoder.close();
+        decoder = new WebCodecsH264Decoder({ stallMs: 1000, now: () => clock });
+        decoder.decode(frame(0, true), done);
+        clock = 900;
+        vi.advanceTimersByTime(300);
+        expect(decoder.failed).toBeNull();
+        clock = 1100;
+        vi.advanceTimersByTime(300);
+        expect(decoder.failed).toMatch(/no picture from the decoder/);
+        expect(done).toHaveBeenCalledWith(0, null, decoder.failed);
+    });
+
+    it('fails when no key frame comes', () => {
+        vi.useFakeTimers();
+        decoder.close();
+        decoder = new WebCodecsH264Decoder({ stallMs: 1000, now: () => clock });
+        decoder.decode(frame(0, false), done);
+        clock = 1500;
+        vi.advanceTimersByTime(300);
+        expect(decoder.failed).toMatch(/no key frame/);
+    });
+
+    it('reads through a canvas where copyTo cannot convert to RGBA', async () => {
+        const drawn: unknown[] = [];
+        class FakeCanvas {
+            constructor(
+                readonly width: number,
+                readonly height: number,
+            ) {}
+            getContext() {
+                return {
+                    drawImage: (...args: unknown[]) => drawn.push(args.slice(1)),
+                    getImageData: (_x: number, _y: number, w: number, h: number) => ({
+                        data: new Uint8ClampedArray(w * h * 4).fill(7),
+                    }),
+                };
+            }
+        }
+        vi.stubGlobal('OffscreenCanvas', FakeCanvas);
+        decoder.decode(frame(0, true), done);
+        FakeDecoder.instances[0].emit(0, 64, 32, new DOMException('no RGBA', 'NotSupportedError'));
+        await flush();
+        expect(decoder.stats.readback).toBe('canvas');
+        expect(drawn).toEqual([[0, 0, 2, 1, 0, 0, 2, 1]]);
+        expect(Array.from(done.mock.calls[0][1] as Uint8Array)).toEqual([7, 7, 7, 7, 7, 7, 7, 7]);
+    });
+
+    it('decodes an AVC444 auxiliary view without reading its picture', async () => {
+        decoder.decode(frame(0, true), done);
+        decoder.decode(frame(1, false, []), done);
+        expect(FakeDecoder.instances[0].chunks.map((c) => c.timestamp)).toEqual([0, 1]);
+        FakeDecoder.instances[0].emit(0);
+        FakeDecoder.instances[0].emit(1, 64, 32, new Error('an auxiliary view is never read'));
+        await flush();
+        // Completions may come in any order (the session applies them in order).
+        const completed = done.mock.calls.map((call) => [call[0], (call[1] as Uint8Array).length]);
+        expect(completed.sort((a, b) => a[0] - b[0])).toEqual([
+            [0, 8],
+            [1, 0],
+        ]);
+        expect(decoder.stats.frames).toBe(2);
+        expect(decoder.stats.auxiliary).toBe(1);
+    });
+
+    it('keeps one decoder per surface', () => {
+        decoder.decode(frame(0, true), done);
+        decoder.decode({ ...frame(1, true), surfaceId: 2 }, done);
+        expect(FakeDecoder.instances.length).toBe(2);
+        decoder.close();
+        expect(FakeDecoder.instances.every((d) => d.state === 'closed')).toBe(true);
+    });
+});
+
+describe('h264Supported', () => {
+    afterEach(() => vi.unstubAllGlobals());
+
+    it('is false without WebCodecs', async () => {
+        vi.stubGlobal('VideoDecoder', undefined);
+        expect(await h264Supported()).toBe(false);
+    });
+
+    it('asks the browser', async () => {
+        const isConfigSupported = vi.fn(async (config: VideoDecoderConfig) => ({ supported: true, config }));
+        vi.stubGlobal('VideoDecoder', { isConfigSupported });
+        vi.stubGlobal('EncodedVideoChunk', FakeChunkClass);
+        expect(await h264Supported()).toBe(true);
+        expect(isConfigSupported.mock.calls[0][0].codec).toMatch(/^avc1\./);
+    });
+});
diff --git a/web-client/iron-remote-desktop-rdp/src/H264Decoder.ts b/web-client/iron-remote-desktop-rdp/src/H264Decoder.ts
new file mode 100644
index 00000000..c95ac01a
--- /dev/null
+++ b/web-client/iron-remote-desktop-rdp/src/H264Decoder.ts
@@ -0,0 +1,412 @@
+/**
+ * H.264 (AVC420) for the graphics pipeline, decoded with the browser's WebCodecs `VideoDecoder` (hardware-accelerated
+ * where the platform offers it). Given to a session with the `h264Decoder` extension.
+ *
+ * The session hands each AVC420 frame to `decode(frame, done)` as soon as it arrives and applies the pixels `done`
+ * returns in the order the server sent the frames: surface commands after an H.264 frame, and the acknowledgement of
+ * its graphics frame (which paces the server), wait for it. So a frame that never comes out of the decoder would
+ * freeze the picture: after `stallMs` without output, or on any decoder error, the decoder fails, which ends the
+ * session with an error. Reconnecting without H.264 is the way out.
+ */
+
+export interface H264Rectangle {
+    left: number;
+    top: number;
+    /** Exclusive. */
+    right: number;
+    /** Exclusive. */
+    bottom: number;
+}
+
+/** An H.264 access unit, as the session hands it out: AVC420, or a view of AVC444. */
+export interface H264Frame {
+    /** One more than the previous frame's. */
+    id: number;
+    /** Each surface carries its own H.264 stream. */
+    surfaceId: number;
+    /** Holds an IDR picture, which a decoder can start from. */
+    keyFrame: boolean;
+    /** Annex B byte stream. */
+    data: Uint8Array;
+    /** The destination rectangle on the surface. */
+    destination: H264Rectangle;
+    /**
+     * The rectangles to take from the picture, in surface coordinates, within `destination`. Empty for an AVC444
+     * auxiliary (chroma) view, which is decoded to keep the stream whole but not shown.
+     */
+    regions: H264Rectangle[];
+}
+
+/**
+ * Completes a frame: the RGBA of each region in turn (row-major, tightly packed), `null` for a frame that was not
+ * decoded (its regions keep their pixels), or an `error` that ends the session.
+ */
+export type H264Done = (id: number, pixels: Uint8Array | null, error?: string) => void;
+
+export interface H264DecoderStats {
+    /** Frames decoded and handed back. */
+    frames: number;
+    keyFrames: number;
+    /** Of those, AVC444 auxiliary views (decoded, not shown): a server sending them streams AVC444. */
+    auxiliary: number;
+    /** Frames passed over while waiting for a key frame. */
+    skipped: number;
+    /** Frames the decoder never output (completed without pixels). */
+    dropped: number;
+    /** Frames in the decoders now. */
+    pending: number;
+    /** Time from `decode` to the pixels being handed back, for the last frame and the slowest one. */
+    lastLatencyMs: number;
+    maxLatencyMs: number;
+    /** How pixels are read from decoded pictures: `VideoFrame.copyTo` or a canvas. */
+    readback: 'copyTo' | 'canvas';
+}
+
+export interface WebCodecsH264DecoderOptions {
+    /** A frame that has not come out of the decoder after this long fails the decoder (default 3000 ms). */
+    stallMs?: number;
+    /** Called once, when the decoder fails. */
+    onFailure?: (reason: string) => void;
+    /** Clock, in milliseconds (tests). */
+    now?: () => number;
+}
+
+/**
+ * High profile, level 5.1: pictures up to 4096x2304. GNOME Remote Desktop encodes constrained High; decoders take
+ * Main and Constrained Baseline streams too.
+ */
+const CODEC = 'avc1.640033';
+
+/**
+ * MS-RDPEGFX 3.3.8.3.1: AVC420 carries full-range BT.709 whatever the bitstream signals (Windows doesn't signal it),
+ * so it overrides what the stream says.
+ */
+function decoderConfig(): VideoDecoderConfig {
+    return {
+        codec: CODEC,
+        optimizeForLatency: true,
+        hardwareAcceleration: 'no-preference',
+        colorSpace: { primaries: 'bt709', transfer: 'bt709', matrix: 'bt709', fullRange: true },
+    };
+}
+
+/** Whether this browser can decode the H.264 the graphics pipeline carries. */
+export async function h264Supported(): Promise<boolean> {
+    if (typeof VideoDecoder === 'undefined' || typeof EncodedVideoChunk === 'undefined') {
+        return false;
+    }
+    try {
+        const support = await VideoDecoder.isConfigSupported(decoderConfig());
+        return support.supported === true;
+    } catch {
+        return false;
+    }
+}
+
+interface Pending {
+    frame: H264Frame;
+    done: H264Done;
+    since: number;
+}
+
+interface Surface {
+    decoder: VideoDecoder;
+    /** A new decoder starts at a key frame. */
+    needKey: boolean;
+    /** Since when frames were passed over waiting for a key frame (null: not waiting). */
+    waitingSince: number | null;
+    pending: Map<number, Pending>;
+}
+
+export class WebCodecsH264Decoder {
+    readonly stats: H264DecoderStats = {
+        frames: 0,
+        keyFrames: 0,
+        auxiliary: 0,
+        skipped: 0,
+        dropped: 0,
+        pending: 0,
+        lastLatencyMs: 0,
+        maxLatencyMs: 0,
+        readback: 'copyTo',
+    };
+    /** Why the decoder failed, once it has. */
+    failed: string | null = null;
+    /**
+     * The failure was the browser taking an idle decoder back (WebCodecs codec reclamation, in a hidden page with
+     * many decoders around), not a decoding problem: a new session can use H.264 again.
+     */
+    reclaimed = false;
+
+    private readonly surfaces = new Map<number, Surface>();
+    private readonly stallMs: number;
+    private readonly now: () => number;
+    private watchdog: ReturnType<typeof setInterval> | null = null;
+    private canvas: OffscreenCanvas | null = null;
+    private closed = false;
+
+    constructor(private readonly options: WebCodecsH264DecoderOptions = {}) {
+        this.stallMs = options.stallMs ?? 3000;
+        this.now = options.now ?? (() => performance.now());
+    }
+
+    decode(frame: H264Frame, done: H264Done): void {
+        if (this.failed !== null || this.closed) {
+            done(frame.id, null, this.failed ?? 'the H.264 decoder is closed');
+            return;
+        }
+        this.watchdog ??= setInterval(() => this.checkStalls(), Math.min(250, this.stallMs));
+        const surface = this.surfaces.get(frame.surfaceId) ?? this.open(frame.surfaceId);
+        if (surface.needKey && !frame.keyFrame) {
+            // Deltas mean nothing to a decoder that hasn't seen the picture they refer to.
+            this.stats.skipped++;
+            if (surface.waitingSince === null) {
+                surface.waitingSince = this.now();
+            }
+            done(frame.id, null);
+            return;
+        }
+        surface.needKey = false;
+        surface.waitingSince = null;
+        if (frame.keyFrame) {
+            this.stats.keyFrames++;
+        }
+        surface.pending.set(frame.id, { frame, done, since: this.now() });
+        this.stats.pending++;
+        try {
+            surface.decoder.decode(
+                new EncodedVideoChunk({
+                    type: frame.keyFrame ? 'key' : 'delta',
+                    timestamp: frame.id,
+                    data: frame.data,
+                }),
+            );
+        } catch (error) {
+            this.fail(`decode: ${describe(error)}`);
+        }
+    }
+
+    close(): void {
+        this.closed = true;
+        this.stopWatchdog();
+        for (const surface of this.surfaces.values()) {
+            closeDecoder(surface.decoder);
+        }
+        this.surfaces.clear();
+        this.stats.pending = 0;
+    }
+
+    private open(surfaceId: number): Surface {
+        const surface: Surface = {
+            decoder: new VideoDecoder({
+                output: (picture) => this.output(surface, picture),
+                error: (error) => {
+                    this.reclaimed = error.name === 'QuotaExceededError';
+                    this.fail(describe(error));
+                },
+            }),
+            needKey: true,
+            waitingSince: null,
+            pending: new Map(),
+        };
+        surface.decoder.configure(decoderConfig());
+        this.surfaces.set(surfaceId, surface);
+        return surface;
+    }
+
+    private output(surface: Surface, picture: VideoFrame): void {
+        const id = picture.timestamp;
+        const pending = surface.pending.get(id);
+        if (pending === undefined || this.failed !== null || this.closed) {
+            picture.close();
+            return;
+        }
+        // Pictures come out in decoding order: frames before this one that never came out won't.
+        for (const [earlier, dropped] of surface.pending) {
+            if (earlier >= id) {
+                break;
+            }
+            surface.pending.delete(earlier);
+            this.stats.pending--;
+            this.stats.dropped++;
+            dropped.done(earlier, null);
+        }
+        surface.pending.delete(id);
+        this.stats.pending--;
+        this.readRegions(picture, pending.frame).then(
+            (pixels) => {
+                picture.close();
+                if (this.failed !== null || this.closed) {
+                    return;
+                }
+                const latency = this.now() - pending.since;
+                this.stats.frames++;
+                if (pending.frame.regions.length === 0) {
+                    this.stats.auxiliary++;
+                }
+                this.stats.lastLatencyMs = latency;
+                this.stats.maxLatencyMs = Math.max(this.stats.maxLatencyMs, latency);
+                pending.done(id, pixels);
+            },
+            (error) => {
+                picture.close();
+                this.fail(`reading the picture: ${describe(error)}`);
+                pending.done(id, null, this.failed ?? undefined);
+            },
+        );
+    }
+
+    /** The RGBA of the frame's regions, in turn. */
+    private async readRegions(picture: VideoFrame, frame: H264Frame): Promise<Uint8Array> {
+        const visible = picture.visibleRect ?? { x: 0, y: 0, width: picture.codedWidth, height: picture.codedHeight };
+        // Servers send pictures that cover the surface from its origin, as FreeRDP assumes; a picture only the size
+        // of a destination elsewhere on the surface starts at the destination.
+        const d = frame.destination;
+        const [ox, oy] = visible.width >= d.right && visible.height >= d.bottom ? [0, 0] : [d.left, d.top];
+        const rects = frame.regions.map((r) => ({
+            x: r.left - ox,
+            y: r.top - oy,
+            width: r.right - r.left,
+            height: r.bottom - r.top,
+        }));
+        // Checked before anything is allocated: a region larger than the picture would otherwise size the buffer.
+        // (ironrdp-egfx bounds what the regions add up to: at most their surface, once.)
+        for (const r of rects) {
+            if (r.x < 0 || r.y < 0 || r.x + r.width > visible.width || r.y + r.height > visible.height) {
+                throw new Error(
+                    `region ${JSON.stringify(r)} is outside the ${visible.width}x${visible.height} picture`,
+                );
+            }
+        }
+        const total = rects.reduce((sum, r) => sum + r.width * r.height * 4, 0);
+        const out = new Uint8Array(total);
+        if (rects.length === 0) {
+            return out;
+        }
+        // One readback for all regions: their bounding box.
+        const left = Math.min(...rects.map((r) => r.x));
+        const top = Math.min(...rects.map((r) => r.y));
+        const box = {
+            x: left,
+            y: top,
+            width: Math.max(...rects.map((r) => r.x + r.width)) - left,
+            height: Math.max(...rects.map((r) => r.y + r.height)) - top,
+        };
+        const single = rects.length === 1;
+        const boxPixels = single ? out : new Uint8Array(box.width * box.height * 4);
+        await this.readBox(picture, visible, box, boxPixels);
+        if (!single) {
+            let offset = 0;
+            for (const r of rects) {
+                const row = r.width * 4;
+                for (let y = 0; y < r.height; y++) {
+                    const from = ((r.y - box.y + y) * box.width + (r.x - box.x)) * 4;
+                    out.set(boxPixels.subarray(from, from + row), offset);
+                    offset += row;
+                }
+            }
+        }
+        return out;
+    }
+
+    private async readBox(
+        picture: VideoFrame,
+        visible: { x: number; y: number },
+        box: { x: number; y: number; width: number; height: number },
+        into: Uint8Array,
+    ): Promise<void> {
+        if (this.stats.readback === 'copyTo') {
+            try {
+                await picture.copyTo(into, {
+                    rect: { x: visible.x + box.x, y: visible.y + box.y, width: box.width, height: box.height },
+                    format: 'RGBA',
+                    colorSpace: 'srgb',
+                });
+                return;
+            } catch (error) {
+                // Converting to RGBA in copyTo came late to browsers; a canvas does the same.
+                if (
+                    !(error instanceof DOMException && error.name === 'NotSupportedError') &&
+                    !(error instanceof TypeError)
+                ) {
+                    throw error;
+                }
+                this.stats.readback = 'canvas';
+            }
+        }
+        if (this.canvas === null || this.canvas.width < box.width || this.canvas.height < box.height) {
+            this.canvas = new OffscreenCanvas(
+                Math.max(box.width, this.canvas?.width ?? 0),
+                Math.max(box.height, this.canvas?.height ?? 0),
+            );
+        }
+        const context = this.canvas.getContext('2d', { willReadFrequently: true, colorSpace: 'srgb' });
+        if (context === null) {
+            throw new Error('no 2D canvas context');
+        }
+        context.drawImage(picture, box.x, box.y, box.width, box.height, 0, 0, box.width, box.height);
+        into.set(context.getImageData(0, 0, box.width, box.height).data);
+    }
+
+    private stopWatchdog(): void {
+        if (this.watchdog !== null) {
+            clearInterval(this.watchdog);
+            this.watchdog = null;
+        }
+    }
+
+    private checkStalls(): void {
+        if (this.failed !== null || this.closed) {
+            return;
+        }
+        const now = this.now();
+        for (const surface of this.surfaces.values()) {
+            if (surface.waitingSince !== null && now - surface.waitingSince > this.stallMs) {
+                this.fail(`no key frame for ${Math.round(now - surface.waitingSince)} ms`);
+                return;
+            }
+            for (const pending of surface.pending.values()) {
+                if (now - pending.since > this.stallMs) {
+                    this.fail(`no picture from the decoder for ${Math.round(now - pending.since)} ms`);
+                    return;
+                }
+            }
+        }
+    }
+
+    /** Fails for good: every frame in flight completes with the error, which ends the session. */
+    private fail(reason: string): void {
+        if (this.failed !== null || this.closed) {
+            return;
+        }
+        this.failed = reason;
+        this.stopWatchdog();
+        const pending = [...this.surfaces.values()].flatMap((surface) => [...surface.pending.values()]);
+        for (const surface of this.surfaces.values()) {
+            closeDecoder(surface.decoder);
+        }
+        this.surfaces.clear();
+        this.stats.pending = 0;
+        this.options.onFailure?.(reason);
+        for (const { frame, done } of pending) {
+            done(frame.id, null, reason);
+        }
+    }
+}
+
+function closeDecoder(decoder: VideoDecoder): void {
+    if (decoder.state !== 'closed') {
+        try {
+            decoder.close();
+        } catch {
+            // Already closing.
+        }
+    }
+}
+
+function describe(error: unknown): string {
+    if (error instanceof Error || error instanceof DOMException) {
+        return `${error.name}: ${error.message}`;
+    }
+    return String(error);
+}
