+use std::borrow::Cow;
+
+use ironrdp_egfx::h264::{is_key_frame, nal_units, parse_sps, to_annex_b, with_low_latency_output};
+
+/// SPS from macOS VideoToolbox (High, 320x240): no VUI at all.
+const SPS_WITHOUT_VUI: &[u8] = &[0x27, 0x64, 0x00, 0x0d, 0xac, 0x56, 0x81, 0x41, 0xf9];
+
+/// SPS from macOS VideoToolbox (High, 1920x1080, full-range BT.709): a VUI without `bitstream_restriction`.
+const SPS_WITH_VUI: &[u8] = &[
+    0x27, 0x64, 0x00, 0x28, 0xac, 0x56, 0x80, 0x78, 0x02, 0x27, 0xe5, 0x9b, 0x81, 0x01, 0x00, 0x81,
+];
+
+/// SPS from x264 (High, 320x240), which declares `max_num_reorder_frames = 0` itself.
+const SPS_WITH_RESTRICTION: &[u8] = &[
+    0x67, 0x64, 0x00, 0x0d, 0xac, 0xb2, 0x02, 0x83, 0xf6, 0x02, 0x20, 0x00, 0x00, 0x03, 0x00, 0x20, 0x00, 0x00, 0x07,
+    0x91, 0xe2, 0x85, 0x49,
+];
+
+/// The x264 SPS with its `bitstream_restriction` taken out: timing info with emulation prevention in the VUI.
+const SPS_WITH_TIMING: &[u8] = &[
+    0x67, 0x64, 0x00, 0x0d, 0xac, 0xb2, 0x02, 0x83, 0xf6, 0x02, 0x20, 0x00, 0x00, 0x03, 0x00, 0x20, 0x00, 0x00, 0x07,
+    0x90, 0x80,
+];
+
+fn annex_b(nals: &[&[u8]]) -> Vec<u8> {
+    nals.iter().flat_map(|nal| [&[0, 0, 0, 1][..], nal].concat()).collect()
+}
+
+fn sps_of(stream: &[u8]) -> Vec<u8> {
+    nal_units(stream)
+        .find(|nal| nal[0] & 0x1f == 7)
+        .expect("stream has an SPS")
+        .to_vec()
+}
+
+const PPS: &[u8] = &[0x28, 0xee, 0x3c, 0xb0];
+const IDR: &[u8] = &[0x25, 0xb8, 0x00, 0x04];
+const NON_IDR: &[u8] = &[0x21, 0x9a, 0x02, 0x04];
+
+#[test]
+fn annex_b_input_is_left_as_is() {
+    let stream = annex_b(&[SPS_WITHOUT_VUI, PPS, IDR]);
+    assert!(matches!(to_annex_b(&stream), Cow::Borrowed(_)));
+}
+
+#[test]
+fn length_prefixed_input_is_converted_to_annex_b() {
+    let mut avc = Vec::new();
+    for nal in [SPS_WITHOUT_VUI, PPS, IDR] {
+        avc.extend_from_slice(&u32::try_from(nal.len()).unwrap().to_be_bytes());
+        avc.extend_from_slice(nal);
+    }
+    assert_eq!(
+        to_annex_b(&avc).as_ref(),
+        annex_b(&[SPS_WITHOUT_VUI, PPS, IDR]).as_slice()
+    );
+}
+
+#[test]
+fn a_leading_start_code_wins_over_a_length_chain() {
+    // 00 00 00 01 is also a valid 1-byte length prefix here; MS-RDPEGFX specifies Annex B.
+    let stream = [0x00, 0x00, 0x00, 0x01, 0x09, 0x00, 0x00, 0x00, 0x01, 0x10];
+    assert!(matches!(to_annex_b(&stream), Cow::Borrowed(_)));
+}
+
+#[test]
+fn nal_units_split_on_three_and_four_byte_start_codes() {
+    let stream = [
+        0x00, 0x00, 0x00, 0x01, 0x09, 0xf0, // AUD
+        0x00, 0x00, 0x01, 0x67, 0x42, 0x00, 0x00, // SPS-ish, then a trailing zero byte
+        0x00, 0x00, 0x01, 0x65, 0x88,
+    ];
+    let units: Vec<&[u8]> = nal_units(&stream).collect();
+    assert_eq!(units, [&[0x09, 0xf0][..], &[0x67, 0x42][..], &[0x65, 0x88][..]]);
+}
+
+#[test]
+fn key_frames_hold_an_idr_picture() {
+    assert!(is_key_frame(&annex_b(&[SPS_WITHOUT_VUI, PPS, IDR])));
+    assert!(!is_key_frame(&annex_b(&[NON_IDR])));
+    assert!(!is_key_frame(&[]));
+}
+
+#[test]
+fn sps_fields_are_parsed() {
+    let info = parse_sps(SPS_WITH_VUI).expect("parses");
+    assert_eq!(info.profile_idc, 100);
+    assert_eq!(info.level_idc, 40);
+    assert_eq!(info.max_num_ref_frames, 1);
+    assert_eq!((info.width_in_mbs, info.height_in_map_units), (120, 68));
+    assert_eq!(info.full_range, Some(true));
+    assert_eq!(info.bitstream_restriction, None);
+
+    let info = parse_sps(SPS_WITH_RESTRICTION).expect("parses");
+    assert_eq!(info.bitstream_restriction, Some((0, 3)));
+    assert_eq!((info.width_in_mbs, info.height_in_map_units), (20, 15));
+}
+
+#[test]
+fn an_sps_without_vui_gets_one_that_declares_no_reordering() {
+    let stream = annex_b(&[SPS_WITHOUT_VUI, PPS, IDR]);
+    let rewritten = with_low_latency_output(&stream);
+    let sps = sps_of(&rewritten);
+    // Checked against FFmpeg's trace_headers, which reads the same fields back.
+    assert_eq!(
+        sps,
+        [
+            0x27, 0x64, 0x00, 0x0d, 0xac, 0x56, 0x81, 0x41, 0xfa, 0x01, 0xb4, 0x11, 0x08, 0xd4
+        ]
+    );
+    let info = parse_sps(&sps).expect("parses");
+    assert_eq!(info.bitstream_restriction, Some((0, 1)));
+    assert_eq!((info.width_in_mbs, info.height_in_map_units), (20, 15));
+
+    // The other NAL units are untouched.
+    let units: Vec<&[u8]> = nal_units(&rewritten).collect();
+    assert_eq!(&units[1..], [PPS, IDR]);
+}
+
+#[test]
+fn a_vui_without_restriction_keeps_its_fields() {
+    let stream = annex_b(&[SPS_WITH_VUI]);
+    let rewritten = with_low_latency_output(&stream);
+    let info = parse_sps(&sps_of(&rewritten)).expect("parses");
+    assert_eq!(info.full_range, Some(true));
+    assert_eq!(info.bitstream_restriction, Some((0, 1)));
+    assert_eq!((info.width_in_mbs, info.height_in_map_units), (120, 68));
+}
+
+#[test]
+fn emulation_prevention_survives_the_rewrite() {
+    let stream = annex_b(&[SPS_WITH_TIMING]);
+    let rewritten = with_low_latency_output(&stream);
+    let sps = sps_of(&rewritten);
+    assert_eq!(
+        sps,
+        [
+            0x67, 0x64, 0x00, 0x0d, 0xac, 0xb2, 0x02, 0x83, 0xf6, 0x02, 0x20, 0x00, 0x00, 0x03, 0x00, 0x20, 0x00, 0x00,
+            0x07, 0x91, 0xb4, 0x11, 0x08, 0xc9
+        ]
+    );
+    assert_eq!(parse_sps(&sps).expect("parses").bitstream_restriction, Some((0, 3)));
+}
+
+#[test]
+fn streams_that_already_declare_their_reordering_are_left_alone() {
+    let stream = annex_b(&[SPS_WITH_RESTRICTION, PPS, IDR]);
+    assert!(matches!(with_low_latency_output(&stream), Cow::Borrowed(_)));
+    let delta = annex_b(&[NON_IDR]);
+    assert!(matches!(with_low_latency_output(&delta), Cow::Borrowed(_)));
+}
+
+#[test]
+fn a_truncated_sps_is_left_alone() {
+    let stream = annex_b(&[&SPS_WITH_VUI[..6], PPS, IDR]);
+    assert!(parse_sps(&SPS_WITH_VUI[..6]).is_none());
+    assert!(matches!(with_low_latency_output(&stream), Cow::Borrowed(_)));
+}
