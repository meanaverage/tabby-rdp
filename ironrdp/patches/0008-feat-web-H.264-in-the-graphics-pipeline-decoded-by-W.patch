+    let mut acknowledged = Vec::new();
+    for frame in &frames {
+        let pixels =
+            (!frame.regions.is_empty()).then(|| solid(u8::try_from(frame.id).expect("small id"), rect(0, 0, 16, 8)));
+        let pixels = pixels.unwrap_or_default();
+        acknowledged.extend(acks(
+            &client.complete_h264_frame(frame.id, Some(pixels)).expect("complete"),
+        ));
+    }
+    // Each acknowledgement counts the frames still waiting behind it.
+    assert_eq!(acknowledged, [(1, 2), (2, 1), (3, 0)]);
+    // The last picture shown is the second main view; the auxiliary views leave the surface alone.
+    let output = client.drain_output();
+    let last = output.last().expect("output");
+    assert_eq!(
+        last.data,
