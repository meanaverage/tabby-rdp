+        surface_id,
+        codec_id: Codec1Type::Avc420,
+        pixel_format: PixelFormat::XRgb,
+        destination_rectangle: destination,
+        bitmap_data: encode_avc420_bitmap_stream(regions, IDR_ACCESS_UNIT),
+    })
