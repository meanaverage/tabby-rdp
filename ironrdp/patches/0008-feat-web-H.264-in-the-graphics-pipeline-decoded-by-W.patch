+//! H.264 through a JavaScript decoder: the `h264_decoder` extension.
+//!
+//! The graphics pipeline hands each H.264 access unit out ([`GraphicsPipelineClient::with_external_h264`]); the
+//! session loop passes it to the decoder object given with the extension (in practice a WebCodecs `VideoDecoder`,
+//! which is asynchronous and often hardware-accelerated). The decoder calls back with the pixels of the frame's
+//! regions, which come back to the session loop as an [`RdpInputEvent::H264Decoded`] and complete the frame.
+//!
+//! The decoder object has `decode(frame, done)` and optionally `close()`. `frame` is `{ id, surfaceId, keyFrame,
+//! data: Uint8Array, destination: { left, top, right, bottom }, regions: [{ left, top, right, bottom }] }`
+//! (Annex B; rectangles in surface coordinates, exclusive right/bottom). `done(id, pixels, error)` takes the RGBA of
+//! each region in turn as one `Uint8Array`, or `null` for a frame that was not decoded; an `error` string ends the
+//! session.
+//!
+//! [`GraphicsPipelineClient::with_external_h264`]: ironrdp_egfx::client::GraphicsPipelineClient::with_external_h264
+
+use anyhow::Context as _;
+use futures_channel::mpsc;
+use ironrdp_egfx::client::H264Frame;
+use ironrdp_pdu::geometry::ExclusiveRectangle;
+use tracing::warn;
+use wasm_bindgen::JsCast as _;
+use wasm_bindgen::prelude::*;
+
+use crate::session::RdpInputEvent;
+
+pub(crate) struct JsH264Decoder {
+    decoder: JsValue,
+    decode: js_sys::Function,
+    done: Closure<dyn FnMut(u32, JsValue, JsValue)>,
+}
+
+impl JsH264Decoder {
+    pub(crate) fn new(decoder: JsValue, events: mpsc::UnboundedSender<RdpInputEvent>) -> anyhow::Result<Self> {
+        let decode = js_sys::Reflect::get(&decoder, &JsValue::from_str("decode"))
+            .ok()
+            .and_then(|decode| decode.dyn_into::<js_sys::Function>().ok())
+            .context("the H.264 decoder has no decode function")?;
+        let done = Closure::new(move |id: u32, pixels: JsValue, error: JsValue| {
+            let event = RdpInputEvent::H264Decoded {
+                id,
+                pixels: pixels.dyn_ref::<js_sys::Uint8Array>().map(js_sys::Uint8Array::to_vec),
+                error: error.as_string(),
+            };
+            if events.unbounded_send(event).is_err() {
+                warn!(id, "Decoded H.264 frame dropped: the session loop is gone");
+            }
+        });
+        Ok(Self { decoder, decode, done })
+    }
+
+    pub(crate) fn decode(&self, frame: H264Frame) -> anyhow::Result<()> {
+        let object = js_sys::Object::new();
+        let set = |key: &str, value: JsValue| {
+            let _ = js_sys::Reflect::set(&object, &JsValue::from_str(key), &value);
+        };
+        set("id", JsValue::from(frame.id));
+        set("surfaceId", JsValue::from(frame.surface_id));
+        set("keyFrame", JsValue::from(frame.key_frame));
+        set("data", js_sys::Uint8Array::from(frame.data.as_slice()).into());
+        set("destination", rectangle(&frame.destination_rectangle));
+        set(
+            "regions",
+            frame.regions.iter().map(rectangle).collect::<js_sys::Array>().into(),
+        );
+        self.decode
+            .call2(&self.decoder, &object, self.done.as_ref())
+            .map_err(|error| anyhow::anyhow!("H.264 decoder: {error:?}"))?;
+        Ok(())
+    }
+}
+
+impl Drop for JsH264Decoder {
+    fn drop(&mut self) {
+        // The session is over: release the decoder (hardware decoders are a limited resource).
+        let close = js_sys::Reflect::get(&self.decoder, &JsValue::from_str("close"))
+            .ok()
+            .and_then(|close| close.dyn_into::<js_sys::Function>().ok());
+        if let Some(close) = close {
+            if let Err(error) = close.call0(&self.decoder) {
+                warn!(?error, "Closing the H.264 decoder failed");
+            }
+        }
+    }
+}
+
+fn rectangle(rect: &ExclusiveRectangle) -> JsValue {
+    let object = js_sys::Object::new();
+    for (key, value) in [
+        ("left", rect.left),
+        ("top", rect.top),
+        ("right", rect.right),
+        ("bottom", rect.bottom),
+    ] {
+        let _ = js_sys::Reflect::set(&object, &JsValue::from_str(key), &JsValue::from(value));
+    }
+    object.into()
+}
