+    /// Applies an externally decoded frame's regions to its surface, as an in-process decode would.
+    fn apply_h264_frame(
+        &mut self,
+        surface_id: u16,
+        regions: &[ExclusiveRectangle],
+        pixels: Option<Vec<u8>>,
+    ) -> PduResult<()> {
+        if !self.surfaces.contains_key(&surface_id) {
+            return Err(pdu_other_err!("unknown surface in WireToSurface1"));
+        }
+        let Some(pixels) = pixels else {
+            debug!(surface_id, "H.264 frame not decoded; its regions keep their pixels");
+            return Ok(());
+        };
+        let expected: usize = regions.iter().map(rgba_len).sum();
+        if pixels.len() != expected {
+            warn!(
+                expected,
+                actual = pixels.len(),
+                "Decoded H.264 pixels do not match the frame's regions"
+            );
+            return Err(pdu_other_err!("decoded H.264 pixels do not match the frame's regions"));
+        }
+        let mut apply = |region: &ExclusiveRectangle, data: Vec<u8>| {
+            self.compositor.apply_bitmap(surface_id, region, &data);
+            let update = BitmapUpdate {
+                surface_id,
+                destination_rectangle: region.clone(),
+                codec_id: Codec1Type::Avc420,
+                data,
+                width: region.right - region.left,
+                height: region.bottom - region.top,
+            };
+            self.handler.on_bitmap_updated(&update);
+        };
+        if let [region] = regions {
+            // The usual case (a whole-picture update): no copy for the handler.
+            apply(region, pixels);
+        } else {
+            let mut rest = pixels.as_slice();
+            for region in regions {
+                let (data, remaining) = rest.split_at(rgba_len(region));
+                rest = remaining;
+                apply(region, data.to_vec());
+            }
+        }
+        Ok(())
+    }
