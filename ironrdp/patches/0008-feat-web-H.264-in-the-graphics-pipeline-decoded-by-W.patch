+    /// were. Returns the messages to send, frame acknowledgements among them.
+    pub fn complete_h264_frame(&mut self, id: u32, pixels: Option<Vec<u8>>) -> PduResult<Vec<DvcMessage>> {
+        if !self
+            .queue
+            .iter()
+            .any(|queued| matches!(queued, Queued::H264 { id: queued_id, .. } if *queued_id == id))
+        {
