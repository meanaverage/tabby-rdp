+    let mut client = client();
+    // Three copies of the whole 16x8 surface: 384 pixels of regions for a 128-pixel surface.
+    let whole = Avc420Region::new(0, 0, 16, 8, 22, 100);
+    process_all(
+        &mut client,
+        &[
+            start(1),
+            avc420(&[whole.clone(), whole.clone(), whole], IDR_ACCESS_UNIT),
+            end(1),
+        ],
+    );
+    let frame = client.take_h264_frames().remove(0);
+    assert_eq!(frame.regions, [rect(0, 0, 16, 8)]);
+    let sent = client
+        .complete_h264_frame(frame.id, Some(solid(1, rect(0, 0, 16, 8))))
+        .expect("complete");
+    assert_eq!(acks(&sent), [(1, 0)]);
+}
+
+#[test]
+fn regions_are_clipped_to_the_surface() {
+    let mut client = client();
+    // A destination and a region far larger than the 16x8 surface.
+    let pdu = avc420_to(
+        1,
+        rect(0, 0, 4096, 4096),
+        &[Avc420Region::new(0, 0, 4096, 4096, 22, 100)],
+    );
+    process_all(&mut client, &[start(1), pdu, end(1)]);
+    assert_eq!(client.take_h264_frames()[0].regions, [rect(0, 0, 16, 8)]);
+}
+
+#[test]
+fn a_frame_for_an_unknown_surface_is_refused() {
+    let mut client = client();
+    let pdu = avc420_to(9, rect(0, 0, 16, 8), &[Avc420Region::new(0, 0, 16, 8, 22, 100)]);
+    assert!(client.process(0, &wire(&start(1))).is_ok());
+    assert!(client.process(0, &wire(&pdu)).is_err());
+}
+
+#[test]
+fn regions_too_large_to_read_back_are_skipped() {
+    let mut client = client();
+    let huge = GfxPdu::CreateSurface(CreateSurfacePdu {
+        surface_id: 2,
+        width: 16384,
+        height: 16384,
+        pixel_format: PixelFormat::XRgb,
+    });
+    let pdu = avc420_to(
+        2,
+        rect(0, 0, 16384, 16384),
+        &[Avc420Region::new(0, 0, 16384, 16384, 22, 100)],
+    );
+    process_all(&mut client, &[huge, start(1), pdu, end(1)]);
+    // Still decoded, which keeps the stream whole, but nothing is read back: 1 GiB of RGBA.
+    let frame = client.take_h264_frames().remove(0);
+    assert!(frame.regions.is_empty());
+    assert_eq!(
+        acks(
+            &client
+                .complete_h264_frame(frame.id, Some(Vec::new()))
+                .expect("complete")
+        ),
+        [(1, 0)]
+    );
+}
+
+#[test]
+fn a_surface_created_behind_a_waiting_frame_bounds_its_own_frames() {
+    let mut client = client();
+    let whole = Avc420Region::new(0, 0, 16, 8, 22, 100);
+    let surface2 = GfxPdu::CreateSurface(CreateSurfacePdu {
+        surface_id: 2,
+        width: 32,
+        height: 4,
+        pixel_format: PixelFormat::XRgb,
+    });
+    let pdu = avc420_to(2, rect(0, 0, 64, 64), &[Avc420Region::new(0, 0, 64, 64, 22, 100)]);
+    // Surface 2 is created while frame 1 still waits for the decoder: its CreateSurface is queued, not processed.
+    process_all(
+        &mut client,
+        &[
+            start(1),
+            avc420(&[whole], IDR_ACCESS_UNIT),
+            end(1),
+            surface2,
+            start(2),
+            pdu,
+            end(2),
+        ],
+    );
+    let frames = client.take_h264_frames();
+    assert_eq!(frames.len(), 2);
+    assert_eq!(frames[1].regions, [rect(0, 0, 32, 4)]);
+}
