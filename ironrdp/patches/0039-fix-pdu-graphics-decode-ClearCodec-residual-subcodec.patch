+        data.extend_from_slice(&[0x10, 0x20, 0x30]);
+        // A region claiming more bitmap data than there is.
+        for value in [0u16, 0, 1, 1] {
+            data.extend_from_slice(&value.to_le_bytes());
+        }
+        data.extend_from_slice(&4u32.to_le_bytes());
+        data.push(0x00);
+        data.extend_from_slice(&[0x10, 0x20, 0x30]);
+
+        let mut regions = decode_subcodec_layer_regions(&data);
+
+        let region = regions.next().unwrap().unwrap();
+        assert_eq!((region.x_start, region.y_start), (3, 4));
+        assert_eq!(region.bitmap_data, [0x10, 0x20, 0x30]);
+        assert!(regions.next().unwrap().is_err());
+        assert!(regions.next().is_none());
+        decode_subcodec_layer(&data).unwrap_err();
+    }
 }
