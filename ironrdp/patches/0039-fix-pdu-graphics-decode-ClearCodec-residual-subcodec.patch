+#[test]
+fn clearcodec_residual_segments_take_no_memory() {
+    // A segment filling an 8x8 destination, then 16 Mi segments of no pixels, 64 MiB. Decoded
+    // whole, the layer took 384 MiB, growing a vector to 32 Mi segments.
+    let mut residual_data = vec![0x01, 0x02, 0x03, 64];
+    for _ in 0..16 * 1024 * 1024 {
+        residual_data.extend_from_slice(&[0x00, 0x00, 0x00, 0]);
+    }
+    let stream = clearcodec_stream(&residual_data, &[], &[]);
+    let mut decoder = ClearCodecDecoder::new();
+
+    let (pixels, peak) = peak_heap(|| decoder.decode(&stream, 8, 8));
+
+    assert_eq!(pixels.unwrap(), [0x01, 0x02, 0x03, 0xFF].repeat(64));
+    assert!(peak < 1024 * 1024, "decoding the layer took {peak} bytes");
+}
+
+#[test]
+fn clearcodec_subcodec_regions_take_no_memory() {
+    // 4 Mi raw regions of one pixel, 64 MiB, over a 1x1 destination. Decoded whole, the layer took
+    // 192 MiB on 64-bit targets.
+    let mut subcodec_data = Vec::new();
+    for i in 0..4 * 1024 * 1024u32 {
+        for value in [0u16, 0, 1, 1] {
+            subcodec_data.extend_from_slice(&value.to_le_bytes()); // x, y, width, height
+        }
+        subcodec_data.extend_from_slice(&3u32.to_le_bytes()); // bitmapDataByteCount
+        subcodec_data.push(0x00); // raw
+        subcodec_data.extend_from_slice(&i.to_le_bytes()[..3]);
+    }
+    let stream = clearcodec_stream(&[], &[], &subcodec_data);
+    let mut decoder = ClearCodecDecoder::new();
+
+    let (pixels, peak) = peak_heap(|| decoder.decode(&stream, 1, 1));
+
+    // The last region's pixel.
+    assert_eq!(pixels.unwrap(), [0xFF, 0xFF, 0x3F, 0xFF]);
+    assert!(peak < 1024 * 1024, "decoding the layer took {peak} bytes");
+}
+
+#[test]
+fn clearcodec_rlex_segments_take_no_memory() {
+    // A 2048x2048 RLEX region of one palette entry, and 4 Mi segments of one pixel (a packed byte
+    // and a run of none: the suite paints the pixel), 8 MiB. Decoded whole, its segments took
+    // 48 MiB, on top of the 16 MiB image.
+    let mut rlex = vec![1, 0x10, 0x20, 0x30];
+    rlex.resize(rlex.len() + 2 * 4 * 1024 * 1024, 0);
+    let mut subcodec_data = Vec::new();
+    for value in [0u16, 0, 2048, 2048] {
+        subcodec_data.extend_from_slice(&value.to_le_bytes()); // x, y, width, height
+    }
+    subcodec_data.extend_from_slice(&u32::try_from(rlex.len()).unwrap().to_le_bytes());
+    subcodec_data.push(0x02); // RLEX
+    subcodec_data.extend_from_slice(&rlex);
+    let stream = clearcodec_stream(&[], &[], &subcodec_data);
+    let mut decoder = ClearCodecDecoder::new();
+
+    let (pixels, peak) = peak_heap(|| decoder.decode(&stream, 2048, 2048));
+
+    let pixels = pixels.unwrap();
+    assert!(pixels.chunks_exact(4).all(|pixel| pixel == [0x10, 0x20, 0x30, 0xFF]));
+    assert!(
+        peak < 16 * 1024 * 1024 + 1024 * 1024,
+        "decoding the region took {peak} bytes"
+    );
+}
