From: meanaverage <18336095+meanaverage@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:48:53 -0700
Subject: [PATCH 16/16] fix(svc): send chunked messages without
 CHANNEL_FLAG_SHOW_PROTOCOL

The flag asks the receiver to pass the Channel PDU Header to the
application layer along with the data. mstsc sets it only for channels
opened with CHANNEL_OPTION_SHOW_PROTOCOL (the clipboard); Windows'
rdpdr.sys does not expect it, and dropped the channel on the first
chunked drive read response (anything over one chunk, 1600 bytes).

Chunks now carry only the flags the message asks for, like a message
that fits one chunk already did.
---
 crates/ironrdp-svc/src/lib.rs              |  9 +++----
 crates/ironrdp-testsuite-core/tests/svc.rs | 30 +++++++++++++++-------
 2 files changed, 25 insertions(+), 14 deletions(-)

diff --git a/crates/ironrdp-svc/src/lib.rs b/crates/ironrdp-svc/src/lib.rs
index 162c8a64..a2e4f74a 100644
--- a/crates/ironrdp-svc/src/lib.rs
+++ b/crates/ironrdp-svc/src/lib.rs
@@ -462,7 +462,6 @@ impl ChunkProcessor {
         let mut chunks = Vec::new();
 
         let total_len = encoded_pdu.filled_len();
-        let is_chunked = total_len > max_chunk_len;
         let mut chunk_start_index: usize = 0;
         let mut chunk_end_index = core::cmp::min(total_len, max_chunk_len);
         loop {
@@ -485,10 +484,10 @@ impl ChunkProcessor {
                 if last {
                     flags |= ChannelFlags::LAST;
                 }
-                if is_chunked {
-                    flags |= ChannelFlags::SHOW_PROTOCOL;
-                }
-
+                // No CHANNEL_FLAG_SHOW_PROTOCOL of its own: that flag asks the receiver to hand the Channel PDU
+                // Header to the application layer along with the data, which Windows' rdpdr.sys does not expect
+                // (a chunked response makes it drop the channel). mstsc sets it only for channels opened with
+                // CHANNEL_OPTION_SHOW_PROTOCOL; a processor that wants it puts it in its messages' flags.
                 flags |= message.flags;
 
                 ChannelPduHeader {
diff --git a/crates/ironrdp-testsuite-core/tests/svc.rs b/crates/ironrdp-testsuite-core/tests/svc.rs
