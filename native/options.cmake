# Keep the distributed helper's dependency set explicit. Optional codecs are a separate build/license review.
set(BUILD_SHARED_LIBS ON CACHE BOOL "" FORCE)
set(WITH_CLIENT_COMMON ON CACHE BOOL "" FORCE)
set(WITH_CHANNELS ON CACHE BOOL "" FORCE)
set(WITH_CLIENT_CHANNELS ON CACHE BOOL "" FORCE)
set(WITH_UNICODE_BUILTIN ON CACHE BOOL "" FORCE)
foreach(option CLIENT SERVER SAMPLE X11 WAYLAND CLIENT_SDL FFMPEG SWSCALE OPENH264 CUPS PCSC PCSC_WINPR
        SMARTCARD_PCSC SMARTCARD_EMULATE PKCS11 FUSE URBDRC LIBUSB MANPAGES WINPR_TOOLS KRB5 GSSAPI OPUS SOXR LAME
        FAAD2 FAAC GSM JPEG WEBVIEW AAD SERVER_CHANNELS CLANG_FORMAT ALSA PULSE OSS SNDIO MACAUDIO
        SYSTEMD FFMPEG_VAAPI MEDIA_FOUNDATION OPENH264_LOADING SWSCALE_LOADING)
    set(WITH_${option} OFF CACHE BOOL "" FORCE)
endforeach()
set(WITH_JSON_DISABLED ON CACHE BOOL "" FORCE)
# WinPR links uriparser whenever the build machine has it; the clipboard channel would then load it.
set(WITH_URIPARSER OFF CACHE BOOL "" FORCE)
set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
file(GLOB channel_options "${FREERDP_SOURCE_DIR}/channels/*/ChannelOptions.cmake")
foreach(file ${channel_options})
    get_filename_component(dir "${file}" DIRECTORY)
    get_filename_component(channel "${dir}" NAME)
    string(TOUPPER "${channel}" channel)
    if(channel MATCHES "^(DRDYNVC|DISP|RDPGFX|RDPDR|RDPSND|CLIPRDR)$")
        set(CHANNEL_${channel} ON CACHE BOOL "" FORCE)
        set(CHANNEL_${channel}_CLIENT ON CACHE BOOL "" FORCE)
    else()
        set(CHANNEL_${channel} OFF CACHE BOOL "" FORCE)
        set(CHANNEL_${channel}_CLIENT OFF CACHE BOOL "" FORCE)
    endif()
    set(CHANNEL_${channel}_SERVER OFF CACHE BOOL "" FORCE)
endforeach()
